{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TABG Plugin Manifest",
  "description": "Schema for plugin manifests in the TABG Server Installer plugin marketplace.",
  "type": "object",
  "required": ["id", "name", "version", "description", "author", "dllNames", "type", "kind", "compatibleTabgVersions", "minInstallerVersion", "bepInExVersion"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,48}[a-zA-Z0-9]$",
      "description": "Unique identifier, 2-50 characters (PascalCase or kebab-case)."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (major.minor.patch)."
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "author": { "type": "string", "minLength": 1 },
    "authorUrl": { "type": "string", "format": "uri" },
    "repositoryUrl": { "type": "string", "format": "uri" },
    "downloadUrl": {
      "type": "string",
      "format": "uri",
      "description": "Direct download URL. Required for community plugins."
    },
    "dllNames": {
      "type": "array",
      "items": { "type": "string", "pattern": "\\.dll$" },
      "minItems": 1
    },
    "type": { "type": "string", "enum": ["server", "client", "both"] },
    "kind": {
      "type": "string",
      "enum": ["bundled", "core-dependency", "community-server", "community"],
      "description": "How the plugin is distributed. 'bundled' ships with the installer, 'core-dependency' is downloaded during install, 'community' is from the marketplace."
    },
    "defaultChecked": {
      "type": "boolean",
      "default": false,
      "description": "Whether this plugin is selected by default in the installer wizard."
    },
    "compatibleTabgVersions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "minInstallerVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "bepInExVersion": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "iconUrl": { "type": "string", "format": "uri" },
    "requiresClientMod": { "type": "boolean", "default": false },
    "clientPluginId": { "type": "string" },
    "changelog": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "requiresClientMod": { "const": true } } },
      "then": { "required": ["clientPluginId"] }
    },
    {
      "if": { "properties": { "kind": { "const": "community" } } },
      "then": { "required": ["downloadUrl"] }
    }
  ],
  "additionalProperties": false
}
