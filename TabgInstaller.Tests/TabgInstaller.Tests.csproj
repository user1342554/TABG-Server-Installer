<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWPF Condition="'$(TargetFramework)' == 'net8.0-windows'">true</UseWPF>
    <EnableWindowsTargeting Condition="'$(TargetFramework)' == 'net8.0-windows'">true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TabgInstaller.CustomGameSkins.Shared\CustomGameSkinsProtocol.cs" Link="CustomGameSkins\CustomGameSkinsProtocol.cs" />
    <ProjectReference Include="..\TabgInstaller.Core\TabgInstaller.Core.csproj" />
    <ProjectReference Include="..\TabgInstaller.UI\TabgInstaller.UI.csproj" />
    <ProjectReference Include="..\TabgInstaller.App\TabgInstaller.App.csproj" />
    <ProjectReference Include="..\TabgInstaller.MatchCore\TabgInstaller.MatchCore.csproj" />
    <ProjectReference Include="..\TabgInstaller.AdminRadar.Server\TabgInstaller.AdminRadar.Server.csproj" />
    <ProjectReference Include="..\TabgInstaller.ProximityChat.Client\TabgInstaller.ProximityChat.Client.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ProjectReference Include="..\TabgInstaller.Gui\TabgInstaller.Gui.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="ViewModels\**\*.cs" />
    <Compile Remove="Services\ActiveInstanceServiceTests.cs" />
    <Compile Remove="Services\ServerInstanceManagerTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>..\TabgInstaller.ProximityChat.Server\Libs\UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\TabgInstaller.ProximityChat.Server\Libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
