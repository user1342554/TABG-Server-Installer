<Window x:Class="TabgInstaller.Gui.Windows.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TABG Server Installer — Setup" Height="700" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/tabg-mod-manager-icon-256.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Welcome to TABG Server Installer" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="First-time setup — this only runs once." Foreground="#888" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl x:Name="WizardSteps" Grid.Row="1" BorderThickness="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabItem>
                <StackPanel Margin="0,10">
                    <TextBlock Text="Step 1: Server Path" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Select your TABG Dedicated Server folder. This is usually auto-detected from Steam."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtServerPath" Grid.Column="0" Margin="0,0,5,0" VerticalContentAlignment="Center" Height="30"/>
                        <Button Content="Browse" Grid.Column="1" Width="80" Height="30" Click="BrowseServer_Click"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem>
                <StackPanel Margin="0,10">
                    <TextBlock Text="Step 2: Client Path (optional)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Select your TABG Steam folder for client mods. You can skip this and set it up later."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtClientPath" Grid.Column="0" Margin="0,0,5,0" VerticalContentAlignment="Center" Height="30"/>
                        <Button Content="Browse" Grid.Column="1" Width="80" Height="30" Click="BrowseClient_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtModdedPathPreview" Foreground="#888" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Step 3: Choose Starting Plugins" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Pick your initial server plugins. You can add or remove plugins anytime later from the Server Mods tab — no reinstall needed!"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PluginCheckboxes"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem>
                <StackPanel Margin="0,10" VerticalAlignment="Center">
                    <TextBlock Text="Installing..." FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ProgressBar x:Name="InstallProgress" Height="24" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtInstallStage" Foreground="#888" FontSize="12"/>
                    <ScrollViewer x:Name="LogScrollViewer" MaxHeight="300" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                    </ScrollViewer>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnBack" Content="Back" Width="100" Height="36" Margin="0,0,10,0" Click="BtnBack_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnSkip" Content="Skip" Width="100" Height="36" Margin="0,0,10,0" Click="BtnSkip_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnNext" Content="Next" Width="100" Height="36" Click="BtnNext_Click"/>
        </StackPanel>
    </Grid>
</Window>
