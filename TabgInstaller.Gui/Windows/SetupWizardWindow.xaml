<Window x:Class="TabgInstaller.Gui.Windows.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:TabgInstaller.Gui.Resources"
        Title="{x:Static res:Strings.SetupTitle}" Height="700" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/tabg-mod-manager-icon-256.png">
    <Grid Margin="20" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{x:Static res:Strings.WelcomeTitle}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{x:Static res:Strings.WelcomeSubtitle}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl x:Name="WizardSteps" Grid.Row="1" BorderThickness="0"
                    AutomationProperties.AutomationId="WizardStepsTabControl"
                    AutomationProperties.Name="Setup wizard steps">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabItem>
                <StackPanel Margin="0,10">
                    <TextBlock Text="{x:Static res:Strings.Step1Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{x:Static res:Strings.Step1Description}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtServerPath" Grid.Column="0" Margin="0,0,5,0" VerticalContentAlignment="Center" Height="30"
                                 AutomationProperties.Name="Server installation path"
                                 AutomationProperties.AutomationId="WizardServerPathTextBox"
                                 TabIndex="10"/>
                        <Button Content="{x:Static res:Strings.Browse}" Grid.Column="1" Width="80" Height="30" Click="BrowseServer_Click"
                                AutomationProperties.Name="{x:Static res:Strings.Browse}"
                                AutomationProperties.AutomationId="WizardBrowseServerButton"
                                TabIndex="11"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem>
                <StackPanel Margin="0,10">
                    <TextBlock Text="{x:Static res:Strings.Step2Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{x:Static res:Strings.Step2Description}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtClientPath" Grid.Column="0" Margin="0,0,5,0" VerticalContentAlignment="Center" Height="30"
                                 AutomationProperties.Name="TABG client path"
                                 AutomationProperties.AutomationId="WizardClientPathTextBox"
                                 TabIndex="10"/>
                        <Button Content="{x:Static res:Strings.Browse}" Grid.Column="1" Width="80" Height="30" Click="BrowseClient_Click"
                                AutomationProperties.Name="{x:Static res:Strings.Browse}"
                                AutomationProperties.AutomationId="WizardBrowseClientButton"
                                TabIndex="11"/>
                    </Grid>
                    <TextBlock x:Name="TxtModdedPathPreview" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Step3Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{x:Static res:Strings.Step3Description}"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PluginCheckboxes"
                                    AutomationProperties.Name="Server plugin selections"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Step 4: Client Mods -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Step4Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{x:Static res:Strings.Step4Description}"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ClientModCheckboxes"
                                    AutomationProperties.Name="Client mod selections"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Step 5: Installing -->
            <TabItem>
                <StackPanel Margin="0,10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.Installing}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ProgressBar x:Name="InstallProgress" Height="24" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"
                                 AutomationProperties.Name="Installation progress"
                                 AutomationProperties.AutomationId="WizardInstallProgressBar"/>
                    <TextBlock x:Name="TxtInstallStage" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                               AutomationProperties.LiveSetting="Polite"/>
                    <ScrollViewer x:Name="LogScrollViewer" MaxHeight="300" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                                 AutomationProperties.Name="Installation log"
                                 AutomationProperties.AutomationId="WizardInstallLogTextBox"
                                 AutomationProperties.LiveSetting="Polite"/>
                    </ScrollViewer>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnCancel" Content="{x:Static res:Strings.Cancel}" Width="100" Height="36" Margin="0,0,10,0" Click="BtnCancel_Click" Visibility="Collapsed"
                    AutomationProperties.Name="{x:Static res:Strings.Cancel}"
                    AutomationProperties.AutomationId="WizardCancelButton"
                    TabIndex="90"/>
            <Button x:Name="BtnBack" Content="{x:Static res:Strings.Back}" Width="100" Height="36" Margin="0,0,10,0" Click="BtnBack_Click" Visibility="Collapsed"
                    AutomationProperties.Name="{x:Static res:Strings.Back}"
                    AutomationProperties.AutomationId="WizardBackButton"
                    TabIndex="91"/>
            <Button x:Name="BtnSkip" Content="{x:Static res:Strings.Skip}" Width="100" Height="36" Margin="0,0,10,0" Click="BtnSkip_Click" Visibility="Collapsed"
                    AutomationProperties.Name="{x:Static res:Strings.Skip}"
                    AutomationProperties.AutomationId="WizardSkipButton"
                    TabIndex="92"/>
            <Button x:Name="BtnNext" Content="{x:Static res:Strings.Next}" Width="100" Height="36" Click="BtnNext_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Next}"
                    AutomationProperties.AutomationId="WizardNextButton"
                    TabIndex="93"/>
        </StackPanel>
    </Grid>
</Window>
