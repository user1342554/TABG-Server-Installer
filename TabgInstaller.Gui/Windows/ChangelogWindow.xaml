<Window x:Class="TabgInstaller.Gui.Windows.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:TabgInstaller.Gui.Resources"
        Title="{x:Static res:Strings.UpdateAvailable}" Height="400" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinHeight="300" MinWidth="350"
        Icon="pack://application:,,,/Assets/tabg-mod-manager-icon-256.png">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{x:Static res:Strings.UpdateAvailable}" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="VersionLabel" FontSize="14" Foreground="#888" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Scrollable release notes area -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel x:Name="NotesPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static res:Strings.UpdateNow}" Width="100" Height="32" Margin="0,0,8,0" Click="UpdateNow_Click" IsDefault="True"/>
            <Button Content="{x:Static res:Strings.SkipThisVersion}" Width="120" Height="32" Margin="0,0,8,0" Click="SkipVersion_Click"/>
            <Button Content="{x:Static res:Strings.RemindMeLater}" Width="110" Height="32" Click="Later_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
