@using System.IO
@using System.IO.Compression
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject AppState State

<div class="main-2col">
    <div class="primary">
        <div class="hero">
            <span class="hero-bg">MODS</span>
            <h1 class="hero-title">Client Mods</h1>
            <p class="hero-sub">Install mods to a separate TABG copy — EAC blocks mods in Steam folder</p>
            <p class="hero-note">Creates a modded copy of TABG that runs independently</p>
        </div>
        <div class="path-bar">
            <span class="path-label">TABG Steam Folder</span>
            <input class="path-input" @bind="clientPath" readonly="@isInstalling" />
        </div>
        <div class="path-bar">
            <span class="path-label">Modded Copy Folder</span>
            <input class="path-input" @bind="moddedPath" readonly="@isInstalling" />
        </div>

        <!-- GAMEPLAY -->
        <div class="category @(State.ClientCollapsed.Contains("gameplay") ? "collapsed" : "")">
            <div class="cat-header" @onclick='() => Toggle("gameplay")'>
                <span class="cat-name">Gameplay</span>
                <span class="cat-count">@CatCount(0,1) / 2</span>
                <span class="cat-chevron">&#9660;</span>
            </div>
            <div class="cat-items">
                <div class="plugin-item @(!clientMods[0].IsChecked ? "off" : "")" @onclick="() => Flip(0)">
                    <div class="pchk @(clientMods[0].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">FlyingControls</div>
                    <div class="plugin-desc">Steer Helicopters, UFOs, Hover vehicles (W/S/A/D + Space)</div>
                </div>
                <div class="plugin-item @(!clientMods[1].IsChecked ? "off" : "")" @onclick="() => Flip(1)">
                    <div class="pchk @(clientMods[1].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">Enhanced TABG</div>
                    <div class="plugin-desc">Infinite LOD (F1), HUD toggle (F2), fog removal (F3)</div>
                </div>
            </div>
        </div>

        <!-- WEAPONS & ITEMS -->
        <div class="category @(State.ClientCollapsed.Contains("weapons") ? "collapsed" : "")">
            <div class="cat-header" @onclick='() => Toggle("weapons")'>
                <span class="cat-name">Weapons & Items</span>
                <span class="cat-count">@CatCount(2,3) / 2</span>
                <span class="cat-chevron">&#9660;</span>
            </div>
            <div class="cat-items">
                <div class="plugin-item @(!clientMods[2].IsChecked ? "off" : "")" @onclick="() => Flip(2)">
                    <div class="pchk @(clientMods[2].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">BigSmokeGrenade</div>
                    <div class="plugin-desc">Giant purple smoke grenades</div>
                </div>
                <div class="plugin-item @(!clientMods[3].IsChecked ? "off" : "")" @onclick="() => Flip(3)">
                    <div class="pchk @(clientMods[3].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">MGLFlashbang</div>
                    <div class="plugin-desc">MGL shoots flashbang rounds</div>
                </div>
            </div>
        </div>

        <!-- UTILITY -->
        <div class="category @(State.ClientCollapsed.Contains("utility") ? "collapsed" : "")">
            <div class="cat-header" @onclick='() => Toggle("utility")'>
                <span class="cat-name">Utility</span>
                <span class="cat-count">@CatCount(4,5,6,7) / 4</span>
                <span class="cat-chevron">&#9660;</span>
            </div>
            <div class="cat-items">
                <div class="plugin-item @(!clientMods[4].IsChecked ? "off" : "")" @onclick="() => Flip(4)">
                    <div class="pchk @(clientMods[4].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">Coords Display</div>
                    <div class="plugin-desc">Press F5 to show your X/Y/Z position</div>
                </div>
                <div class="plugin-item @(!clientMods[5].IsChecked ? "off" : "")" @onclick="() => Flip(5)">
                    <div class="pchk @(clientMods[5].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">Mod Settings</div>
                    <div class="plugin-desc">In-game settings menu for all mods (press #)</div>
                </div>
                <div class="plugin-item @(!clientMods[6].IsChecked ? "off" : "")" @onclick="() => Flip(6)">
                    <div class="pchk @(clientMods[6].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">Pop-up Blocker</div>
                    <div class="plugin-desc">Disable anti-cheat popups for custom servers</div>
                </div>
                <div class="plugin-item @(!clientMods[7].IsChecked ? "off" : "")" @onclick="() => Flip(7)">
                    <div class="pchk @(clientMods[7].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">Proximity Chat</div>
                    <div class="plugin-desc">Proximity voice chat for custom servers</div>
                </div>
            </div>
        </div>

        <!-- GAME MODES & VR -->
        <div class="category @(State.ClientCollapsed.Contains("modes") ? "collapsed" : "")">
            <div class="cat-header" @onclick='() => Toggle("modes")'>
                <span class="cat-name">Game Modes & VR</span>
                <span class="cat-count">@CatCount(8,9,10) / 3</span>
                <span class="cat-chevron">&#9660;</span>
            </div>
            <div class="cat-items">
                <div class="plugin-item @(!clientMods[8].IsChecked ? "off" : "")" @onclick="() => Flip(8)">
                    <div class="pchk @(clientMods[8].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">Hunt Mode Client</div>
                    <div class="plugin-desc">HUD and perk selection UI</div>
                </div>
                <div class="plugin-item @(!clientMods[9].IsChecked ? "off" : "")" @onclick="() => Flip(9)">
                    <div class="pchk @(clientMods[9].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">Juggernaut Mode Client</div>
                    <div class="plugin-desc">Boss bar, loadout picker, scoreboard</div>
                </div>
                <div class="plugin-item @(!clientMods[10].IsChecked ? "off" : "")" @onclick="() => Flip(10)">
                    <div class="pchk @(clientMods[10].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">TABGVR</div>
                    <div class="plugin-desc">Play TABG in Virtual Reality (requires VR headset)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="sidebar">
        <div class="install-cta">
            <button class="btn-install" @onclick="BtnInstallClientMods_Click" disabled="@isInstalling">
                @(isInstalling ? "Installing..." : "Install Mods")
            </button>
            <button class="btn-skip" @onclick="BtnLaunchModdedTabg_Click" disabled="@isInstalling">
                Launch Modded TABG
            </button>
        </div>
        <div class="stats">
            <div class="stat">
                <div class="stat-val accent">@SelectedCount</div>
                <div class="stat-label">Selected</div>
            </div>
            <div class="stat">
                <div class="stat-val">@clientMods.Length</div>
                <div class="stat-label">Available</div>
            </div>
        </div>
        <div class="log-section">
            <div class="log-header">
                <span class="log-title">Console</span>
                <span class="log-status">
                    @if (isInstalling)
                    {
                        <span class="status-dot"></span>
                        <span>Installing</span>
                    }
                    else
                    {
                        <span>Ready</span>
                    }
                </span>
            </div>
            <div class="log-body" @ref="logElement">
                @if (string.IsNullOrEmpty(logText))
                {
                    <div><span class="hi">[sys]</span> TABG Steam folder detected</div>
                    <div><span class="hi">[sys]</span> Modded copy target set</div>
                    <div><span class="hi">[sys]</span> @SelectedCount client mods selected</div>
                    <div><span class="hi">[sys]</span> Ready for installation</div>
                }
                else
                {
                    @foreach (var line in logText.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries))
                    {
                        <div><span class="hi">[log]</span> @StripEmoji(line)</div>
                    }
                }
                <span class="log-cursor"></span>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private ConfirmDialog Dialog { get; set; } = null!;

    private string clientPath = "";
    private string moddedPath = "";
    private string logText = "";
    private bool isInstalling;
    private ElementReference logElement;

    private ClientModEntry[] clientMods = null!;

    private class ClientModEntry
    {
        public string Label { get; set; } = "";
        public bool IsChecked { get; set; }
    }

    private int SelectedCount => clientMods?.Count(m => m.IsChecked) ?? 0;

    private int CatCount(params int[] indices)
    {
        if (clientMods == null) return 0;
        return indices.Count(i => i < clientMods.Length && clientMods[i].IsChecked);
    }

    private void Toggle(string cat)
    {
        if (!State.ClientCollapsed.Remove(cat))
            State.ClientCollapsed.Add(cat);
    }

    private void Flip(int idx)
    {
        if (!isInstalling)
            clientMods[idx].IsChecked = !clientMods[idx].IsChecked;
    }

    private static string StripEmoji(string s)
    {
        var sb = new System.Text.StringBuilder(s.Length);
        foreach (var c in s)
        {
            if (c < 0x2600 || char.IsLetterOrDigit(c) || char.IsPunctuation(c) || char.IsWhiteSpace(c) || c == '/' || c == '\\' || c == '>' || c == '<' || c == '=' || c == ':' || c == '.' || c == '[' || c == ']' || c == '(' || c == ')')
                sb.Append(c);
        }
        return sb.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrEmpty(logText))
        {
            try { await JS.InvokeVoidAsync("scrollToBottom", logElement); } catch { }
        }
    }

    protected override void OnInitialized()
    {
        clientMods = new ClientModEntry[]
        {
            new() { Label = "FlyingControls", IsChecked = true },
            new() { Label = "Enhanced TABG", IsChecked = true },
            new() { Label = "BigSmokeGrenade", IsChecked = true },
            new() { Label = "MGLFlashbang", IsChecked = true },
            new() { Label = "Coords Display", IsChecked = true },
            new() { Label = "Mod Settings", IsChecked = true },
            new() { Label = "Pop-up Blocker", IsChecked = true },
            new() { Label = "Proximity Chat", IsChecked = true },
            new() { Label = "Hunt Mode Client", IsChecked = false },
            new() { Label = "Juggernaut Mode Client", IsChecked = false },
            new() { Label = "TABGVR", IsChecked = false },
        };

        var detectedPath = Installer.TryFindTabgClientPath();
        if (!string.IsNullOrEmpty(detectedPath))
        {
            clientPath = detectedPath;
            var parent = Path.GetDirectoryName(detectedPath);
            if (parent != null)
                moddedPath = Path.Combine(parent, "TABG_Modded");
        }
    }

    private async Task BtnLaunchModdedTabg_Click()
    {
        string moddedDir = moddedPath.Trim();
        string exe = Path.Combine(moddedDir, "TotallyAccurateBattlegrounds.exe");
        if (!File.Exists(exe))
        {
            await Dialog.ShowAsync("Not Installed",
                "Modded TABG not found. Install client mods first.");
            return;
        }
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = exe,
                WorkingDirectory = moddedDir,
                UseShellExecute = true
            });
        }
        catch (Exception ex)
        {
            await Dialog.ShowAsync("Error", $"Failed to launch: {ex.Message}");
        }
    }

    private async Task BtnInstallClientMods_Click()
    {
        string clientDir = clientPath.Trim();
        string moddedDir = moddedPath.Trim();

        if (string.IsNullOrWhiteSpace(clientDir) || !Directory.Exists(clientDir))
        {
            await Dialog.ShowAsync("Invalid Path",
                "Please enter a valid TABG Steam folder path.");
            return;
        }
        if (string.IsNullOrWhiteSpace(moddedDir))
        {
            await Dialog.ShowAsync("Invalid Path",
                "Please enter a folder path for the modded TABG copy.");
            return;
        }

        var selectedClientPlugins = new List<string>();
        if (clientMods[0].IsChecked) selectedClientPlugins.Add("TabgInstaller.FlyingControls.dll");
        if (clientMods[1].IsChecked) selectedClientPlugins.Add("Enhanced TABG.dll");
        if (clientMods[4].IsChecked) selectedClientPlugins.Add("TabgInstaller.CoordsDisplay.dll");
        if (clientMods[2].IsChecked || clientMods[3].IsChecked) selectedClientPlugins.Add("TabgInstaller.CustomGrenades.dll");
        if (clientMods[5].IsChecked) selectedClientPlugins.Add("TabgInstaller.ModSettings.dll");
        if (clientMods[6].IsChecked) selectedClientPlugins.Add("Pop-up Blocker.dll");
        if (clientMods[7].IsChecked)
        {
            selectedClientPlugins.Add("TabgInstaller.ProximityChat.Client.dll");
        }
        if (clientMods[8].IsChecked)
        {
            selectedClientPlugins.Add("TabgInstaller.HuntMode.Client.dll");
            selectedClientPlugins.Add("TabgInstaller.HuntMode.Shared.dll");
        }
        if (clientMods[9].IsChecked) selectedClientPlugins.Add("JuggernautMode.Client.dll");
        bool installVR = clientMods[10].IsChecked;
        if (installVR) selectedClientPlugins.Add("TABGVR.dll");

        if (selectedClientPlugins.Count == 0)
        {
            await Dialog.ShowAsync("No Mods Selected",
                "Please select at least one client mod.");
            return;
        }

        bool alreadyExists = Directory.Exists(moddedDir) && File.Exists(Path.Combine(moddedDir, "TotallyAccurateBattlegrounds.exe"));

        string confirmMessage = alreadyExists
            ? $"Modded copy already exists at:\n{moddedDir}\n\nThis will update the mods. Continue?"
            : $"This will copy TABG to:\n{moddedDir}\n\nThen install BepInEx + {selectedClientPlugins.Count} mod(s).\n\nTo play: open Steam, then run the exe from the modded folder.\n\nContinue?";

        bool confirmed = await Dialog.ShowAsync("Install Client Mods", confirmMessage, ConfirmDialog.DialogMode.YesNo);
        if (!confirmed) return;

        isInstalling = true;
        logText = "";
        StateHasChanged();

        var progress = new Progress<string>(line =>
        {
            InvokeAsync(() =>
            {
                logText += line + Environment.NewLine;
                StateHasChanged();
            });
        });

        try
        {
            logText += "=== Installing Client Mods ===" + Environment.NewLine;
            StateHasChanged();

            bool success = await Task.Run(() => ClientModInstaller.InstallAsync(clientDir, moddedDir, selectedClientPlugins, progress));

            if (success && installVR)
            {
                await Task.Run(() =>
                {
                    try
                    {
                        var baseDir = AppDomain.CurrentDomain.BaseDirectory;
                        var vrZipCandidates = new[]
                        {
                            Path.Combine(baseDir, "tabgvr", "TABGVR.zip"),
                            Path.Combine(baseDir, "..", "tabgvr", "TABGVR.zip"),
                            Path.Combine(baseDir, "..", "..", "tabgvr", "TABGVR.zip"),
                            Path.Combine(baseDir, "..", "..", "..", "tabgvr", "TABGVR.zip"),
                        };

                        string? vrZip = null;
                        foreach (var c in vrZipCandidates)
                            if (File.Exists(c)) { vrZip = Path.GetFullPath(c); break; }

                        if (vrZip != null)
                        {
                            ((IProgress<string>)progress).Report("Installing TABGVR extras (XR runtime, OpenXR)...");
                            ZipFile.ExtractToDirectory(vrZip, moddedDir, overwriteFiles: true);
                            ((IProgress<string>)progress).Report("TABGVR VR runtime installed.");
                        }
                        else
                        {
                            ((IProgress<string>)progress).Report("WARNING: TABGVR.zip not found -- VR runtime files not installed.");
                        }
                    }
                    catch (Exception vrEx)
                    {
                        ((IProgress<string>)progress).Report($"WARNING: Failed to extract TABGVR extras: {vrEx.Message}");
                    }
                });
            }

            if (success)
                await Dialog.ShowAsync("Success",
                    $"Client mods installed!\n\nModded TABG is at:\n{moddedDir}\n\nTo play:\n1. Make sure Steam is open\n2. Run TotallyAccurateBattlegrounds.exe from the modded folder\n3. Do NOT launch through Steam");
            else
                await Dialog.ShowAsync("Warning",
                    "Client mod installation had errors. Check the log.");
        }
        catch (Exception ex)
        {
            logText += $"ERROR: {ex.Message}" + Environment.NewLine;
            StateHasChanged();
            await Dialog.ShowAsync("Error", $"Error: {ex.Message}");
        }
        finally
        {
            isInstalling = false;
            StateHasChanged();
        }
    }
}
