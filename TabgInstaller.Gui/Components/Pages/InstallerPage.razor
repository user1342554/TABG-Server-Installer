@using System.Threading
@using Microsoft.JSInterop
@inject AppState State
@inject IJSRuntime JS

<div class="main-2col">
    <div class="primary">
        <div class="hero">
            <span class="hero-bg">TABG</span>
            <h1 class="hero-title">Server Installer</h1>
            <p class="hero-sub">Select plugins and install to your server directory</p>
            <p class="hero-note">BepInEx + plugins installed from GitHub</p>
        </div>
        <div class="path-bar">
            <span class="path-label">Server Path</span>
            <input class="path-input" @bind="serverPath" readonly="@isInstalling" />
        </div>
        <div class="path-bar">
            <span class="path-label">Citrus Tag</span>
            <input class="path-input" @bind="citrusTag" readonly="@isInstalling" style="max-width: 100px;" />
        </div>

        <!-- CORE -->
        <div class="category @(State.InstallerCollapsed.Contains("core") ? "collapsed" : "")">
            <div class="cat-header" @onclick='() => Toggle("core")'>
                <span class="cat-name">Core</span>
                <span class="cat-count">@CatCount(0,1,2) / 3</span>
                <span class="cat-chevron">&#9660;</span>
            </div>
            <div class="cat-items">
                <div class="plugin-item @(!plugins[0].IsChecked ? "off" : "")" @onclick="() => Flip(0)">
                    <div class="pchk @(plugins[0].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">Citruslib</div>
                    <div class="plugin-desc">Core server library — admin, permissions, commands</div>
                </div>
                <div class="plugin-item @(!plugins[1].IsChecked ? "off" : "")" @onclick="() => Flip(1)">
                    <div class="pchk @(plugins[1].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">StarterPack</div>
                    <div class="plugin-desc">Match mechanics, loadouts, win conditions</div>
                </div>
                <div class="plugin-item @(!plugins[2].IsChecked ? "off" : "")" @onclick="() => Flip(2)">
                    <div class="pchk @(plugins[2].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">StarterPackFixes</div>
                    <div class="plugin-desc">Loot drop control</div>
                </div>
            </div>
        </div>

        <!-- GAMEPLAY -->
        <div class="category @(State.InstallerCollapsed.Contains("gameplay") ? "collapsed" : "")">
            <div class="cat-header" @onclick='() => Toggle("gameplay")'>
                <span class="cat-name">Gameplay</span>
                <span class="cat-count">@CatCount(3,4,5) / 3</span>
                <span class="cat-chevron">&#9660;</span>
            </div>
            <div class="cat-items">
                <div class="plugin-item @(!plugins[3].IsChecked ? "off" : "")" @onclick="() => Flip(3)">
                    <div class="pchk @(plugins[3].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">CustomSpawnpoints</div>
                    <div class="plugin-desc">Custom spawn points</div>
                </div>
                <div class="plugin-item @(!plugins[4].IsChecked ? "off" : "")" @onclick="() => Flip(4)">
                    <div class="pchk @(plugins[4].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">FreddoTABGCommission</div>
                    <div class="plugin-desc">Curses, grenades on kill, bans</div>
                </div>
                <div class="plugin-item @(!plugins[5].IsChecked ? "off" : "")" @onclick="() => Flip(5)">
                    <div class="pchk @(plugins[5].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">MatchAndPreMatchTimeout</div>
                    <div class="plugin-desc">Match timing control</div>
                </div>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="category @(State.InstallerCollapsed.Contains("content") ? "collapsed" : "")">
            <div class="cat-header" @onclick='() => Toggle("content")'>
                <span class="cat-name">Content</span>
                <span class="cat-count">@CatCount(8,9,10) / 3</span>
                <span class="cat-chevron">&#9660;</span>
            </div>
            <div class="cat-items">
                <div class="plugin-item @(!plugins[8].IsChecked ? "off" : "")" @onclick="() => Flip(8)">
                    <div class="pchk @(plugins[8].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">UnusedVehicles</div>
                    <div class="plugin-desc">Spawn cut vehicles — Heli, UFO, Mustang, VW, HoverBike</div>
                </div>
                <div class="plugin-item @(!plugins[9].IsChecked ? "off" : "")" @onclick="() => Flip(9)">
                    <div class="pchk @(plugins[9].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">BigSmokeGrenade</div>
                    <div class="plugin-desc">Giant purple smoke grenades (/give 208)</div>
                </div>
                <div class="plugin-item @(!plugins[10].IsChecked ? "off" : "")" @onclick="() => Flip(10)">
                    <div class="pchk @(plugins[10].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">MGLFlashbang</div>
                    <div class="plugin-desc">MGL shoots flashbang rounds</div>
                </div>
            </div>
        </div>

        <!-- SOCIAL & UTILITY -->
        <div class="category @(State.InstallerCollapsed.Contains("social") ? "collapsed" : "")">
            <div class="cat-header" @onclick='() => Toggle("social")'>
                <span class="cat-name">Social & Utility</span>
                <span class="cat-count">@CatCount(6,7,13) / 3</span>
                <span class="cat-chevron">&#9660;</span>
            </div>
            <div class="cat-items">
                <div class="plugin-item @(!plugins[6].IsChecked ? "off" : "")" @onclick="() => Flip(6)">
                    <div class="pchk @(plugins[6].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">ServerLogger</div>
                    <div class="plugin-desc">Player logging</div>
                </div>
                <div class="plugin-item @(!plugins[7].IsChecked ? "off" : "")" @onclick="() => Flip(7)">
                    <div class="pchk @(plugins[7].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">VoteToStart</div>
                    <div class="plugin-desc">Vote-to-start</div>
                </div>
                <div class="plugin-item @(!plugins[13].IsChecked ? "off" : "")" @onclick="() => Flip(13)">
                    <div class="pchk @(plugins[13].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">ProximityChat</div>
                    <div class="plugin-desc">Proximity voice chat (requires client mod)</div>
                </div>
            </div>
        </div>

        <!-- GAME MODES & DEBUG -->
        <div class="category @(State.InstallerCollapsed.Contains("modes") ? "collapsed" : "")">
            <div class="cat-header" @onclick='() => Toggle("modes")'>
                <span class="cat-name">Game Modes & Debug</span>
                <span class="cat-count">@CatCount(11,12,14,15,16,17) / 6</span>
                <span class="cat-chevron">&#9660;</span>
            </div>
            <div class="cat-items">
                <div class="plugin-item @(!plugins[11].IsChecked ? "off" : "")" @onclick="() => Flip(11)">
                    <div class="pchk @(plugins[11].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">SoloTesting</div>
                    <div class="plugin-desc">Prevents 'You Win' when testing alone</div>
                </div>
                <div class="plugin-item @(!plugins[12].IsChecked ? "off" : "")" @onclick="() => Flip(12)">
                    <div class="pchk @(plugins[12].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">TABGCommunityServer</div>
                    <div class="plugin-desc">Community server</div>
                </div>
                <div class="plugin-item @(!plugins[14].IsChecked ? "off" : "")" @onclick="() => Flip(14)">
                    <div class="pchk @(plugins[14].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">Hunt Mode (4v1)</div>
                    <div class="plugin-desc">1 Killer vs 4 Survivors survival</div>
                </div>
                <div class="plugin-item @(!plugins[15].IsChecked ? "off" : "")" @onclick="() => Flip(15)">
                    <div class="pchk @(plugins[15].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">Juggernaut Mode</div>
                    <div class="plugin-desc">One massive player vs everyone, score-based</div>
                </div>
                <div class="plugin-item @(!plugins[16].IsChecked ? "off" : "")" @onclick="() => Flip(16)">
                    <div class="pchk @(plugins[16].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">TABGVR Server</div>
                    <div class="plugin-desc">VR hand sync (requires client mod)</div>
                </div>
                <div class="plugin-item @(!plugins[17].IsChecked ? "off" : "")" @onclick="() => Flip(17)">
                    <div class="pchk @(plugins[17].IsChecked ? "on" : "")"></div>
                    <div class="plugin-name">Fake Players</div>
                    <div class="plugin-desc">Spawn dummy players via admin commands</div>
                </div>
            </div>
        </div>
    </div>

    <div class="sidebar">
        <div class="install-cta">
            <button class="btn-install" @onclick="BtnInstall_Click" disabled="@isInstalling">
                @(isInstalling ? "Installing..." : "Install")
            </button>
            <button class="btn-skip" @onclick="BtnContinue_Click" disabled="@isInstalling">
                Continue without install
            </button>
        </div>
        <div class="stats">
            <div class="stat">
                <div class="stat-val accent">@SelectedCount</div>
                <div class="stat-label">Selected</div>
            </div>
            <div class="stat">
                <div class="stat-val">@plugins.Length</div>
                <div class="stat-label">Available</div>
            </div>
            <div class="stat">
                <div class="stat-val">~45</div>
                <div class="stat-label">MB Est.</div>
            </div>
            <div class="stat">
                <div class="stat-val" style="color: @StatusColor;">@StatusText</div>
                <div class="stat-label">Status</div>
            </div>
        </div>
        <div class="log-section">
            <div class="log-header">
                <span class="log-title">Console</span>
                <span class="log-status">
                    @if (isInstalling)
                    {
                        <span class="status-dot"></span>
                        <span>Installing</span>
                    }
                    else
                    {
                        <span>Ready</span>
                    }
                </span>
            </div>
            <div class="log-body" @ref="logElement">
                @if (string.IsNullOrEmpty(logText))
                {
                    <div><span class="hi">[sys]</span> Initializing TABG Manager...</div>
                    @if (!string.IsNullOrWhiteSpace(serverPath))
                    {
                        <div><span class="hi">[sys]</span> Server path detected <span class="ok">ok</span></div>
                    }
                    <div><span class="hi">[sys]</span> @SelectedCount plugins selected <span class="ok">ok</span></div>
                    <div><span class="hi">[sys]</span> Ready for installation</div>
                }
                else
                {
                    @foreach (var line in logText.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries))
                    {
                        <div><span class="hi">[log]</span> @StripEmoji(line)</div>
                    }
                }
                <span class="log-cursor"></span>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private ConfirmDialog Dialog { get; set; } = null!;

    private string serverPath = "";
    private string citrusTag = "v0.7";
    private string logText = "";
    private bool isInstalling;
    private ElementReference logElement;

    private PluginEntry[] plugins = null!;

    private class PluginEntry
    {
        public string Label { get; set; } = "";
        public bool IsChecked { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrEmpty(logText))
        {
            try { await JS.InvokeVoidAsync("scrollToBottom", logElement); } catch { }
        }
    }

    private static string StripEmoji(string s)
    {
        var sb = new System.Text.StringBuilder(s.Length);
        foreach (var c in s)
        {
            // Keep ASCII, Latin, common punctuation — skip surrogate pairs and symbol blocks
            if (c < 0x2600 || char.IsLetterOrDigit(c) || char.IsPunctuation(c) || char.IsWhiteSpace(c) || c == '/' || c == '\\' || c == '>' || c == '<' || c == '=' || c == ':' || c == '.' || c == '[' || c == ']' || c == '(' || c == ')')
                sb.Append(c);
        }
        return sb.ToString();
    }

    private int SelectedCount => plugins?.Count(p => p.IsChecked) ?? 0;
    private string StatusText => isInstalling ? "..." : (string.IsNullOrWhiteSpace(serverPath) ? "---" : "OK");
    private string StatusColor => isInstalling ? "var(--muted)" : (string.IsNullOrWhiteSpace(serverPath) ? "var(--muted)" : "#4ADE80");

    private int CatCount(params int[] indices)
    {
        if (plugins == null) return 0;
        return indices.Count(i => i < plugins.Length && plugins[i].IsChecked);
    }

    private void Toggle(string cat)
    {
        if (!State.InstallerCollapsed.Remove(cat))
            State.InstallerCollapsed.Add(cat);
    }

    private void Flip(int idx)
    {
        if (!isInstalling)
            plugins[idx].IsChecked = !plugins[idx].IsChecked;
    }

    protected override void OnInitialized()
    {
        plugins = new PluginEntry[]
        {
            new() { Label = "Citruslib", IsChecked = true },
            new() { Label = "StarterPack", IsChecked = true },
            new() { Label = "StarterPackFixes", IsChecked = true },
            new() { Label = "CustomSpawnpoints", IsChecked = true },
            new() { Label = "FreddoTABGCommission", IsChecked = true },
            new() { Label = "MatchAndPreMatchTimeout", IsChecked = true },
            new() { Label = "ServerLogger", IsChecked = true },
            new() { Label = "VoteToStart", IsChecked = true },
            new() { Label = "UnusedVehicles", IsChecked = true },
            new() { Label = "BigSmokeGrenade", IsChecked = true },
            new() { Label = "MGLFlashbang", IsChecked = true },
            new() { Label = "SoloTesting", IsChecked = false },
            new() { Label = "TABGCommunityServer", IsChecked = false },
            new() { Label = "ProximityChat", IsChecked = true },
            new() { Label = "Hunt Mode (4v1)", IsChecked = false },
            new() { Label = "Juggernaut Mode", IsChecked = false },
            new() { Label = "TABGVR Server", IsChecked = false },
            new() { Label = "Fake Players", IsChecked = false },
        };

        var detectedPath = Installer.TryFindTabgServerPath();
        if (!string.IsNullOrEmpty(detectedPath))
        {
            serverPath = detectedPath;
        }
    }

    private async Task Browse_Click()
    {
        await Dialog.ShowAsync("Manual Path Entry",
            "Please paste the path to your server directory into the text box manually.");
    }

    private async Task BtnInstall_Click()
    {
        const string serverName = "enormous";
        const string serverPassword = "enormous";
        const string serverDesc = "enormous";

        string tag = citrusTag.Trim();
        bool skipCitrus = !plugins[0].IsChecked;
        bool installCommunityServer = plugins[12].IsChecked;
        string serverDir = serverPath.Trim();

        bool confirmed = await Dialog.ShowAsync("Installation Warning",
            "WARNING: Installation will modify server files!\n\nA backup will be created in the 'backup' folder before installation.\nDo you want to continue?",
            ConfirmDialog.DialogMode.YesNo);

        if (!confirmed)
            return;

        if (string.IsNullOrWhiteSpace(serverDir))
        {
            await Dialog.ShowAsync("Folder Not Selected",
                "Please select a valid TABG server folder.");
            return;
        }

        if (!System.IO.Directory.Exists(serverDir))
        {
            await Dialog.ShowAsync("Folder Not Found",
                $"The path '{serverDir}' does not exist.\nPlease select a valid TABG server folder.");
            return;
        }

        if (tag.Length == 0 && !skipCitrus)
        {
            await Dialog.ShowAsync("Invalid Input",
                "CitrusLib tag is required if not skipping the plugin.");
            return;
        }

        isInstalling = true;
        logText = "";
        StateHasChanged();

        var progress = new Progress<string>(line =>
        {
            InvokeAsync(() =>
            {
                logText += line + Environment.NewLine;
                StateHasChanged();
            });
        });

        var cts = new CancellationTokenSource();

        try
        {
            bool skipStarterPack = !plugins[1].IsChecked;

            var selectedBundledPlugins = new List<string>();
            if (plugins[2].IsChecked) selectedBundledPlugins.Add("StarterPackFixes.dll");
            if (plugins[3].IsChecked) selectedBundledPlugins.Add("CustomSpawnpoints.dll");
            if (plugins[4].IsChecked) selectedBundledPlugins.Add("FreddoTABGCommission.dll");
            if (plugins[5].IsChecked) selectedBundledPlugins.Add("MatchAndPreMatchTimeout.dll");
            if (plugins[6].IsChecked) selectedBundledPlugins.Add("ServerLogger.dll");
            if (plugins[7].IsChecked) selectedBundledPlugins.Add("VoteToStart.dll");
            if (plugins[8].IsChecked) selectedBundledPlugins.Add("TabgInstaller.UnusedVehicles.dll");
            if (plugins[9].IsChecked || plugins[10].IsChecked) selectedBundledPlugins.Add("TabgInstaller.CustomGrenades.dll");
            if (plugins[11].IsChecked) selectedBundledPlugins.Add("TabgInstaller.SoloTesting.dll");
            if (plugins[13].IsChecked) selectedBundledPlugins.Add("TabgInstaller.ProximityChat.Server.dll");
            if (plugins[14].IsChecked)
            {
                selectedBundledPlugins.Add("TabgInstaller.HuntMode.dll");
                selectedBundledPlugins.Add("TabgInstaller.HuntMode.Shared.dll");
            }
            if (plugins[15].IsChecked) selectedBundledPlugins.Add("JuggernautMode.Server.dll");
            if (plugins[16].IsChecked) selectedBundledPlugins.Add("TABGVR.Server.CitrusLib.dll");
            if (plugins[17].IsChecked) selectedBundledPlugins.Add("TabgInstaller.FakePlayers.dll");

            int exitCode = await Task.Run(async () =>
            {
                var backupService = new BackupService(progress);
                if (System.IO.Directory.Exists(serverDir) && System.IO.Directory.GetFileSystemEntries(serverDir).Length > 0)
                {
                    ((IProgress<string>)progress).Report("Creating backup...");
                    bool backupSuccess = await backupService.CreateBackupAsync(serverDir);
                    if (!backupSuccess)
                        ((IProgress<string>)progress).Report("Warning: Backup failed - continuing anyway.");
                }

                var installer = new Installer(gameDir: serverDir, log: progress);

                return await installer.RunAsync(
                    serverDir: serverDir,
                    serverName: serverName,
                    serverPassword: serverPassword,
                    serverDescription: serverDesc,
                    starterPackTag: "",
                    citrusLibTag: tag,
                    skipStarterPack: skipStarterPack,
                    skipCitruslib: skipCitrus,
                    installCommunityServer: installCommunityServer,
                    bundledPlugins: selectedBundledPlugins,
                    ct: cts.Token
                );
            });

            if (!cts.IsCancellationRequested)
            {
                if (exitCode == 0)
                {
                    ((IProgress<string>)progress).Report("Installation completed successfully!");
                    State.SetServerDir(serverDir);
                    await Dialog.ShowAsync("Success",
                        "Installation completed successfully!\n\nYou can now use the Config tab to change Server Name, Password and Description.");
                }
                else
                {
                    await Dialog.ShowAsync("Installation Failed",
                        $"Installation ended with code {exitCode}. See log output.");
                }
            }
        }
        catch (OperationCanceledException)
        {
            ((IProgress<string>)progress).Report("Installation cancelled by user.");
            await Dialog.ShowAsync("Cancelled", "Installation cancelled.");
        }
        catch (Exception ex)
        {
            progress.LogException("Unknown error during installation", ex);
            await Dialog.ShowAsync("Error",
                $"Unknown error during installation:\n{ex.Message}");
        }
        finally
        {
            isInstalling = false;
            cts.Dispose();
            StateHasChanged();
        }
    }

    private async Task BtnContinue_Click()
    {
        string serverDir = serverPath.Trim();
        if (string.IsNullOrWhiteSpace(serverDir) || !System.IO.Directory.Exists(serverDir))
        {
            await Dialog.ShowAsync("Folder Not Selected",
                "Please select a valid TABG server folder.");
            return;
        }

        State.SetServerDir(serverDir);
    }
}
