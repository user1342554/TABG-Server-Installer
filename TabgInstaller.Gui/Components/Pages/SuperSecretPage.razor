@using TabgInstaller.Gui.Services
@implements IDisposable

<div class="pad-10">
    <div style="margin-bottom: 8px;">
        <span style="font-size: 14px;">This is password protected. Enter password to enter:</span>
    </div>

    <div style="margin-top: 8px;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <label style="width: 100px;">Password:</label>
            <input type="password" @bind="password" @bind:event="oninput"
                   @onkeydown="OnPasswordKeyDown"
                   style="width: 200px;" disabled="@isRunning" />
        </div>

        <div style="display: flex; align-items: center; gap: 10px; margin-top: 10px;">
            <button style="width: 100px;" @onclick="EnterButton_Click" disabled="@isRunning">
                @enterButtonText
            </button>
            @if (showStopButton)
            {
                <button style="width: 100px;" @onclick="StopButton_Click" disabled="@stopButtonDisabled">
                    Force Stop
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(errorText))
        {
            <div style="margin-top: 8px; color: red;">@errorText</div>
        }
        @if (!string.IsNullOrEmpty(infoText))
        {
            <div style="margin-top: 4px; color: dodgerblue; font-size: 11px;">@infoText</div>
        }
        @if (!string.IsNullOrEmpty(debugText))
        {
            <div style="margin-top: 4px; color: gray; font-size: 10px;">@debugText</div>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private ConfirmDialog Dialog { get; set; } = null!;

    private const string Password = "123";

    private string password = "";
    private string enterButtonText = "Enter";
    private string errorText = "";
    private string infoText = "";
    private string debugText = "";
    private bool isRunning;
    private bool showStopButton;
    private bool stopButtonDisabled;

    private SigmaModeApp? _sigmaMode;
    private List<string> _logMessages = new();

    private async Task OnPasswordKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await EnterButton_Click();
        }
    }

    private async Task EnterButton_Click()
    {
        errorText = "";
        var entered = password ?? string.Empty;

        if (entered != Password)
        {
            errorText = "Incorrect password.";
            return;
        }

        bool confirmed = await Dialog.ShowAsync(
            "Super Secret",
            "Password correct. Enter Sigma mode?",
            ConfirmDialog.DialogMode.YesNo);

        if (!confirmed)
            return;

        try
        {
            isRunning = true;
            enterButtonText = "Starting Sigma Mode...";
            showStopButton = false;
            stopButtonDisabled = false;
            infoText = "";
            debugText = "";
            _logMessages.Clear();
            StateHasChanged();

            _sigmaMode = new SigmaModeApp(logger: msg =>
            {
                System.Diagnostics.Debug.WriteLine($"[Sigma] {msg}");
                _logMessages.Add($"[{DateTime.Now:HH:mm:ss}] {msg}");

                InvokeAsync(() =>
                {
                    if (msg.Contains("Music"))
                        enterButtonText = "Playing Music...";
                    else if (msg.Contains("TABG") && msg.Contains("Launch"))
                        enterButtonText = "Launching TABG...";
                    else if (msg.Contains("fans"))
                        enterButtonText = "Setting Fans...";
                    else if (msg.Contains("overlay"))
                        enterButtonText = "Creating Overlays...";
                    else if (msg.Contains("engaged"))
                    {
                        enterButtonText = "Scanning for TABG...";
                        showStopButton = true;
                        infoText = "Music and black screen active. Waiting for TABG to reach main menu...";
                    }
                    else if (msg.Contains("process found"))
                    {
                        enterButtonText = "TABG Loading...";
                        infoText = "TABG process started! Waiting for main menu to load...";
                    }
                    else if (msg.Contains("window detected"))
                    {
                        enterButtonText = "TABG Window Found...";
                        infoText = "TABG window visible! Waiting for main menu...";
                    }
                    else if (msg.Contains("main menu should be loaded"))
                    {
                        enterButtonText = "Main Menu Ready!";
                        infoText = "TABG main menu loaded! Stopping Sigma Mode...";
                        showStopButton = false;
                    }

                    if (msg.Contains("elapsed") || msg.Contains("Found") || msg.Contains("process") ||
                        msg.Contains("window") || msg.Contains("waiting") || msg.Contains("visible"))
                    {
                        debugText = msg;
                    }

                    StateHasChanged();
                });
            });

            var success = await System.Windows.Application.Current.Dispatcher.InvokeAsync(async () =>
            {
                return await _sigmaMode.StartSigmaModeAsync();
            }).Task.Unwrap();

            if (success)
            {
                await Dialog.ShowAsync("Super Secret",
                    "Sigma Mode completed successfully!");
            }
            else
            {
                var logText = string.Join("\n", _logMessages.TakeLast(15));
                await Dialog.ShowAsync("Super Secret",
                    $"Sigma Mode completed with issues.\n\nRecent log:\n{logText}");
            }
        }
        catch (Exception ex)
        {
            await Dialog.ShowAsync("Error", $"Sigma Mode error: {ex.Message}");
        }
        finally
        {
            _sigmaMode?.Dispose();
            _sigmaMode = null;
            isRunning = false;
            enterButtonText = "Enter";
            showStopButton = false;
            infoText = "";
            debugText = "";
            StateHasChanged();
        }
    }

    private void StopButton_Click()
    {
        if (_sigmaMode != null)
        {
            enterButtonText = "Force Stopping...";
            stopButtonDisabled = true;
            infoText = "Force stopping Sigma Mode...";
            debugText = "Manual stop requested";
            _sigmaMode.RequestEmergencyExit();
        }
    }

    public void Dispose()
    {
        _sigmaMode?.RequestEmergencyExit();
        _sigmaMode?.Dispose();
        _sigmaMode = null;
    }
}
