@using System.IO
@inject AppState State
@implements IDisposable

<div style="display:flex; flex-direction:column; height:100%;">
    @if (!State.IsServerConfigured)
    {
        <div style="padding:2rem; text-align:center;">
            <span style="color:var(--muted); text-transform:uppercase; letter-spacing:0.1em; font-size:0.72rem;">
                Configure a server directory to manage presets.
            </span>
        </div>
    }
    else
    {
        <div style="flex:1; display:grid; grid-template-columns:1fr 1fr 1fr; overflow:hidden;">

            <!-- Col 1: Templates (Built-in) -->
            <div class="col">
                <div class="col-header">
                    Templates
                    <span class="col-meta">Built-in</span>
                </div>
                <div class="col-body">
                    @foreach (var preset in BuiltInPresets.All)
                    {
                        var p = preset;
                        <div style="padding:0.5rem 1.25rem; border-bottom:1px solid var(--light-border); cursor:pointer; font-size:0.82rem; font-weight:500; transition:all 0.1s; background:@(p == _selectedTemplate ? "var(--fg)" : "transparent"); color:@(p == _selectedTemplate ? "var(--bg)" : "inherit");"
                             @onclick="() => SelectTemplate(p)">
                            @p.Name
                        </div>
                    }

                    @if (_selectedTemplate != null)
                    {
                        <div style="padding:0.75rem 1.25rem; border-top:1px solid var(--light-border);">
                            <div style="font-size:0.78rem; margin-bottom:0.35rem; white-space:pre-wrap;">@_templateDesc</div>
                            @if (!string.IsNullOrEmpty(_templateNotes))
                            {
                                <div style="font-size:0.6rem; color:var(--muted); margin-bottom:0.5rem;">@_templateNotes</div>
                            }
                        </div>
                    }
                </div>
                <div style="padding:0.75rem 1.25rem; border-top:2px solid var(--fg); flex-shrink:0;">
                    <button class="btn-primary" style="width:100%; font-size:0.72rem; padding:0.7rem 1rem; letter-spacing:0.1em;" @onclick="ApplyTemplate_Click">Apply Template</button>
                </div>
            </div>

            <!-- Col 2: Saved Presets (User) -->
            <div class="col">
                <div class="col-header">
                    Saved Presets
                    <span class="col-meta">User</span>
                </div>
                <div class="col-body">
                    @foreach (var preset in _presets)
                    {
                        var pName = preset;
                        <div style="padding:0.5rem 1.25rem; border-bottom:1px solid var(--light-border); cursor:pointer; font-size:0.82rem; font-weight:500; transition:all 0.1s; background:@(pName == _selectedPreset ? "var(--fg)" : "transparent"); color:@(pName == _selectedPreset ? "var(--bg)" : "inherit");"
                             @onclick="() => _selectedPreset = pName">
                            @pName
                        </div>
                    }
                    @if (_presets.Count == 0)
                    {
                        <div style="padding:2rem; text-align:center; color:var(--muted); font-size:0.72rem;">No saved presets</div>
                    }
                </div>
                <div style="display:flex; gap:0.5rem; padding:0.75rem 1.25rem; border-top:2px solid var(--fg); flex-shrink:0;">
                    <button class="btn-primary" style="flex:1; font-size:0.68rem; padding:0.6rem 0.75rem; letter-spacing:0.08em;" @onclick="LoadPreset_Click">Load Preset</button>
                    <button class="btn-secondary" style="flex:1; font-size:0.68rem; padding:0.6rem 0.75rem;" @onclick="DeletePreset_Click">Delete</button>
                </div>
            </div>

            <!-- Col 3: Save Current Config -->
            <div class="col" style="border-right:none;">
                <div class="col-header">Save Current Config</div>
                <div class="col-body" style="padding:1.25rem;">
                    <div class="block-label">Preset Name</div>
                    <input type="text" class="ctrl-text" style="margin-bottom:1rem;" @bind="_savePresetName" />

                    <div class="block-label">Files to Include</div>
                    @foreach (var entry in _fileEntries)
                    {
                        var fe = entry;
                        <div style="display:flex; align-items:center; gap:0.5rem; margin:0.3rem 0;">
                            <input type="checkbox" class="ctrl-checkbox" checked="@fe.IsSelected"
                                   @onchange="e => OnFileToggled(fe, e)" />
                            <span style="font-size:0.78rem;">@fe.Display</span>
                        </div>
                    }
                </div>
                <div style="padding:0.75rem 1.25rem; border-top:2px solid var(--fg); flex-shrink:0;">
                    <button class="btn-primary" style="width:100%; font-size:0.72rem; padding:0.7rem 1rem; letter-spacing:0.1em;" @onclick="SavePreset_Click">Save Preset</button>
                </div>
            </div>
        </div>

        <!-- Status -->
        @if (!string.IsNullOrEmpty(_statusText))
        {
            <div class="bottom-bar">
                <span class="bottom-status" style="margin-left:1.5rem;">@_statusText</span>
            </div>
        }
    }
</div>

<!-- Save Preset Name Dialog -->
@if (_showSaveDialog)
{
    <div class="dialog-overlay" @onclick="() => _showSaveDialog = false">
        <div class="dialog-box" style="width:360px;" @onclick:stopPropagation>
            <div class="dialog-title">Save Preset</div>
            <div class="dialog-message">Enter a name for the preset:</div>
            <input type="text" class="ctrl-text" @bind="_savePresetName" />
            <div class="dialog-buttons" style="margin-top:1rem;">
                <button @onclick="DoSavePreset">Save</button>
                <button class="ghost" @onclick="() => _showSaveDialog = false">Cancel</button>
            </div>
        </div>
    </div>
}

<ConfirmDialog @ref="_confirmDialog" />

@code {
    // ── State ──
    private BuiltInPresets.BuiltInPreset? _selectedTemplate;
    private string _templateDesc = "";
    private string _templateNotes = "";

    private List<string> _presets = new();
    private string? _selectedPreset;
    private List<FileEntry> _fileEntries = new();

    private string _statusText = "";
    private string _statusCss = "";

    // Save dialog
    private bool _showSaveDialog;
    private string _savePresetName = "MyPreset";

    private ConfirmDialog _confirmDialog = default!;

    // ── Lifecycle ──

    protected override void OnInitialized()
    {
        State.OnServerConfigured += OnServerConfigured;
        if (State.IsServerConfigured)
            Refresh();
    }

    private void OnServerConfigured()
    {
        InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        State.OnServerConfigured -= OnServerConfigured;
    }

    // ── Refresh ──

    private void Refresh()
    {
        RefreshPresets();
        BuildFileList();
    }

    private void RefreshPresets()
    {
        _presets = PresetManager.ListPresets(State.ServerDir).OrderBy(p => p).ToList();
        if (_selectedPreset != null && !_presets.Contains(_selectedPreset))
            _selectedPreset = null;
    }

    private void BuildFileList()
    {
        _fileEntries.Clear();
        foreach (var rel in PresetManager.DefaultConfigRelativePaths)
        {
            var abs = Path.Combine(State.ServerDir, rel);
            if (File.Exists(abs))
            {
                _fileEntries.Add(new FileEntry { RelativePath = rel, IsSelected = true });
            }
        }
    }

    // ── Built-in Templates ──

    private void SelectTemplate(BuiltInPresets.BuiltInPreset preset)
    {
        _selectedTemplate = preset;
        _templateDesc = preset.Description;
        _templateNotes = string.IsNullOrWhiteSpace(preset.Notes) ? "" : $"Notes: {preset.Notes}";
    }

    private async Task ApplyTemplate_Click()
    {
        if (!State.IsServerConfigured)
        {
            await _confirmDialog.ShowAsync("Error", "No server directory set. Please install/select a server first.");
            return;
        }

        if (_selectedTemplate is not { } preset)
        {
            await _confirmDialog.ShowAsync("Error", "Please select a template to apply.");
            return;
        }

        var filesList = string.Join("\n", preset.Files.Keys.Select(k => $"  - {k}"));
        var confirmed = await _confirmDialog.ShowAsync(
            "Apply Server Template",
            $"Apply template '{preset.Name}'?\n\nThis will overwrite:\n{filesList}\n\nContinue?",
            ConfirmDialog.DialogMode.YesNo);

        if (!confirmed) return;

        try
        {
            BuiltInPresets.Deploy(preset, State.ServerDir);

            // Trigger a full reload so other config panels pick up new files
            State.SetServerDir(State.ServerDir);

            _statusText = $"Template '{preset.Name}' applied successfully. All settings have been reloaded.";
            _statusCss = "success";
        }
        catch (Exception ex)
        {
            _statusText = $"Failed to apply template: {ex.Message}";
            _statusCss = "error";
        }
    }

    // ── User Presets ──

    private void SavePreset_Click()
    {
        if (!State.IsServerConfigured) return;
        _savePresetName = "MyPreset";
        _showSaveDialog = true;
    }

    private async Task DoSavePreset()
    {
        _showSaveDialog = false;

        var presetName = _savePresetName?.Trim();
        if (string.IsNullOrWhiteSpace(presetName)) return;

        var selectedPaths = _fileEntries.Where(f => f.IsSelected).Select(f => f.RelativePath).ToArray();
        if (selectedPaths.Length == 0)
        {
            await _confirmDialog.ShowAsync("Error", "Please select at least one file to include.");
            return;
        }

        try
        {
            PresetManager.SavePreset(State.ServerDir, presetName, selectedPaths);
            RefreshPresets();
            _statusText = $"Preset '{presetName}' saved.";
            _statusCss = "success";
        }
        catch (Exception ex)
        {
            _statusText = $"Failed to save preset: {ex.Message}";
            _statusCss = "error";
        }
    }

    private async Task LoadPreset_Click()
    {
        if (_selectedPreset is not { } presetName)
        {
            await _confirmDialog.ShowAsync("Error", "Please select a preset to load.");
            return;
        }

        var confirmed = await _confirmDialog.ShowAsync(
            "Load Preset",
            $"Overwrite current config files with preset '{presetName}'?",
            ConfirmDialog.DialogMode.YesNo);

        if (!confirmed) return;

        try
        {
            PresetManager.LoadPreset(State.ServerDir, presetName);

            // Trigger a full reload so other config panels pick up new files
            State.SetServerDir(State.ServerDir);

            _statusText = $"Preset '{presetName}' loaded.";
            _statusCss = "success";
        }
        catch (Exception ex)
        {
            _statusText = $"Failed to load preset: {ex.Message}";
            _statusCss = "error";
        }
    }

    private async Task DeletePreset_Click()
    {
        if (_selectedPreset is not { } presetName)
        {
            await _confirmDialog.ShowAsync("Error", "Please select a preset to delete.");
            return;
        }

        var confirmed = await _confirmDialog.ShowAsync(
            "Delete Preset",
            $"Delete preset '{presetName}'? This cannot be undone.",
            ConfirmDialog.DialogMode.YesNo);

        if (!confirmed) return;

        try
        {
            PresetManager.DeletePreset(State.ServerDir, presetName);
            _selectedPreset = null;
            RefreshPresets();
            _statusText = $"Preset '{presetName}' deleted.";
            _statusCss = "";
        }
        catch (Exception ex)
        {
            _statusText = $"Failed to delete preset: {ex.Message}";
            _statusCss = "error";
        }
    }

    // ── Helpers ──

    private void OnFileToggled(FileEntry entry, ChangeEventArgs e)
    {
        if (e.Value is bool b)
            entry.IsSelected = b;
        else if (e.Value is string s && bool.TryParse(s, out var parsed))
            entry.IsSelected = parsed;
    }

    private class FileEntry
    {
        public string RelativePath { get; set; } = string.Empty;
        public string Display => RelativePath.Replace("\\", "/");
        public bool IsSelected { get; set; } = true;
    }
}
