@inject AppState State
@implements IDisposable

@if (_settings == null)
{
    <div style="flex: 1; display: flex; align-items: center; justify-content: center;">
        <p style="color: var(--muted); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.1em;">Configure a server directory to edit match settings.</p>
    </div>
}
else
{
    <div class="card-grid">
        <!-- Match Mode -->
        <div class="card">
            <div class="card-header">Match Mode</div>
            <div class="card-body">
                <div class="field"><div class="field-name">Loadout Mode</div><div class="field-input"><select class="ctrl-select" @bind="_loadoutMode"><option value="Normal">Normal</option><option value="GunGame">GunGame</option><option value="ReverseGunGame">ReverseGunGame</option><option value="KeepInventory">KeepInventory</option></select></div></div>
                <div class="field"><div class="field-name">Win Condition</div><div class="field-input"><select class="ctrl-select" @bind="WinCondition"><option value="Default">Default</option><option value="KillsToWin">KillsToWin</option><option value="Debug">Debug</option></select></div></div>
                <div class="field"><div class="field-name">Kills To Win</div><div class="field-input"><input class="ctrl-text narrow" type="text" @bind="_killsToWinText" /><span class="ctrl-hint">only if KillsToWin</span></div></div>
                <div class="field"><div class="field-name">Force Kill At Start</div><div class="field-input"><input class="ctrl-checkbox" type="checkbox" @bind="_settings.ForceKillAtStart" /></div></div>
                <div class="field"><div class="field-name">Drop Items On Death</div><div class="field-input"><input class="ctrl-checkbox" type="checkbox" @bind="_settings.DropItemsOnDeath" /></div></div>
                <div class="field"><div class="field-name">Can Go Down</div><div class="field-input"><input class="ctrl-checkbox" type="checkbox" @bind="_settings.CanGoDown" /></div></div>
                <div class="field"><div class="field-name">Can Lock Out</div><div class="field-input"><input class="ctrl-checkbox" type="checkbox" @bind="_settings.CanLockOut" /></div></div>
            </div>
        </div>

        <!-- Heal & Combat -->
        <div class="card">
            <div class="card-header">Heal & Combat</div>
            <div class="card-body">
                <div class="field"><div class="field-name">Heal On Kill</div><div class="field-input"><input class="ctrl-checkbox" type="checkbox" @bind="_settings.HealOnKill" /></div></div>
                <div class="field"><div class="field-name">Heal Amount %</div><div class="field-input"><input class="ctrl-text narrow" type="text" @bind="_healOnKillAmountText" /><span class="ctrl-hint">percent</span></div></div>
            </div>
        </div>

        <!-- Vote Settings -->
        <div class="card">
            <div class="card-header">Vote Settings</div>
            <div class="card-body">
                <div class="field"><div class="field-name">Percent Of Votes</div><div class="field-input"><input class="ctrl-text narrow" type="text" @bind="_percentOfVotesText" /><span class="ctrl-hint">%</span></div></div>
                <div class="field"><div class="field-name">Min Players</div><div class="field-input"><input class="ctrl-text narrow" type="text" @bind="_minPlayersText" /></div></div>
                <div class="field"><div class="field-name">Time To Start</div><div class="field-input"><input class="ctrl-text narrow" type="text" @bind="_timeToStartText" /><span class="ctrl-hint">seconds</span></div></div>
            </div>
        </div>

        <!-- Spell Drops -->
        <div class="card">
            <div class="card-header">Spell Drops</div>
            <div class="card-body">
                <div class="field"><div class="field-name">Enabled</div><div class="field-input"><input class="ctrl-checkbox" type="checkbox" @bind="_settings.SpelldropEnabled" /></div></div>
                <div class="field"><div class="field-name">Min Delay</div><div class="field-input"><input class="ctrl-text narrow" type="text" @bind="_minSpellDropDelayText" /><span class="ctrl-hint">seconds</span></div></div>
                <div class="field"><div class="field-name">Max Delay</div><div class="field-input"><input class="ctrl-text narrow" type="text" @bind="_maxSpellDropDelayText" /><span class="ctrl-hint">seconds</span></div></div>
                <div class="field"><div class="field-name">First Drop Offset</div><div class="field-input"><input class="ctrl-text narrow" type="text" @bind="_spellDropOffsetText" /><span class="ctrl-hint">seconds</span></div></div>
            </div>
        </div>

        <!-- Timeouts -->
        <div class="card">
            <div class="card-header">Timeouts</div>
            <div class="card-body">
                <div class="field"><div class="field-name">Pre-Match Timeout</div><div class="field-input"><input class="ctrl-text narrow" type="text" @bind="_preMatchTimeoutText" /><span class="ctrl-hint">minutes</span></div></div>
                <div class="field"><div class="field-name">Match Timeout</div><div class="field-input"><input class="ctrl-text narrow" type="text" @bind="_periMatchTimeoutText" /><span class="ctrl-hint">minutes</span></div></div>
            </div>
        </div>
    </div>

    <div class="bottom-bar">
        <button class="bottom-btn" @onclick="Save">Save</button>
        <span class="bottom-status">@(_statusText == "" ? "Settings loaded from StarterPack config" : _statusText)</span>
    </div>
}

@code {
    private StarterPackTextSettings? _settings;
    private string _statusText = "";
    private string _statusCss = "";

    private string _loadoutMode = "Normal";
    private string _killsToWinText = "";
    private string _healOnKillAmountText = "20";
    private string _percentOfVotesText = "50";
    private string _minPlayersText = "2";
    private string _timeToStartText = "30";
    private string _minSpellDropDelayText = "180";
    private string _maxSpellDropDelayText = "420";
    private string _spellDropOffsetText = "30";
    private string _preMatchTimeoutText = "15";
    private string _periMatchTimeoutText = "15";

    private string WinCondition
    {
        get => _settings?.WinCondition ?? "Default";
        set
        {
            if (_settings != null)
                _settings.WinCondition = value;
        }
    }

    protected override void OnInitialized()
    {
        State.OnServerConfigured += OnServerConfigured;
        if (State.IsServerConfigured)
            Load();
    }

    private void OnServerConfigured()
    {
        InvokeAsync(() =>
        {
            Load();
            StateHasChanged();
        });
    }

    private void Load()
    {
        try
        {
            _settings = StarterPackConfigService.Read(State.ServerDir);
            _loadoutMode = _settings.GetLoadoutMode();
            _killsToWinText = _settings.KillsToWin?.ToString() ?? "";
            _healOnKillAmountText = _settings.HealOnKillAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _percentOfVotesText = _settings.PercentOfVotes.ToString();
            _minPlayersText = _settings.MinNumberOfPlayers.ToString();
            _timeToStartText = _settings.TimeToStart.ToString();
            _minSpellDropDelayText = _settings.MinSpellDropDelay.ToString();
            _maxSpellDropDelayText = _settings.MaxSpellDropDelay.ToString();
            _spellDropOffsetText = _settings.SpellDropOffset.ToString();
            _preMatchTimeoutText = _settings.PreMatchTimeout.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _periMatchTimeoutText = _settings.PeriMatchTimeout.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _statusText = "";
        }
        catch (Exception ex)
        {
            _statusText = $"Error loading: {ex.Message}";
        }
    }

    private void Save()
    {
        try
        {
            if (_settings == null)
                _settings = new StarterPackTextSettings();

            var loadoutsWithoutPrefix = _settings.GetLoadoutsWithoutPrefix();
            _settings.SetLoadoutsWithPrefix(_loadoutMode, loadoutsWithoutPrefix);

            if (int.TryParse(_killsToWinText.Trim(), out var ktw))
                _settings.KillsToWin = ktw;
            else
                _settings.KillsToWin = null;

            if (float.TryParse(_healOnKillAmountText.Trim(),
                    System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var healAmt))
                _settings.HealOnKillAmount = healAmt;

            if (int.TryParse(_percentOfVotesText.Trim(), out var pov))
                _settings.PercentOfVotes = pov;
            if (int.TryParse(_minPlayersText.Trim(), out var mnp))
                _settings.MinNumberOfPlayers = mnp;
            if (int.TryParse(_timeToStartText.Trim(), out var tts))
                _settings.TimeToStart = tts;

            if (int.TryParse(_minSpellDropDelayText.Trim(), out var minsd))
                _settings.MinSpellDropDelay = minsd;
            if (int.TryParse(_maxSpellDropDelayText.Trim(), out var maxsd))
                _settings.MaxSpellDropDelay = maxsd;
            if (int.TryParse(_spellDropOffsetText.Trim(), out var sdo))
                _settings.SpellDropOffset = sdo;

            if (float.TryParse(_preMatchTimeoutText.Trim(),
                    System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var pmt))
                _settings.PreMatchTimeout = pmt;
            if (float.TryParse(_periMatchTimeoutText.Trim(),
                    System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var pmtt))
                _settings.PeriMatchTimeout = pmtt;

            StarterPackConfigService.Write(State.ServerDir, _settings);
            _statusText = "Settings saved";
        }
        catch (Exception ex)
        {
            _statusText = $"Error saving: {ex.Message}";
        }
    }

    public void Dispose()
    {
        State.OnServerConfigured -= OnServerConfigured;
    }
}
