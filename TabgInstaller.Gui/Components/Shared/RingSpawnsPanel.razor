@using TabgInstaller.Core
@using TabgInstaller.Core.Model
@using TabgInstaller.Core.Services
@inject AppState State

<!-- Three columns: Location+Ring | Lobby Spawn | Match Spawns -->
<div style="flex: 1; display: grid; grid-template-columns: 1fr 1fr 1fr; overflow: hidden;">
    <!-- COL 1: Location & Ring -->
    <div class="col">
        <div class="col-header">Location & Ring</div>
        <div class="col-body">
            <div class="block">
                <div class="block-label">Location</div>
                <div class="block-row">
                    <select class="ctrl-select" style="flex: 1;" value="@_selectedLocationIndex" @onchange="OnLocationChanged">
                        @for (int i = 0; i < ItemDatabase.SpawnLocations.Count; i++)
                        {
                            var loc = ItemDatabase.SpawnLocations[i];
                            <option value="@i">@loc.Name</option>
                        }
                    </select>
                    <button style="font-family: var(--mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.35rem 0.8rem; background: var(--fg); color: var(--bg); border: none; cursor: pointer; flex-shrink: 0;" @onclick="ApplyLocation">Apply</button>
                </div>
                <div style="font-size: 0.65rem; color: var(--muted); margin-top: 0.4rem;">@_locationInfo</div>
            </div>

            <div class="block">
                <div class="block-label">Ring Sizes</div>
                <input class="ctrl-text" type="text" value="@_ringSizes" @onchange="e => _ringSizes = e.Value?.ToString() ?? string.Empty" />
            </div>

            <div class="block">
                <div class="block-label">Ring Speeds</div>
                <input class="ctrl-text" type="text" value="@_ringSpeeds" @onchange="e => _ringSpeeds = e.Value?.ToString() ?? string.Empty" />
            </div>
        </div>

        <div style="display: flex; border-top: 1px solid var(--light-border); margin-top: auto; flex-shrink: 0;">
            <button style="font-family: var(--mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.5rem 1rem; background: transparent; border: none; border-right: 1px solid var(--light-border); cursor: pointer; color: var(--muted); flex: 1; text-align: center;" @onclick="PresetDeathmatch">Deathmatch</button>
            <button style="font-family: var(--mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.5rem 1rem; background: transparent; border: none; cursor: pointer; color: var(--muted); flex: 1; text-align: center;" @onclick="PresetStandardBR">Standard BR</button>
        </div>
    </div>

    <!-- COL 2: Lobby Spawn -->
    <div class="col">
        <div class="col-header">Lobby Spawn</div>
        <div class="col-body">
            <div class="block">
                <div class="block-label">Use Custom Spawn</div>
                <div class="block-row">
                    <input class="ctrl-checkbox" type="checkbox" checked="@_useCustomSpawn" @onchange="OnUseCustomSpawnChanged" />
                    <span style="font-size: 0.75rem;">Enabled</span>
                </div>
            </div>

            <div class="block">
                <div class="block-label">Spawn Point (x, y, z)</div>
                <input class="ctrl-text" type="text" value="@_customSpawnPoint" @onchange="e => _customSpawnPoint = e.Value?.ToString() ?? string.Empty" />
            </div>

            <div class="block">
                <div style="font-size: 0.65rem; color: var(--muted);">@_spawnInfo</div>
            </div>
        </div>
    </div>

    <!-- COL 3: Match Spawns -->
    <div class="col">
        <div class="col-header">
            <span>Match Spawns</span>
            <span class="col-meta">@_spawnCount</span>
        </div>
        <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
            <textarea class="ctrl-textarea" value="@_matchSpawns" @oninput="OnMatchSpawnsInput">@_matchSpawns</textarea>
        </div>
    </div>
</div>

<div class="bottom-bar">
    <button class="bottom-btn" @onclick="Save">Save</button>
    <span class="bottom-status">@(_statusText == "" ? "Settings loaded" : _statusText)</span>
</div>

@code {
    private int _selectedLocationIndex;
    private string _locationInfo = "";
    private string _ringSizes = "";
    private string _ringSpeeds = "";
    private string _customSpawnPoint = "";
    private bool _useCustomSpawn;
    private string _spawnInfo = "When enabled, ValidSpawnPoints is set to 6 (custom). Disable to revert to default spawn.";
    private string _matchSpawns = "";
    private string _spawnCount = "0 points";
    private string _statusText = "";

    private StarterPackTextSettings? _starterPackSettings;

    protected override void OnInitialized()
    {
        State.OnServerConfigured += OnServerConfigured;
        if (State.IsServerConfigured)
            LoadSettings();
    }

    private void OnServerConfigured()
    {
        InvokeAsync(() =>
        {
            LoadSettings();
            StateHasChanged();
        });
    }

    private void LoadSettings()
    {
        try
        {
            _selectedLocationIndex = 0;
            UpdateLocationInfo();

            _starterPackSettings = StarterPackConfigService.Read(State.ServerDir);
            _customSpawnPoint = _starterPackSettings.CustomSpawnPoint;
            _useCustomSpawn = _starterPackSettings.ValidSpawnPoints.Contains("6");
            UpdateSpawnInfo();

            var gsPath = System.IO.Path.Combine(State.ServerDir, "game_settings.txt");
            if (System.IO.File.Exists(gsPath))
            {
                var gs = ConfigIO.ReadGameSettings(gsPath);
                _ringSizes = gs.RingSizes;
                _ringSpeeds = gs.RingSpeeds;
            }

            var spawnPoints = ModConfigService.ReadSpawnPoints(State.ServerDir);
            _matchSpawns = SpawnPointsToMultiline(spawnPoints);
            UpdateSpawnCount();

            _statusText = "";
        }
        catch (Exception ex)
        {
            _statusText = $"Error loading: {ex.Message}";
        }
    }

    private void OnLocationChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx))
        {
            _selectedLocationIndex = idx;
            UpdateLocationInfo();
        }
    }

    private void UpdateLocationInfo()
    {
        if (_selectedLocationIndex >= 0 && _selectedLocationIndex < ItemDatabase.SpawnLocations.Count)
        {
            var loc = ItemDatabase.SpawnLocations[_selectedLocationIndex];
            var spawnCount = loc.MatchSpawns.Split(';').Length;
            _locationInfo = $"Ring: {loc.RingSize} | Lobby: {loc.LobbySpawn} | {spawnCount} spawns";
        }
        else
        {
            _locationInfo = "";
        }
    }

    private void ApplyLocation()
    {
        if (_selectedLocationIndex < 0 || _selectedLocationIndex >= ItemDatabase.SpawnLocations.Count) return;

        var loc = ItemDatabase.SpawnLocations[_selectedLocationIndex];
        _ringSizes = $"{loc.RingSize}, {loc.RingSize}, {loc.RingSize}";
        _customSpawnPoint = loc.LobbySpawn;
        _useCustomSpawn = true;
        UpdateSpawnInfo();
        _matchSpawns = SpawnPointsToMultiline(loc.MatchSpawns);
        UpdateSpawnCount();
        _statusText = $"Applied location: {loc.Name}";
    }

    private void PresetDeathmatch()
    {
        if (_selectedLocationIndex >= 0 && _selectedLocationIndex < ItemDatabase.SpawnLocations.Count)
        {
            var loc = ItemDatabase.SpawnLocations[_selectedLocationIndex];
            _ringSizes = $"{loc.RingSize}, {loc.RingSize}, {loc.RingSize}";
        }
        _ringSpeeds = "0.001, 50, 0.001";
        _statusText = "Applied deathmatch ring preset";
    }

    private void PresetStandardBR()
    {
        _ringSizes = "4240.0, 3450.0, 1710.0";
        _ringSpeeds = "120, 120, 150";
        _statusText = "Applied standard BR ring preset";
    }

    private void OnUseCustomSpawnChanged(ChangeEventArgs e)
    {
        if (e.Value is bool b)
            _useCustomSpawn = b;
        else if (e.Value is string s && bool.TryParse(s, out var parsed))
            _useCustomSpawn = parsed;
        UpdateSpawnInfo();
    }

    private void UpdateSpawnInfo()
    {
        _spawnInfo = _useCustomSpawn
            ? "When enabled, ValidSpawnPoints is set to 6 (custom). Disable to revert to default spawn."
            : "Custom spawn disabled. ValidSpawnPoints will revert to default.";
    }

    private void OnMatchSpawnsInput(ChangeEventArgs e)
    {
        _matchSpawns = e.Value?.ToString() ?? "";
        UpdateSpawnCount();
    }

    private void UpdateSpawnCount()
    {
        var lines = _matchSpawns
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .ToArray();
        _spawnCount = $"{lines.Length} points";
    }

    private void Save()
    {
        try
        {
            if (_starterPackSettings == null)
                _starterPackSettings = StarterPackConfigService.Read(State.ServerDir);

            _starterPackSettings.CustomSpawnPoint = _customSpawnPoint.Trim();
            if (_useCustomSpawn)
                _starterPackSettings.ValidSpawnPoints = "6";
            else if (_starterPackSettings.ValidSpawnPoints == "6")
                _starterPackSettings.ValidSpawnPoints = "2";

            StarterPackConfigService.Write(State.ServerDir, _starterPackSettings);

            var spawnPointsStr = MultilineToSpawnPoints(_matchSpawns);
            ModConfigService.WriteSpawnPoints(State.ServerDir, spawnPointsStr);

            var gsPath = System.IO.Path.Combine(State.ServerDir, "game_settings.txt");
            var gs = System.IO.File.Exists(gsPath)
                ? ConfigIO.ReadGameSettings(gsPath)
                : new GameSettingsData();

            gs.RingSizes = _ringSizes.Trim();
            gs.RingSpeeds = _ringSpeeds.Trim();
            ConfigIO.WriteGameSettings(gs, gsPath);

            _statusText = "Settings saved";
        }
        catch (Exception ex)
        {
            _statusText = $"Error saving: {ex.Message}";
        }
    }

    private static string SpawnPointsToMultiline(string spawnPoints)
    {
        if (string.IsNullOrWhiteSpace(spawnPoints)) return "";
        var points = spawnPoints.Split(';')
            .Select(p => p.Trim())
            .Where(p => !string.IsNullOrEmpty(p));
        return string.Join(Environment.NewLine, points);
    }

    private static string MultilineToSpawnPoints(string multiline)
    {
        if (string.IsNullOrWhiteSpace(multiline)) return "";
        var points = multiline.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Trim())
            .Where(p => !string.IsNullOrEmpty(p));
        return string.Join(";", points);
    }

    public void Dispose()
    {
        State.OnServerConfigured -= OnServerConfigured;
    }
}
