@inject AppState State
@implements IDisposable

<div style="display:flex; flex-direction:column; height:100%;">
    @if (!State.IsServerConfigured)
    {
        <div style="padding:2rem; text-align:center;">
            <span style="color:var(--muted); text-transform:uppercase; letter-spacing:0.1em; font-size:0.72rem;">
                Configure a server directory to edit mod settings.
            </span>
        </div>
    }
    else
    {
        <div style="flex:1; display:grid; grid-template-columns:1fr 1fr 1fr; overflow:hidden;">

            <!-- Col 1: Grenades On Death -->
            <div class="col">
                <div class="col-header">Grenades On Death</div>
                <div class="col-body">

                    <!-- Attacker -->
                    <div class="block">
                        <div class="block-label">Attacker</div>
                        <div class="block-row" style="margin-bottom:0.35rem;">
                            <input type="checkbox" class="ctrl-checkbox" @bind="_attackerEnabled" />
                            <span style="font-size:0.82rem;">Enabled</span>
                        </div>
                        <div class="block-row" style="margin-bottom:0.35rem;">
                            <span class="field-name" style="min-width:auto; font-size:0.75rem;">Chance</span>
                            <input type="text" class="ctrl-text narrow" @bind="_attackerChanceText" />
                        </div>
                        <div class="block-row">
                            <span class="field-name" style="min-width:auto; font-size:0.75rem;">Grenade</span>
                            <select class="ctrl-select" @bind="_attackerGrenadeIndex">
                                <option value="-1">(none)</option>
                                @for (int i = 0; i < _grenades.Count; i++)
                                {
                                    var g = _grenades[i];
                                    <option value="@i">@g.Name (@g.Id)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Corpse -->
                    <div class="block">
                        <div class="block-label">Corpse</div>
                        <div class="block-row" style="margin-bottom:0.35rem;">
                            <input type="checkbox" class="ctrl-checkbox" @bind="_corpseEnabled" />
                            <span style="font-size:0.82rem;">Enabled</span>
                        </div>
                        <div class="block-row" style="margin-bottom:0.35rem;">
                            <span class="field-name" style="min-width:auto; font-size:0.75rem;">Chance</span>
                            <input type="text" class="ctrl-text narrow" @bind="_corpseChanceText" />
                        </div>
                        <div class="block-row">
                            <span class="field-name" style="min-width:auto; font-size:0.75rem;">Grenade</span>
                            <select class="ctrl-select" @bind="_corpseGrenadeIndex">
                                <option value="-1">(none)</option>
                                @for (int i = 0; i < _grenades.Count; i++)
                                {
                                    var g = _grenades[i];
                                    <option value="@i">@g.Name (@g.Id)</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Col 2: Loot & Lives + Proximity Chat -->
            <div class="col">
                <div class="col-header">Loot &amp; Lives</div>
                <div class="col-body">
                    <div class="block">
                        <div class="block-row" style="margin-bottom:0.35rem;">
                            <input type="checkbox" class="ctrl-checkbox" @bind="_enableLootDrops" />
                            <span style="font-size:0.82rem;">Enable Loot Drops</span>
                        </div>
                        <div class="block-row" style="margin-bottom:0.35rem;">
                            <span class="field-name" style="min-width:auto; font-size:0.75rem;">Lives</span>
                            <input type="text" class="ctrl-text narrow" @bind="_livesText" />
                            <span class="ctrl-hint">256 = infinite</span>
                        </div>
                        <div class="block-row">
                            <span class="field-name" style="min-width:auto; font-size:0.75rem;">Streaming Dist</span>
                            <input type="text" class="ctrl-text narrow" @bind="_streamingDistanceText" />
                            <span class="ctrl-hint">-1 = normal</span>
                        </div>
                    </div>

                    <div class="block">
                        <div class="block-label">Proximity Chat</div>
                        <div class="block-row" style="margin-bottom:0.35rem;">
                            <span class="field-name" style="min-width:auto; font-size:0.75rem;">Max Range</span>
                            <input type="text" class="ctrl-text narrow" @bind="_proxChatMaxRangeText" />
                            <span class="ctrl-hint">default 50</span>
                        </div>
                        <div class="block-row" style="margin-bottom:0.35rem;">
                            <span class="field-name" style="min-width:auto; font-size:0.75rem;">Min Range</span>
                            <input type="text" class="ctrl-text narrow" @bind="_proxChatMinRangeText" />
                            <span class="ctrl-hint">default 5</span>
                        </div>
                        <div class="block-row">
                            <span class="field-name" style="min-width:auto; font-size:0.75rem;">Falloff Curve</span>
                            <select class="ctrl-select" @bind="_proxChatFalloff">
                                <option value="Linear">Linear</option>
                                <option value="Logarithmic">Logarithmic</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Col 3: Ban List -->
            <div class="col" style="border-right:none;">
                <div class="col-header">
                    Ban List
                    <span class="col-meta">One Epic ID per line</span>
                </div>
                <div class="col-body" style="display:flex; flex-direction:column;">
                    <textarea class="ctrl-textarea" style="flex:1;"
                              @bind="_banListText"></textarea>
                </div>
            </div>
        </div>

        <!-- Bottom bar -->
        <div class="bottom-bar">
            <button class="bottom-btn" @onclick="Save">Save</button>
            <span class="bottom-status">@_statusText</span>
        </div>
    }
</div>

@code {
    private List<GameItem> _grenades = new();

    // StarterPack Fixes
    private bool _enableLootDrops;

    // Grenades - Attacker
    private bool _attackerEnabled;
    private string _attackerChanceText = "1";
    private int _attackerGrenadeIndex = -1;

    // Grenades - Corpse
    private bool _corpseEnabled;
    private string _corpseChanceText = "0.2";
    private int _corpseGrenadeIndex = -1;

    // Lives & Advanced
    private string _livesText = "256";
    private string _streamingDistanceText = "-1";

    // Ban List
    private string _banListText = "";

    // Proximity Chat
    private string _proxChatMaxRangeText = "50";
    private string _proxChatMinRangeText = "5";
    private string _proxChatFalloff = "Linear";

    // Status
    private string _statusText = "";
    private string _statusCss = "";

    protected override void OnInitialized()
    {
        _grenades = ItemDatabase.ByCategory("Grenades").OrderBy(g => g.Name).ToList();

        State.OnServerConfigured += OnServerConfigured;
        if (State.IsServerConfigured)
            Load();
    }

    private void OnServerConfigured()
    {
        InvokeAsync(() =>
        {
            Load();
            StateHasChanged();
        });
    }

    private void Load()
    {
        try
        {
            var commission = ModConfigService.ReadCommission(State.ServerDir);
            var fixes = ModConfigService.ReadFixes(State.ServerDir);

            // StarterPack Fixes
            _enableLootDrops = fixes.EnableLootDrops;

            // Grenades - Attacker
            _attackerEnabled = commission.GrenadeAttackerEnabled;
            _attackerChanceText = commission.GrenadeAttackerChance.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _attackerGrenadeIndex = _grenades.FindIndex(g => g.Id == commission.GrenadeAttackerId);

            // Grenades - Corpse
            _corpseEnabled = commission.GrenadeCorpseEnabled;
            _corpseChanceText = commission.GrenadeCorpseChance.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _corpseGrenadeIndex = _grenades.FindIndex(g => g.Id == commission.GrenadeCorpseId);

            // Lives & Advanced
            _livesText = commission.Lives.ToString();
            _streamingDistanceText = commission.StreamingDistance.ToString(System.Globalization.CultureInfo.InvariantCulture);

            // Ban List: comma-separated -> one per line
            if (!string.IsNullOrWhiteSpace(commission.BanList))
            {
                var ids = commission.BanList
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(s => s.Trim())
                    .Where(s => s.Length > 0);
                _banListText = string.Join(Environment.NewLine, ids);
            }
            else
            {
                _banListText = "";
            }

            _statusText = "Settings loaded.";
            _statusCss = "";
        }
        catch (Exception ex)
        {
            _statusText = $"Error loading: {ex.Message}";
            _statusCss = "error";
        }

        // Proximity Chat config
        try
        {
            string proxCfgPath = System.IO.Path.Combine(State.ServerDir, "BepInEx", "config", "tabginstaller.proximitychat.server.cfg");
            if (System.IO.File.Exists(proxCfgPath))
            {
                var lines = System.IO.File.ReadAllLines(proxCfgPath);
                foreach (var line in lines)
                {
                    var trimmed = line.Trim();
                    if (trimmed.StartsWith("#") || trimmed.StartsWith("[") || trimmed.Length == 0) continue;
                    if (trimmed.StartsWith("MaxRange")) _proxChatMaxRangeText = ExtractCfgValue(trimmed);
                    else if (trimmed.StartsWith("MinRange")) _proxChatMinRangeText = ExtractCfgValue(trimmed);
                    else if (trimmed.StartsWith("FalloffCurve")) _proxChatFalloff = ExtractCfgValue(trimmed) == "Logarithmic" ? "Logarithmic" : "Linear";
                }
            }
            else
            {
                _proxChatMaxRangeText = "50";
                _proxChatMinRangeText = "5";
                _proxChatFalloff = "Linear";
            }
        }
        catch { }
    }

    private void Save()
    {
        try
        {
            // Read existing commission to preserve LoadoutCurses and LoadoutBlessings
            var commission = ModConfigService.ReadCommission(State.ServerDir);

            // StarterPack Fixes
            var fixes = new StarterPackFixesSettings
            {
                EnableLootDrops = _enableLootDrops
            };

            // Grenades - Attacker
            commission.GrenadeAttackerEnabled = _attackerEnabled;
            if (float.TryParse(_attackerChanceText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var attackerChance))
                commission.GrenadeAttackerChance = attackerChance;
            if (_attackerGrenadeIndex >= 0 && _attackerGrenadeIndex < _grenades.Count)
                commission.GrenadeAttackerId = _grenades[_attackerGrenadeIndex].Id;

            // Grenades - Corpse
            commission.GrenadeCorpseEnabled = _corpseEnabled;
            if (float.TryParse(_corpseChanceText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var corpseChance))
                commission.GrenadeCorpseChance = corpseChance;
            if (_corpseGrenadeIndex >= 0 && _corpseGrenadeIndex < _grenades.Count)
                commission.GrenadeCorpseId = _grenades[_corpseGrenadeIndex].Id;

            // Lives & Advanced
            if (int.TryParse(_livesText, out var lives))
                commission.Lives = lives;
            if (float.TryParse(_streamingDistanceText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var sd))
                commission.StreamingDistance = sd;

            // Ban List: one per line -> comma-separated
            var banLines = _banListText
                .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Trim())
                .Where(s => s.Length > 0);
            commission.BanList = string.Join(",", banLines);

            // Write both configs
            ModConfigService.WriteCommission(State.ServerDir, commission);
            ModConfigService.WriteFixes(State.ServerDir, fixes);

            _statusText = "Settings saved.";
            _statusCss = "success";

            // Save Proximity Chat config
            try
            {
                string proxCfgDir = System.IO.Path.Combine(State.ServerDir, "BepInEx", "config");
                System.IO.Directory.CreateDirectory(proxCfgDir);
                string proxCfgPath = System.IO.Path.Combine(proxCfgDir, "tabginstaller.proximitychat.server.cfg");

                string content = $@"[ProximityChat]

## Distance beyond which audio is not relayed
# Setting type: Single
# Default value: 50
MaxRange = {_proxChatMaxRangeText.Trim()}

## Distance within which audio is full volume
# Setting type: Single
# Default value: 5
MinRange = {_proxChatMinRangeText.Trim()}

## Volume falloff: Linear or Logarithmic
# Setting type: String
# Default value: Linear
FalloffCurve = {_proxChatFalloff}
";
                System.IO.File.WriteAllText(proxCfgPath, content);
            }
            catch { }
        }
        catch (Exception ex)
        {
            _statusText = $"Error saving: {ex.Message}";
            _statusCss = "error";
        }
    }

    private static string ExtractCfgValue(string line)
    {
        int eq = line.IndexOf('=');
        return eq >= 0 ? line.Substring(eq + 1).Trim() : "";
    }

    public void Dispose()
    {
        State.OnServerConfigured -= OnServerConfigured;
    }
}
