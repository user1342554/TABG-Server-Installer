@using System.Collections
@using TabgInstaller.Core.Services

@if (ViewModel == null)
{
    <p style="color: var(--muted); padding: 1.25rem;">No settings loaded.</p>
}
else
{
    <!-- Identity & Networking -->
    @RenderCard("Identity & Networking", new[] { "ServerName", "ServerDescription", "Password", "ServerBrowserIP", "Port", "MaxPlayers" })

    <!-- Lobby & Start -->
    @RenderCard("Lobby & Start", new[] { "TeamMode", "GameMode", "Relay", "AutoTeam", "LAN", "AllowSpectating" })

    <!-- Timing -->
    @RenderCard("Timing", new[] { "UseTimedForceStart", "ForceStartTime", "MinPlayersToForceStart", "PlayersToStart", "Countdown" })

    <!-- Ring -->
    @RenderCard("Ring", new[] { "NoRing", "BaseRingTime", "TimeBeforeFirstRing", "RingSizes", "RingSpeeds" })

    <!-- Gameplay -->
    @RenderCard("Gameplay", new[] { "CarSpawnRate", "StripLootByPercentage", "WeaponDissapearTime", "AllowRespawnMinigame", "AntiCheat" })

    <!-- Advanced -->
    @RenderCard("Advanced", new[] { "UseKicks", "AllowRejoins", "SpawnBots", "UsePlayFabStats", "DEBUG_DEATHMATCH" })

    <!-- Remaining fields not in the above groups -->
    @if (GetRemainingProps().Any())
    {
        <div class="card" style="grid-column: 1 / -1;">
            <div class="card-header">Other</div>
            <div class="card-body">
                @foreach (var prop in GetRemainingProps())
                {
                    @RenderField(prop)
                }
            </div>
        </div>
    }
}

@code {
    [Parameter] public GameSettingsDynamicViewModel? ViewModel { get; set; }

    private RenderFragment RenderCard(string title, string[] propNames) => __builder =>
    {
        if (ViewModel == null) return;
        var props = propNames
            .Select(n => ViewModel.Properties.FirstOrDefault(p => p.Name == n))
            .Where(p => p != null && p.IsVisible)
            .ToList();

        if (!props.Any()) return;

        <div class="card">
            <div class="card-header">@title</div>
            <div class="card-body">
                @foreach (var prop in props)
                {
                    @RenderField(prop!)
                }
            </div>
        </div>;
    };

    private RenderFragment RenderField(SettingPropertyVM prop) => __builder =>
    {
        <div class="field">
            <div class="field-name">@prop.Name</div>
            <div class="field-input">
                @switch (prop.ControlType)
                {
                    case "CheckBox":
                        <input class="ctrl-checkbox" type="checkbox" checked="@prop.BoolValue"
                               @onchange="e => OnCheckChanged(prop, e)" />
                        break;

                    case "ComboBox":
                        @if (HasComboItems(prop))
                        {
                            <select class="ctrl-select" value="@prop.ValueString"
                                    @onchange="e => OnValueChanged(prop, e)">
                                @foreach (var item in GetComboItems(prop)!)
                                {
                                    <option value="@item" selected="@(item == prop.ValueString)">@item</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input class="ctrl-text" type="text" value="@prop.ValueString"
                                   @onchange="e => OnValueChanged(prop, e)" />
                        }
                        break;

                    case "Slider":
                        <div class="ctrl-slider-wrap">
                            <input class="ctrl-slider" type="range"
                                   min="@prop.SliderMinimum.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   max="@prop.SliderMaximum.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   step="0.1"
                                   value="@prop.ValueString"
                                   @onchange="e => OnValueChanged(prop, e)" />
                            <span class="ctrl-slider-val">@prop.ValueString</span>
                        </div>
                        break;

                    case "NumericUpDown":
                        <input class="ctrl-text narrow" type="text" value="@prop.ValueString"
                               @onchange="e => OnValueChanged(prop, e)" />
                        <span class="ctrl-hint">@prop.NumericMinimum.ToString(System.Globalization.CultureInfo.InvariantCulture)-@prop.NumericMaximum.ToString(System.Globalization.CultureInfo.InvariantCulture)</span>
                        break;

                    default:
                        <input class="ctrl-text" type="text" value="@prop.ValueString"
                               @onchange="e => OnValueChanged(prop, e)" />
                        break;
                }
            </div>
        </div>
    };

    private static readonly HashSet<string> _groupedNames = new(new[] {
        "ServerName", "ServerDescription", "Password", "ServerBrowserIP", "Port", "MaxPlayers",
        "TeamMode", "GameMode", "Relay", "AutoTeam", "LAN", "AllowSpectating",
        "UseTimedForceStart", "ForceStartTime", "MinPlayersToForceStart", "PlayersToStart", "Countdown",
        "NoRing", "BaseRingTime", "TimeBeforeFirstRing", "RingSizes", "RingSpeeds",
        "CarSpawnRate", "StripLootByPercentage", "WeaponDissapearTime", "AllowRespawnMinigame", "AntiCheat",
        "UseKicks", "AllowRejoins", "SpawnBots", "UsePlayFabStats", "DEBUG_DEATHMATCH"
    });

    private List<SettingPropertyVM> GetRemainingProps()
    {
        if (ViewModel == null) return new();
        return ViewModel.Properties.Where(p => p.IsVisible && !_groupedNames.Contains(p.Name)).ToList();
    }

    private void OnCheckChanged(SettingPropertyVM prop, ChangeEventArgs e)
    {
        if (e.Value is bool b)
            prop.BoolValue = b;
        else if (e.Value is string s && bool.TryParse(s, out var parsed))
            prop.BoolValue = parsed;
    }

    private void OnValueChanged(SettingPropertyVM prop, ChangeEventArgs e)
    {
        prop.ValueString = e.Value?.ToString() ?? "";
    }

    private bool HasComboItems(SettingPropertyVM prop)
    {
        var items = GetComboItems(prop);
        return items != null && items.Count > 0;
    }

    private List<string>? GetComboItems(SettingPropertyVM prop)
    {
        var items = prop.ComboBoxItems;
        if (items == null) return null;
        if (items is IEnumerable<string> strings)
            return strings.ToList();
        if (items is IEnumerable enumerable)
            return enumerable.Cast<object>().Select(o => o.ToString() ?? "").ToList();
        return null;
    }
}
