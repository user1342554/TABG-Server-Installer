<div style="flex: 1; display: grid; grid-template-columns: 220px 1fr; overflow: hidden;">
    <!-- Topic list -->
    <div style="border-right: 3px solid var(--fg); display: flex; flex-direction: column;">
        <div style="font-family: var(--display); font-weight: 700; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.15em; padding: 0.5rem 1.25rem; border-bottom: 2px solid var(--fg); background: rgba(0,0,0,0.02);">Topics</div>
        @for (int i = 0; i < _topics.Length; i++)
        {
            var idx = i;
            <div style="padding: 0.7rem 1.25rem; border-bottom: 1px solid var(--light-border); cursor: pointer; transition: all 0.12s; @(idx == _activeTopic ? "background: var(--fg); color: var(--bg);" : "")"
                 @onclick="() => SelectTopic(idx)">
                <div style="font-size: 0.82rem; font-weight: 500;">@_topics[idx].Name</div>
                <div style="font-size: 0.6rem; color: @(idx == _activeTopic ? "#999" : "var(--muted)"); margin-top: 0.1rem;">@_topics[idx].Desc</div>
            </div>
        }
    </div>

    <!-- Content -->
    <div style="overflow-y: auto; padding: 1.25rem 1.5rem; font-size: 0.78rem; line-height: 1.8; white-space: pre-wrap; font-family: var(--mono);">@_referenceText</div>
</div>

@code {
    private int _activeTopic = 0;

    private record TopicEntry(string Name, string Desc);

    private readonly TopicEntry[] _topics =
    {
        new("Commands", "Server chat commands"),
        new("Item IDs", "All weapons, items, grenades"),
        new("Loadout Presets", "Copy-paste loadout strings"),
        new("Spawn Locations", "Coordinates for all areas"),
        new("Match Settings", "Config file format guide"),
    };

    private string _referenceText = "";

    protected override void OnInitialized()
    {
        SelectTopic(0);
    }

    private void SelectTopic(int idx)
    {
        _activeTopic = idx;
        _referenceText = idx switch
        {
            0 => GetCommands(),
            1 => GetItems(),
            2 => GetLoadouts(),
            3 => GetSpawns(),
            4 => GetMatchSettings(),
            _ => ""
        };
    }

    private string GetCommands() => @"COMMANDS REFERENCE
==================

CITRUSLIB COMMANDS
------------------

/perm-get <player>          Gets permission status                    Perm: 1
/id <name>                  Gets Epic ID of a player                  Perm: 1
/get_pos <name>             Queries a player's position               Perm: 1
/start [time]               Starts the countdown timer                Perm: 1
/send <player> <player>     Teleports first player to second          Perm: 2
/send_pos <name> x y z      Teleports player to coordinates           Perm: 2
/goto_pos x y z             Teleports you to coordinates              Perm: 2
/bring <player>             Brings a player to you                    Perm: 2
/give [id] [amount]         Gives you an item                         Perm: 2
/goto <player>              Teleports you to a player                 Perm: 2
/perm-set <player>          Sets permission status (requires restart) Perm: 4

MOREMODS COMMANDS
-----------------

/dub                        Doubles inventory (KeepInventory)         Perm: 4
/dh                         Drops selected grenade on kill            Perm: 4
/adv                        Gives a kill, advances weapon             Perm: 4
/curse [player] <id>        Gives a curse to player                   Perm: 4
/cleanse [player] <id>      Removes a curse from player               Perm: 4
/ban [player]               Ban a player
/disconnect [player]        Kick from server (can rejoin)

TIPS
----
Type commands in chat by pressing Enter
Give yourself a higher perm level by pasting your EpicID from
the Guestbook into PlayerPerms.json";

