@inject AppState State
@implements IDisposable

<div style="display:flex; flex-direction:column; height:100%;">
    @if (!State.IsServerConfigured)
    {
        <div style="padding:2rem; text-align:center;">
            <span style="color:var(--muted); text-transform:uppercase; letter-spacing:0.1em; font-size:0.72rem;">
                Configure a server directory to edit loadouts.
            </span>
        </div>
    }
    else
    {
        <div style="flex:1; display:grid; grid-template-columns:240px 1fr 300px; overflow:hidden;">

            <!-- Col 1: Loadout List -->
            <div class="col">
                <div class="col-header">
                    Loadouts
                    <span class="col-meta">@_loadouts.Count total</span>
                </div>

                <!-- Mode Select -->
                <div style="padding:0.5rem 1.25rem; border-bottom:1px solid var(--light-border);">
                    <select class="ctrl-select" @bind="_selectedMode">
                        <option value="Normal">Normal</option>
                        <option value="GunGame">GunGame</option>
                        <option value="ReverseGunGame">ReverseGunGame</option>
                        <option value="KeepInventory">KeepInventory</option>
                    </select>
                </div>

                <!-- Scrollable loadout items -->
                <div class="col-body">
                    @for (int i = 0; i < _loadouts.Count; i++)
                    {
                        var idx = i;
                        var lo = _loadouts[idx];
                        <div style="padding:0.45rem 1.25rem; border-bottom:1px solid var(--light-border); cursor:pointer; font-size:0.78rem; transition:all 0.1s; background:@(_selectedIndex == idx ? "var(--fg)" : "transparent"); color:@(_selectedIndex == idx ? "var(--bg)" : "inherit");"
                             @onclick="() => SelectLoadout(idx)">
                            <div style="font-weight:500;">@lo.Name</div>
                            <div style="font-size:0.6rem; opacity:0.6;">@lo.Percent% &middot; @lo.Items.Count items</div>
                        </div>
                    }
                </div>

                <!-- Action buttons -->
                <div style="display:flex; flex-wrap:wrap; gap:0.25rem; padding:0.5rem 0.75rem; border-top:2px solid var(--fg); flex-shrink:0;">
                    <button style="font-family:var(--mono); font-size:0.55rem; text-transform:uppercase; letter-spacing:0.06em; padding:0.3rem 0.5rem; background:var(--fg); color:var(--bg); border:none; cursor:pointer; transition:all 0.1s;" @onclick="AddLoadout">Add</button>
                    <button style="font-family:var(--mono); font-size:0.55rem; text-transform:uppercase; letter-spacing:0.06em; padding:0.3rem 0.5rem; background:transparent; border:1px solid var(--light-border); color:var(--muted); cursor:pointer; transition:all 0.1s;" @onclick="DuplicateLoadout">Clone</button>
                    <button style="font-family:var(--mono); font-size:0.55rem; text-transform:uppercase; letter-spacing:0.06em; padding:0.3rem 0.5rem; background:transparent; border:1px solid var(--light-border); color:var(--muted); cursor:pointer; transition:all 0.1s;" @onclick="RemoveLoadout">Del</button>
                    <button style="font-family:var(--mono); font-size:0.55rem; text-transform:uppercase; letter-spacing:0.06em; padding:0.3rem 0.5rem; background:transparent; border:1px solid var(--light-border); color:var(--muted); cursor:pointer; transition:all 0.1s;" @onclick="MoveUp">Up</button>
                    <button style="font-family:var(--mono); font-size:0.55rem; text-transform:uppercase; letter-spacing:0.06em; padding:0.3rem 0.5rem; background:transparent; border:1px solid var(--light-border); color:var(--muted); cursor:pointer; transition:all 0.1s;" @onclick="MoveDown">Down</button>
                </div>
            </div>

            <!-- Col 2: Editor -->
            <div class="col">
                @if (SelectedLoadout != null)
                {
                    <div class="col-header">@SelectedLoadout.Name</div>
                    <div class="col-body">
                        <!-- Name and Weight fields -->
                        <div class="field">
                            <span class="field-name">Name</span>
                            <div class="field-input">
                                <input type="text" class="ctrl-text" value="@SelectedLoadout.Name"
                                       @oninput="OnNameChanged" />
                            </div>
                        </div>
                        <div class="field">
                            <span class="field-name">Weight</span>
                            <div class="field-input">
                                <input type="text" class="ctrl-text narrow" value="@_percentText"
                                       @oninput="OnPercentChanged" />
                                <span class="ctrl-hint">%</span>
                            </div>
                        </div>

                        <!-- Items Header Row -->
                        <div style="display:grid; grid-template-columns:1fr 50px 55px 40px; padding:0.4rem 1rem; border-top:2px solid var(--fg); border-bottom:1px solid var(--light-border); background:rgba(0,0,0,0.02);">
                            <span style="font-size:0.6rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--muted); font-weight:500;">Item</span>
                            <span style="font-size:0.6rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--muted); font-weight:500;">ID</span>
                            <span style="font-size:0.6rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--muted); font-weight:500;">Qty</span>
                            <span></span>
                        </div>

                        <!-- Scrollable item rows -->
                        <div style="overflow-y:auto; flex:1;">
                            @for (int i = 0; i < SelectedLoadout.Items.Count; i++)
                            {
                                var itemIdx = i;
                                var item = SelectedLoadout.Items[itemIdx];
                                <div style="display:grid; grid-template-columns:1fr 50px 55px 40px; padding:0.35rem 1rem; border-bottom:1px solid var(--light-border); align-items:center; font-size:0.78rem;">
                                    <span style="font-weight:500;">@ResolveItemName(item.Id)</span>
                                    <span style="color:var(--muted); font-size:0.7rem;">@item.Id</span>
                                    <input type="text" class="ctrl-text" style="width:40px; padding:0.15rem 0.3rem; font-size:0.72rem;" value="@item.Quantity"
                                           @onchange="e => OnItemQtyChanged(itemIdx, e)" />
                                    <button style="font-size:0.5rem; text-transform:uppercase; padding:0.15rem 0.3rem; background:transparent; border:1px solid var(--light-border); color:var(--muted); cursor:pointer;"
                                            @onclick="() => RemoveItem(itemIdx)">Del</button>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-header" style="color:var(--muted);">No Loadout Selected</div>
                    <div class="col-body" style="display:flex; align-items:center; justify-content:center;">
                        <span style="color:var(--muted); font-size:0.75rem;">Select a loadout to edit.</span>
                    </div>
                }
            </div>

            <!-- Col 3: Add Item + Modifiers -->
            <div class="col" style="border-right:none;">
                <div class="col-header">Add Item</div>
                <div style="flex:1; overflow-y:auto;">
                    <!-- Search Input -->
                    <div class="block">
                        <div class="block-label">Search</div>
                        <input type="text" class="ctrl-text" value="@_searchText"
                               @oninput="OnSearchChanged"
                               placeholder="Type to search items..." />
                    </div>

                    @if (!string.IsNullOrEmpty(_searchText))
                    {
                        <div style="max-height:120px; overflow-y:auto; border-bottom:1px solid var(--light-border);">
                            @if (_searchResults.Count == 0)
                            {
                                <div style="padding:0.5rem 1.25rem; color:var(--muted); font-size:0.72rem;">(no matches)</div>
                            }
                            else
                            {
                                @for (int i = 0; i < _searchResults.Count; i++)
                                {
                                    var srIdx = i;
                                    var sr = _searchResults[srIdx];
                                    <div style="padding:0.35rem 1.25rem; font-size:0.72rem; cursor:pointer; border-bottom:1px solid var(--light-border); transition:all 0.1s; background:@(_selectedSearchIndex == srIdx ? "var(--fg)" : "transparent"); color:@(_selectedSearchIndex == srIdx ? "var(--bg)" : "inherit");"
                                         @onclick="() => _selectedSearchIndex = srIdx"
                                         @ondblclick="() => AddFromSearch(srIdx)">
                                        @sr.DisplayText
                                    </div>
                                }
                            }
                        </div>
                    }

                    @if (string.IsNullOrEmpty(_searchText))
                    {
                        <!-- Category Browse -->
                        <div class="block">
                            <div class="block-label">Category</div>
                            <select class="ctrl-select" value="@_selectedCategory"
                                    @onchange="OnCategoryChanged">
                                @foreach (var cat in ItemDatabase.Categories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="block">
                            <div class="block-label">Item</div>
                            <select class="ctrl-select" @bind="_selectedItemDisplay">
                                @foreach (var item in _categoryItems)
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </div>
                    }

                    <!-- Qty + Add Row -->
                    <div class="block">
                        <div class="block-row">
                            <span style="font-size:0.6rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--muted);">Qty</span>
                            <input type="text" class="ctrl-text narrow" style="width:50px;" @bind="_quantityText" />
                            <button class="bottom-btn" style="height:28px; font-size:0.58rem; padding:0 0.75rem; border-right:none;" @onclick="AddItem">Add</button>
                        </div>
                    </div>

                    <!-- Curses Section -->
                    @if (SelectedLoadout != null)
                    {
                        <div style="border-top:2px solid var(--fg);">
                            <div style="padding:0.5rem 1.25rem; font-size:0.6rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--muted); font-weight:500; border-bottom:1px solid var(--light-border); background:rgba(0,0,0,0.02);">
                                Curses
                            </div>
                            <div style="display:grid; grid-template-columns:1fr 1fr; padding:0.5rem 1rem; gap:0.25rem;">
                                @foreach (var curse in _curseEntries)
                                {
                                    var entry = curse;
                                    <div style="display:flex; align-items:center; gap:0.35rem;">
                                        <input type="checkbox" class="ctrl-checkbox" checked="@entry.IsChecked"
                                               @onchange="e => OnCurseToggled(entry, e)" />
                                        <span style="font-size:0.68rem;">@entry.DisplayText</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Blessings Section -->
                        <div style="border-top:2px solid var(--fg);">
                            <div style="padding:0.5rem 1.25rem; font-size:0.6rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--muted); font-weight:500; border-bottom:1px solid var(--light-border); background:rgba(0,0,0,0.02);">
                                Blessings
                            </div>
                            <div style="padding:0.25rem 1.25rem; font-size:0.55rem; color:var(--muted); border-bottom:1px solid var(--light-border);">
                                Added as items to this loadout
                            </div>
                            <div style="display:grid; grid-template-columns:1fr 1fr; padding:0.5rem 1rem; gap:0.25rem;">
                                @foreach (var blessing in _blessingEntries)
                                {
                                    var entry = blessing;
                                    <div style="display:flex; align-items:center; gap:0.35rem;">
                                        <input type="checkbox" class="ctrl-checkbox" checked="@entry.IsChecked"
                                               @onchange="e => OnBlessingToggled(entry, e)" />
                                        <span style="font-size:0.68rem;">@entry.DisplayText</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div class="bottom-bar">
            <button class="bottom-btn" @onclick="Save">Save</button>
            <button class="bottom-btn ghost" @onclick="ImportRaw">Import Raw</button>
            <button class="bottom-btn ghost" @onclick="ExportRaw">Export Raw</button>
            <span class="bottom-status">@_statusText</span>
        </div>
    }
</div>

<!-- Import Dialog -->
@if (_showImportDialog)
{
    <div class="dialog-overlay" @onclick="() => _showImportDialog = false">
        <div class="dialog-box" style="width:560px;" @onclick:stopPropagation>
            <div class="dialog-title">Import Raw Loadouts</div>
            <div class="dialog-message" style="margin-bottom:0.5rem;">Paste the raw loadout string (including optional GunGame/ prefix):</div>
            <textarea class="ctrl-textarea" style="width:100%; height:180px; border:1.5px solid var(--light-border);" @bind="_importText"></textarea>
            <div class="dialog-buttons" style="margin-top:1rem;">
                <button @onclick="DoImport">Import</button>
                <button class="ghost" @onclick="() => _showImportDialog = false">Cancel</button>
            </div>
        </div>
    </div>
}

<!-- Export Dialog -->
@if (_showExportDialog)
{
    <div class="dialog-overlay" @onclick="() => _showExportDialog = false">
        <div class="dialog-box" style="width:560px;" @onclick:stopPropagation>
            <div class="dialog-title">Export Raw Loadouts</div>
            <div class="dialog-message" style="margin-bottom:0.5rem;">Raw loadout string (copy this):</div>
            <textarea class="ctrl-textarea" style="width:100%; height:180px; border:1.5px solid var(--light-border);" readonly>@_exportText</textarea>
            <div class="dialog-buttons" style="margin-top:1rem;">
                <button @onclick="() => _showExportDialog = false">Close</button>
            </div>
        </div>
    </div>
}

<!-- Confirm Remove Dialog -->
<ConfirmDialog @ref="_confirmDialog" />

@code {
    // ── Services ──
    private readonly StarterPackLoadoutService _loadoutSvc = new();

    // ── State ──
    private List<LoadoutVm> _loadouts = new();
    private int _selectedIndex = -1;
    private string _selectedMode = "Normal";
    private FreddoCommissionSettings? _commissionSettings;

    private string _statusText = "";
    private string _statusCss = "";
    private bool _dirty;

    // Editor fields for the selected loadout
    private string _percentText = "";

    // Search
    private string _searchText = "";
    private List<SearchResult> _searchResults = new();
    private int _selectedSearchIndex = -1;

    // Category/Item dropdowns
    private string _selectedCategory = "";
    private List<string> _categoryItems = new();
    private string _selectedItemDisplay = "";
    private string _quantityText = "1";

    // Curse/Blessing entries for the selected loadout
    private List<CurseEntry> _curseEntries = new();
    private List<BlessingEntry> _blessingEntries = new();

    // Dialogs
    private bool _showImportDialog;
    private string _importText = "";
    private bool _showExportDialog;
    private string _exportText = "";
    private ConfirmDialog _confirmDialog = default!;

    private LoadoutVm? SelectedLoadout =>
        _selectedIndex >= 0 && _selectedIndex < _loadouts.Count ? _loadouts[_selectedIndex] : null;

    // ── Lifecycle ──

    protected override void OnInitialized()
    {
        State.OnServerConfigured += OnServerConfigured;
        if (State.IsServerConfigured)
            LoadAll();

        // Initialize category
        if (ItemDatabase.Categories.Count > 0)
        {
            _selectedCategory = ItemDatabase.Categories[0];
            RefreshCategoryItems();
        }
    }

    private void OnServerConfigured()
    {
        InvokeAsync(() =>
        {
            LoadAll();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        State.OnServerConfigured -= OnServerConfigured;
    }

    // ── Loading ──

    private void LoadAll()
    {
        try
        {
            var settings = StarterPackConfigService.Read(State.ServerDir);
            _selectedMode = settings.GetLoadoutMode();

            var rawLoadouts = settings.GetLoadoutsWithoutPrefix();
            var parsed = _loadoutSvc.ParseLoadoutsValue(rawLoadouts);

            _commissionSettings = ModConfigService.ReadCommission(State.ServerDir);
            var perLoadoutCurses = ParseLoadoutCurses(_commissionSettings.LoadoutCurses);

            _loadouts.Clear();
            for (int i = 0; i < parsed.Count; i++)
            {
                var lo = parsed[i];
                var curses = i < perLoadoutCurses.Count ? perLoadoutCurses[i] : new HashSet<int>();
                _loadouts.Add(new LoadoutVm(lo.Name, lo.Percent, lo.Items, curses));
            }

            if (_loadouts.Count > 0)
                SelectLoadout(0);
            else
                _selectedIndex = -1;

            _dirty = false;
            _statusText = $"Loaded {_loadouts.Count} loadouts.";
            _statusCss = "";
        }
        catch (Exception ex)
        {
            _statusText = $"Load error: {ex.Message}";
            _statusCss = "error";
        }
    }

    // ── Loadout Curse Parsing ──

    private static List<HashSet<int>> ParseLoadoutCurses(string raw)
    {
        var result = new List<HashSet<int>>();
        if (string.IsNullOrWhiteSpace(raw)) return result;

        var groups = raw.Split('/', StringSplitOptions.None);
        foreach (var group in groups)
        {
            var set = new HashSet<int>();
            if (!string.IsNullOrWhiteSpace(group))
            {
                foreach (var tok in group.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    if (int.TryParse(tok, out var id))
                        set.Add(id);
                }
            }
            result.Add(set);
        }
        return result;
    }

    private string BuildLoadoutCurses()
    {
        var parts = new List<string>();
        foreach (var lo in _loadouts)
        {
            if (lo.Curses.Count > 0)
                parts.Add(string.Join(",", lo.Curses.OrderBy(c => c)));
            else
                parts.Add("");
        }

        // Trim trailing empty groups
        while (parts.Count > 0 && string.IsNullOrEmpty(parts[^1]))
            parts.RemoveAt(parts.Count - 1);

        return string.Join("/", parts);
    }

    // ── Selection ──

    private void SelectLoadout(int index)
    {
        _selectedIndex = index;
        var lo = SelectedLoadout;
        if (lo != null)
        {
            _percentText = lo.Percent.ToString();
            RefreshCurseCheckboxes(lo);
            RefreshBlessingCheckboxes(lo);
        }
        else
        {
            _curseEntries.Clear();
            _blessingEntries.Clear();
        }
    }

    // ── Name / Percent Changed ──

    private void OnNameChanged(ChangeEventArgs e)
    {
        if (SelectedLoadout == null) return;
        SelectedLoadout.Name = e.Value?.ToString() ?? "";
        MarkDirty();
    }

    private void OnPercentChanged(ChangeEventArgs e)
    {
        if (SelectedLoadout == null) return;
        _percentText = e.Value?.ToString() ?? "";
        if (int.TryParse(_percentText, out var pct))
        {
            SelectedLoadout.Percent = pct;
            MarkDirty();
        }
    }

    // ── Item Quantity Changed ──

    private void OnItemQtyChanged(int itemIndex, ChangeEventArgs e)
    {
        if (SelectedLoadout == null) return;
        if (itemIndex < 0 || itemIndex >= SelectedLoadout.Items.Count) return;
        if (int.TryParse(e.Value?.ToString(), out var qty) && qty >= 1 && qty <= 255)
        {
            SelectedLoadout.Items[itemIndex].Quantity = qty;
            MarkDirty();
        }
    }

    // ── Loadout List Management ──

    private void AddLoadout()
    {
        var lo = new LoadoutVm("New Loadout", 100, new List<StarterPackLoadoutService.Item>(), new HashSet<int>());
        _loadouts.Add(lo);
        SelectLoadout(_loadouts.Count - 1);
        MarkDirty();
    }

    private void DuplicateLoadout()
    {
        if (SelectedLoadout == null) return;

        var source = SelectedLoadout;
        var clonedItems = source.Items.Select(it =>
            new StarterPackLoadoutService.Item(it.Id, it.Quantity)).ToList();
        var clonedCurses = new HashSet<int>(source.Curses);

        var clone = new LoadoutVm(
            source.Name + " (Copy)",
            source.Percent,
            clonedItems,
            clonedCurses);

        var idx = _selectedIndex;
        _loadouts.Insert(idx + 1, clone);
        SelectLoadout(idx + 1);
        MarkDirty();
    }

    private async Task RemoveLoadout()
    {
        if (SelectedLoadout == null) return;

        var confirmed = await _confirmDialog.ShowAsync(
            "Confirm Remove",
            $"Remove loadout \"{SelectedLoadout.Name}\"?",
            ConfirmDialog.DialogMode.YesNo);

        if (!confirmed) return;

        var idx = _selectedIndex;
        _loadouts.RemoveAt(idx);
        if (_loadouts.Count > 0)
            SelectLoadout(Math.Min(idx, _loadouts.Count - 1));
        else
            _selectedIndex = -1;
        MarkDirty();
    }

    private void MoveUp()
    {
        if (_selectedIndex <= 0) return;
        var idx = _selectedIndex;
        var item = _loadouts[idx];
        _loadouts.RemoveAt(idx);
        _loadouts.Insert(idx - 1, item);
        SelectLoadout(idx - 1);
        MarkDirty();
    }

    private void MoveDown()
    {
        if (_selectedIndex < 0 || _selectedIndex >= _loadouts.Count - 1) return;
        var idx = _selectedIndex;
        var item = _loadouts[idx];
        _loadouts.RemoveAt(idx);
        _loadouts.Insert(idx + 1, item);
        SelectLoadout(idx + 1);
        MarkDirty();
    }

    // ── Search ──

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _selectedSearchIndex = -1;

        if (string.IsNullOrWhiteSpace(_searchText))
        {
            _searchResults.Clear();
            return;
        }

        var query = _searchText.Trim();
        _searchResults = ItemDatabase.AllItems
            .Where(item => item.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                        || item.Id.ToString() == query)
            .OrderBy(item => item.Category)
            .ThenBy(item => item.Name)
            .Take(30)
            .Select(item => new SearchResult(item.Id, $"{item.Name} ({item.Id}) [{item.Category}]"))
            .ToList();
    }

    private void AddFromSearch(int searchIndex)
    {
        if (SelectedLoadout == null) return;
        if (searchIndex < 0 || searchIndex >= _searchResults.Count) return;

        var sr = _searchResults[searchIndex];
        if (!int.TryParse(_quantityText, out var qty) || qty < 1) qty = 1;
        if (qty > 255) qty = 255;

        SelectedLoadout.Items.Add(new ItemVm(sr.ItemId.ToString(), qty));
        MarkDirty();

        // Clear search
        _searchText = "";
        _searchResults.Clear();
        _selectedSearchIndex = -1;
    }

    // ── Category / Item Dropdowns ──

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        _selectedCategory = e.Value?.ToString() ?? "";
        RefreshCategoryItems();
    }

    private void RefreshCategoryItems()
    {
        _categoryItems = ItemDatabase.ByCategory(_selectedCategory)
            .Select(item => $"{item.Name} ({item.Id})")
            .ToList();
        _selectedItemDisplay = _categoryItems.FirstOrDefault() ?? "";
    }

    private void AddItem()
    {
        if (SelectedLoadout == null) return;

        // If search results are visible and something is selected, add from search
        if (!string.IsNullOrEmpty(_searchText) && _selectedSearchIndex >= 0 && _selectedSearchIndex < _searchResults.Count)
        {
            AddFromSearch(_selectedSearchIndex);
            return;
        }

        // Otherwise add from category dropdown
        if (string.IsNullOrEmpty(_selectedItemDisplay)) return;

        var openParen = _selectedItemDisplay.LastIndexOf('(');
        var closeParen = _selectedItemDisplay.LastIndexOf(')');
        if (openParen < 0 || closeParen < 0) return;

        var id = _selectedItemDisplay.Substring(openParen + 1, closeParen - openParen - 1);

        if (!int.TryParse(_quantityText, out var qty) || qty < 1) qty = 1;
        if (qty > 255) qty = 255;

        SelectedLoadout.Items.Add(new ItemVm(id, qty));
        MarkDirty();
    }

    private void RemoveItem(int itemIndex)
    {
        if (SelectedLoadout == null) return;
        if (itemIndex < 0 || itemIndex >= SelectedLoadout.Items.Count) return;
        SelectedLoadout.Items.RemoveAt(itemIndex);
        MarkDirty();
    }

    // ── Curse Checkboxes ──

    private void RefreshCurseCheckboxes(LoadoutVm lo)
    {
        _curseEntries = ItemDatabase.Curses.Select(c => new CurseEntry
        {
            CurseId = c.Id,
            DisplayText = $"{c.Name} ({c.Id})",
            IsChecked = lo.Curses.Contains(c.Id)
        }).ToList();
    }

    private void OnCurseToggled(CurseEntry entry, ChangeEventArgs e)
    {
        if (SelectedLoadout == null) return;

        bool isChecked = false;
        if (e.Value is bool b) isChecked = b;
        else if (e.Value is string s && bool.TryParse(s, out var parsed)) isChecked = parsed;

        entry.IsChecked = isChecked;

        if (isChecked)
            SelectedLoadout.Curses.Add(entry.CurseId);
        else
            SelectedLoadout.Curses.Remove(entry.CurseId);

        MarkDirty();
    }

    // ── Blessing Checkboxes ──

    private void RefreshBlessingCheckboxes(LoadoutVm lo)
    {
        var blessingItems = ItemDatabase.ByCategory("Blessings").ToList();
        var existingItemIds = lo.Items.Select(it => it.Id).ToHashSet();

        _blessingEntries = blessingItems.Select(b => new BlessingEntry
        {
            ItemId = b.Id,
            DisplayText = $"{b.Name} ({b.Id})",
            IsChecked = existingItemIds.Contains(b.Id.ToString())
        }).ToList();
    }

    private void OnBlessingToggled(BlessingEntry entry, ChangeEventArgs e)
    {
        if (SelectedLoadout == null) return;

        bool isChecked = false;
        if (e.Value is bool b) isChecked = b;
        else if (e.Value is string s && bool.TryParse(s, out var parsed)) isChecked = parsed;

        entry.IsChecked = isChecked;

        var idStr = entry.ItemId.ToString();
        if (isChecked)
        {
            if (!SelectedLoadout.Items.Any(it => it.Id == idStr))
            {
                SelectedLoadout.Items.Add(new ItemVm(idStr, 1));
            }
        }
        else
        {
            var match = SelectedLoadout.Items.FirstOrDefault(it => it.Id == idStr);
            if (match != null)
                SelectedLoadout.Items.Remove(match);
        }

        MarkDirty();
    }

    // ── Import / Export ──

    private void ImportRaw()
    {
        _importText = "";
        _showImportDialog = true;
    }

    private void DoImport()
    {
        var raw = _importText.Trim();
        if (string.IsNullOrEmpty(raw))
        {
            _statusText = "No text entered.";
            _statusCss = "error";
            _showImportDialog = false;
            return;
        }

        // Detect mode prefix
        string mode = "Normal";
        string body = raw;
        if (raw.StartsWith("GunGame/")) { mode = "GunGame"; body = raw.Substring("GunGame/".Length); }
        else if (raw.StartsWith("ReverseGunGame/")) { mode = "ReverseGunGame"; body = raw.Substring("ReverseGunGame/".Length); }
        else if (raw.StartsWith("KeepInventory/")) { mode = "KeepInventory"; body = raw.Substring("KeepInventory/".Length); }

        _selectedMode = mode;
        var parsed = _loadoutSvc.ParseLoadoutsValue(body);
        _loadouts.Clear();
        foreach (var lo in parsed)
            _loadouts.Add(new LoadoutVm(lo.Name, lo.Percent, lo.Items, new HashSet<int>()));

        if (_loadouts.Count > 0)
            SelectLoadout(0);
        else
            _selectedIndex = -1;

        MarkDirty();
        _statusText = $"Imported {_loadouts.Count} loadouts.";
        _statusCss = "";
        _showImportDialog = false;
    }

    private void ExportRaw()
    {
        var records = _loadouts.Select(lo =>
            new StarterPackLoadoutService.Loadout(
                lo.Name,
                lo.Percent,
                lo.Items.Select(it => new StarterPackLoadoutService.Item(it.Id, it.Quantity)).ToList()
            )).ToList();

        var body = _loadoutSvc.BuildLoadoutsValue(records);
        _exportText = _selectedMode == "Normal" ? body : _selectedMode + "/" + body;
        _showExportDialog = true;
    }

    // ── Saving ──

    private void Save()
    {
        try
        {
            var settings = StarterPackConfigService.Read(State.ServerDir);

            // Build loadout records
            var records = _loadouts.Select(lo =>
                new StarterPackLoadoutService.Loadout(
                    lo.Name,
                    lo.Percent,
                    lo.Items.Select(it => new StarterPackLoadoutService.Item(it.Id, it.Quantity)).ToList()
                )).ToList();

            var loadoutsStr = _loadoutSvc.BuildLoadoutsValue(records);
            settings.SetLoadoutsWithPrefix(_selectedMode, loadoutsStr);
            StarterPackConfigService.Write(State.ServerDir, settings);

            // Save curses
            var commission = _commissionSettings ?? ModConfigService.ReadCommission(State.ServerDir);
            commission.LoadoutCurses = BuildLoadoutCurses();
            ModConfigService.WriteCommission(State.ServerDir, commission);

            _dirty = false;
            _statusText = "Saved successfully.";
            _statusCss = "success";
        }
        catch (Exception ex)
        {
            _statusText = $"Save error: {ex.Message}";
            _statusCss = "error";
        }
    }

    // ── Helpers ──

    private void MarkDirty()
    {
        if (!_dirty)
        {
            _dirty = true;
            _statusText = "Unsaved changes";
            _statusCss = "";
        }
    }

    private static string ResolveItemName(string id)
    {
        if (int.TryParse(id, out var numId))
        {
            var name = ItemDatabase.GetNameById(numId);
            if (name != null) return name;
        }
        return $"(#{id})";
    }

    // ── View Models (local) ──

    private class LoadoutVm
    {
        public string Name { get; set; }
        public int Percent { get; set; }
        public List<ItemVm> Items { get; }
        public HashSet<int> Curses { get; }

        public string DisplayName
        {
            get
            {
                var itemCount = Items.Count;
                return $"{Name} ({Percent}%) - {itemCount} item{(itemCount != 1 ? "s" : "")}";
            }
        }

        public LoadoutVm(string name, int percent, List<StarterPackLoadoutService.Item> items, HashSet<int> curses)
        {
            Name = name;
            Percent = percent;
            Items = items.Select(it => new ItemVm(it.Id, it.Quantity)).ToList();
            Curses = curses;
        }
    }

    private class ItemVm
    {
        public string Id { get; set; }
        public int Quantity { get; set; }

        public ItemVm(string id, int quantity)
        {
            Id = id;
            Quantity = quantity;
        }
    }

    private record SearchResult(int ItemId, string DisplayText);

    private class CurseEntry
    {
        public int CurseId { get; set; }
        public string DisplayText { get; set; } = "";
        public bool IsChecked { get; set; }
    }

    private class BlessingEntry
    {
        public int ItemId { get; set; }
        public string DisplayText { get; set; } = "";
        public bool IsChecked { get; set; }
    }
}
