@inject AppState State
@implements IDisposable

<div style="display:flex; flex-direction:column; height:100%;">
    @if (!State.IsServerConfigured)
    {
        <div style="padding:2rem; text-align:center;">
            <span style="color:var(--muted); text-transform:uppercase; letter-spacing:0.1em; font-size:0.72rem;">
                Configure a server directory to manage plugins.
            </span>
        </div>
    }
    else
    {
        <div style="flex:1; display:grid; grid-template-columns:1fr 220px; overflow:hidden;">

            <!-- Left: Plugin List -->
            <div class="col">
                <div class="col-header">
                    Plugins
                    <span class="col-meta">BepInEx/plugins</span>
                </div>
                <div class="col-body">
                    @foreach (var plugin in _plugins)
                    {
                        <div class="plugin-row" style="display:flex; align-items:center; gap:0.75rem; padding:0.45rem 1.25rem; border-bottom:1px solid var(--light-border); transition:all 0.1s;"
                             onmouseover="this.style.background='rgba(0,0,0,0.03)'"
                             onmouseout="this.style.background='transparent'">
                            <input type="checkbox" class="ctrl-checkbox plugin-toggle"
                                   checked="@plugin.IsEnabled"
                                   @onchange="e => TogglePlugin(plugin, (bool)(e.Value ?? false))" />
                            <span class="plugin-name" style="flex:1; font-size:0.82rem; opacity:@(plugin.IsEnabled ? "1" : "0.5");">@plugin.Name</span>
                            <button style="font-size:0.55rem; text-transform:uppercase; letter-spacing:0.08em; padding:0.2rem 0.5rem; background:transparent; border:1px solid var(--light-border); color:var(--muted); cursor:pointer; transition:all 0.1s;"
                                    @onclick="() => { _selectedPlugin = plugin; RemovePlugin(); }">Del</button>
                        </div>
                    }
                    @if (_plugins.Count == 0)
                    {
                        <div style="padding:2rem; text-align:center; color:var(--muted); font-size:0.75rem;">No plugins installed</div>
                    }
                </div>
            </div>

            <!-- Right: Actions Sidebar -->
            <div style="display:flex; flex-direction:column; padding:1.25rem; gap:0.5rem;">
                <button class="btn-primary" style="font-size:0.75rem; padding:0.8rem 1rem; letter-spacing:0.1em;" @onclick="AddPlugin">Add Plugin</button>
                <button class="btn-secondary" style="font-size:0.65rem; padding:0.6rem 1rem;" @onclick="OpenPluginsFolder">Open Folder</button>

                <div style="flex:1;"></div>

                <!-- Stats -->
                <div style="border-top:1px solid var(--light-border); padding-top:1rem;">
                    <div style="margin-bottom:0.75rem; text-align:center;">
                        <div style="font-family:var(--display); font-weight:800; font-size:1.5rem; line-height:1;">@(_plugins.Count(p => p.IsEnabled))</div>
                        <div style="font-size:0.5rem; text-transform:uppercase; letter-spacing:0.18em; color:var(--muted); margin-top:0.3rem;">Active</div>
                    </div>
                    <div style="text-align:center;">
                        <div style="font-family:var(--display); font-weight:800; font-size:1.5rem; line-height:1; color:var(--muted);">@(_plugins.Count(p => !p.IsEnabled))</div>
                        <div style="font-size:0.5rem; text-transform:uppercase; letter-spacing:0.18em; color:var(--muted); margin-top:0.3rem;">Disabled</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_statusText))
                {
                    <div style="font-size:0.6rem; color:var(--muted); text-align:center; margin-top:0.5rem;">@_statusText</div>
                }
            </div>
        </div>
    }
</div>

<ConfirmDialog @ref="_dialog" />

@code {
    private ConfirmDialog _dialog = null!;
    private List<PluginEntry> _plugins = new();
    private PluginEntry? _selectedPlugin;
    private string _statusText = "";
    private string _statusCss = "";

    protected override void OnInitialized()
    {
        State.OnServerConfigured += OnServerConfigured;
        if (State.IsServerConfigured)
            LoadPluginsList();
    }

    private void OnServerConfigured()
    {
        InvokeAsync(() =>
        {
            LoadPluginsList();
            StateHasChanged();
        });
    }

    private string PluginsDir => State.PluginsDir;
    private string DisabledDir => System.IO.Path.Combine(PluginsDir, "disabled");

    private void LoadPluginsList()
    {
        _plugins.Clear();
        _selectedPlugin = null;

        try
        {
            if (!System.IO.Directory.Exists(PluginsDir))
            {
                System.IO.Directory.CreateDirectory(PluginsDir);
            }

            foreach (var dll in System.IO.Directory.GetFiles(PluginsDir, "*.dll"))
            {
                _plugins.Add(new PluginEntry { Name = System.IO.Path.GetFileName(dll), IsEnabled = true });
            }

            if (System.IO.Directory.Exists(DisabledDir))
            {
                foreach (var dll in System.IO.Directory.GetFiles(DisabledDir, "*.dll"))
                {
                    _plugins.Add(new PluginEntry { Name = System.IO.Path.GetFileName(dll), IsEnabled = false });
                }
            }

            _statusText = $"Loaded {_plugins.Count} plugin(s)";
            _statusCss = "";
        }
        catch (Exception ex)
        {
            _statusText = $"Error loading plugins: {ex.Message}";
            _statusCss = "error";
        }
    }

    private void TogglePlugin(PluginEntry plugin, bool newEnabled)
    {
        // Determine source and destination based on current state (before toggle)
        var src = plugin.IsEnabled
            ? System.IO.Path.Combine(PluginsDir, plugin.Name)
            : System.IO.Path.Combine(DisabledDir, plugin.Name);
        var dst = plugin.IsEnabled
            ? System.IO.Path.Combine(DisabledDir, plugin.Name)
            : System.IO.Path.Combine(PluginsDir, plugin.Name);

        try
        {
            if (!plugin.IsEnabled)
            {
                // Moving from disabled to enabled - source is disabled dir, no need to create disabled dir
            }
            else
            {
                // Moving from enabled to disabled - ensure disabled dir exists
                if (!System.IO.Directory.Exists(DisabledDir))
                    System.IO.Directory.CreateDirectory(DisabledDir);
            }

            if (System.IO.File.Exists(src))
            {
                if (System.IO.File.Exists(dst))
                    System.IO.File.Delete(dst);
                System.IO.File.Move(src, dst);
            }

            plugin.IsEnabled = newEnabled;
            _statusText = $"{plugin.Name} {(newEnabled ? "enabled" : "disabled")}";
            _statusCss = "";
        }
        catch (Exception ex)
        {
            _statusText = $"Failed to toggle plugin: {ex.Message}";
            _statusCss = "error";
        }
    }

    private void AddPlugin()
    {
        var dialog = new Microsoft.Win32.OpenFileDialog
        {
            Filter = "DLL files (*.dll)|*.dll",
            Title = "Select plugin DLL"
        };

        if (dialog.ShowDialog() == true)
        {
            try
            {
                if (!System.IO.Directory.Exists(PluginsDir))
                    System.IO.Directory.CreateDirectory(PluginsDir);

                var dst = System.IO.Path.Combine(PluginsDir, System.IO.Path.GetFileName(dialog.FileName));
                System.IO.File.Copy(dialog.FileName, dst, true);
                LoadPluginsList();
                _statusText = $"Added {System.IO.Path.GetFileName(dialog.FileName)}";
                _statusCss = "success";
            }
            catch (Exception ex)
            {
                _statusText = $"Failed to add plugin: {ex.Message}";
                _statusCss = "error";
            }
        }
    }

    private async Task RemovePlugin()
    {
        if (_selectedPlugin == null)
        {
            _statusText = "No plugin selected";
            _statusCss = "";
            return;
        }

        var confirmed = await _dialog.ShowAsync(
            "Confirm",
            $"Remove {_selectedPlugin.Name}?",
            ConfirmDialog.DialogMode.YesNo);

        if (!confirmed) return;

        try
        {
            var path = _selectedPlugin.IsEnabled
                ? System.IO.Path.Combine(PluginsDir, _selectedPlugin.Name)
                : System.IO.Path.Combine(DisabledDir, _selectedPlugin.Name);

            if (System.IO.File.Exists(path))
            {
                System.IO.File.Delete(path);
                var removedName = _selectedPlugin.Name;
                LoadPluginsList();
                _statusText = $"Removed {removedName}";
                _statusCss = "";
            }
        }
        catch (Exception ex)
        {
            _statusText = $"Failed to remove plugin: {ex.Message}";
            _statusCss = "error";
        }
    }

    private void OpenPluginsFolder()
    {
        try
        {
            if (!System.IO.Directory.Exists(PluginsDir))
                System.IO.Directory.CreateDirectory(PluginsDir);

            System.Diagnostics.Process.Start("explorer", PluginsDir);
        }
        catch (Exception ex)
        {
            _statusText = $"Failed to open folder: {ex.Message}";
            _statusCss = "error";
        }
    }

    public void Dispose()
    {
        State.OnServerConfigured -= OnServerConfigured;
    }

    private class PluginEntry
    {
        public string Name { get; set; } = "";
        public bool IsEnabled { get; set; }
    }
}
