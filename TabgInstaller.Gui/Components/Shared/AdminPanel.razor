@inject AppState State
@implements IDisposable

<div style="display:flex; flex-direction:column; height:100%;">
    @if (!State.IsServerConfigured)
    {
        <div style="padding:2rem; text-align:center;">
            <span style="color:var(--muted); text-transform:uppercase; letter-spacing:0.1em; font-size:0.72rem;">
                Configure a server directory to manage admins.
            </span>
        </div>
    }
    else
    {
        <!-- Add Admin Bar -->
        <div style="display:flex; align-items:center; gap:0.5rem; padding:0.6rem 1.25rem; border-bottom:2px solid var(--fg); background:rgba(0,0,0,0.02); flex-shrink:0;">
            <span style="font-size:0.6rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--muted); margin-right:0.25rem;">Name</span>
            <input type="text" class="ctrl-text" style="width:140px; flex:none;" @bind="_newName" />
            <span style="font-size:0.6rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--muted); margin-right:0.25rem;">Epic ID</span>
            <input type="text" class="ctrl-text" style="flex:1;" @bind="_newEpicId" />
            <span style="font-size:0.6rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--muted); margin-right:0.25rem;">Level</span>
            <select class="ctrl-select" style="width:60px; flex:none;" @bind="_newPermLevel">
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
            </select>
            <button class="bottom-btn" style="height:30px; font-size:0.62rem; padding:0 1rem;" @onclick="AddAdmin">Add Admin</button>
        </div>

        <!-- Admin Table -->
        <div style="flex:1; overflow-y:auto;">
            <!-- Table Header -->
            <div style="display:grid; grid-template-columns:160px 1fr 80px 80px; border-bottom:2px solid var(--fg); background:rgba(0,0,0,0.02);">
                <div style="padding:0.5rem 1.25rem; font-size:0.6rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--muted); font-weight:500;">Name</div>
                <div style="padding:0.5rem 1.25rem; font-size:0.6rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--muted); font-weight:500;">Epic ID</div>
                <div style="padding:0.5rem 1.25rem; font-size:0.6rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--muted); font-weight:500;">Level</div>
                <div style="padding:0.5rem 1.25rem;"></div>
            </div>

            <!-- Admin Rows -->
            @foreach (var admin in _admins)
            {
                <div style="display:grid; grid-template-columns:160px 1fr 80px 80px; border-bottom:1px solid var(--light-border); cursor:pointer; transition:all 0.1s;"
                     class="@(admin == _selectedAdmin ? "plugin-item" : "")"
                     @onclick="() => _selectedAdmin = admin">
                    <div style="padding:0.45rem 1.25rem; font-size:0.82rem; font-weight:500;">@admin.Name</div>
                    <div style="padding:0.45rem 1.25rem; font-size:0.78rem; color:var(--muted);">@admin.EpicId</div>
                    <div style="padding:0.45rem 1.25rem; font-size:0.82rem;">@admin.PermLevel</div>
                    <div style="padding:0.35rem 1.25rem;">
                        <button class="bottom-btn ghost" style="height:24px; font-size:0.55rem; padding:0 0.6rem; border:1px solid var(--light-border);" @onclick="() => { _selectedAdmin = admin; RemoveAdmin(); }">Remove</button>
                    </div>
                </div>
            }

            @if (_admins.Count == 0)
            {
                <div style="padding:2rem; text-align:center; color:var(--muted); font-size:0.75rem;">No admins configured</div>
            }
        </div>

        <!-- Help text -->
        <div style="padding:0.5rem 1.25rem; border-top:1px solid var(--light-border); font-size:0.6rem; color:var(--muted); line-height:1.6; flex-shrink:0;">
            How to find your Epic ID: Open TABG, join a server with Citruslib, and check the Guestbook log file
            in the server folder. Your Epic ID will be listed next to your player name.
            Alternatively, an admin can use /id &lt;yourname&gt; in the server chat.
        </div>

        <!-- Bottom bar -->
        <div class="bottom-bar">
            <button class="bottom-btn" @onclick="Save">Save</button>
            <span class="bottom-status">@_statusText</span>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private ConfirmDialog? Dialog { get; set; }

    private List<AdminEntry> _admins = new();
    private AdminEntry? _selectedAdmin;

    private string _newName = "";
    private string _newEpicId = "";
    private int _newPermLevel = 4;

    private string _statusText = "";
    private string _statusCss = "";

    protected override void OnInitialized()
    {
        State.OnServerConfigured += OnServerConfigured;
        if (State.IsServerConfigured)
            LoadAdmins();
    }

    private void OnServerConfigured()
    {
        InvokeAsync(() =>
        {
            LoadAdmins();
            StateHasChanged();
        });
    }

    private string GetPermsPath() =>
        System.IO.Path.Combine(State.ServerDir, "BepInEx", "config", "CitrusLib", "PlayerPerms.json");

    private string GetExtraSettingsPath() =>
        System.IO.Path.Combine(State.ServerDir, "BepInEx", "config", "CitrusLib", "ExtraSettings.json");

    private void LoadAdmins()
    {
        _admins.Clear();
        _selectedAdmin = null;

        try
        {
            var permsPath = GetPermsPath();
            var extraPath = GetExtraSettingsPath();

            var epicIds = ConfigIO.ReadPlayerPerms(permsPath);
            var extra = ConfigIO.ReadExtraSettings(extraPath);

            foreach (var epicId in epicIds)
            {
                extra.TryGetValue($"admin_name_{epicId}", out var name);
                extra.TryGetValue($"admin_perm_{epicId}", out var permStr);
                int.TryParse(permStr, out var perm);
                if (perm < 1 || perm > 5) perm = 4;

                _admins.Add(new AdminEntry
                {
                    Name = name ?? "",
                    EpicId = epicId,
                    PermLevel = perm
                });
            }

            _statusText = $"Loaded {_admins.Count} admin(s)";
            _statusCss = "";
        }
        catch (Exception ex)
        {
            _statusText = $"Error loading: {ex.Message}";
            _statusCss = "error";
        }
    }

    private async Task AddAdmin()
    {
        var name = _newName.Trim();
        var epicId = _newEpicId.Trim();

        if (string.IsNullOrEmpty(name) || string.IsNullOrEmpty(epicId))
        {
            if (Dialog != null)
                await Dialog.ShowAsync("Missing Info", "Please enter both a name and an Epic ID.");
            else
            {
                _statusText = "Please enter both a name and an Epic ID.";
                _statusCss = "error";
            }
            return;
        }

        _admins.Add(new AdminEntry { Name = name, EpicId = epicId, PermLevel = _newPermLevel });
        _newName = "";
        _newEpicId = "";
        _statusText = $"Added {name}";
        _statusCss = "";
    }

    private async Task RemoveAdmin()
    {
        if (_selectedAdmin == null) return;

        if (Dialog != null)
        {
            var confirmed = await Dialog.ShowAsync(
                "Confirm Remove",
                $"Remove admin \"{_selectedAdmin.Name}\"?",
                ConfirmDialog.DialogMode.YesNo);
            if (!confirmed) return;
        }

        var removed = _selectedAdmin;
        _admins.Remove(_selectedAdmin);
        _selectedAdmin = null;
        _statusText = $"Removed {removed.Name}";
        _statusCss = "";
    }

    private void Save()
    {
        try
        {
            var permsPath = GetPermsPath();
            var extraPath = GetExtraSettingsPath();

            // Build the Epic ID list for PlayerPerms.json
            var epicIds = _admins.Select(a => a.EpicId).ToList();

            // Build the extra settings dict preserving non-admin keys
            var extra = ConfigIO.ReadExtraSettings(extraPath);

            // Remove old admin_name_ and admin_perm_ keys
            var keysToRemove = extra.Keys
                .Where(k => k.StartsWith("admin_name_") || k.StartsWith("admin_perm_"))
                .ToList();
            foreach (var key in keysToRemove)
                extra.Remove(key);

            // Add current admin entries
            foreach (var admin in _admins)
            {
                extra[$"admin_name_{admin.EpicId}"] = admin.Name;
                extra[$"admin_perm_{admin.EpicId}"] = admin.PermLevel.ToString();
            }

            // Ensure directories exist
            var permsDir = System.IO.Path.GetDirectoryName(permsPath);
            if (!string.IsNullOrEmpty(permsDir))
                System.IO.Directory.CreateDirectory(permsDir);

            ConfigIO.WritePlayerPerms(epicIds, permsPath);
            ConfigIO.WriteExtraSettings(extra, extraPath);

            _statusText = $"Saved {_admins.Count} admin(s)";
            _statusCss = "success";
        }
        catch (Exception ex)
        {
            _statusText = $"Error saving: {ex.Message}";
            _statusCss = "error";
        }
    }

    public void Dispose()
    {
        State.OnServerConfigured -= OnServerConfigured;
    }

    private class AdminEntry
    {
        public string Name { get; set; } = "";
        public string EpicId { get; set; } = "";
        public int PermLevel { get; set; } = 4;
    }
}
