<Window x:Class="TabgInstaller.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:TabgInstaller.Gui.Tabs"
        xmlns:controls="clr-namespace:TabgInstaller.Gui.Controls"
        xmlns:res="clr-namespace:TabgInstaller.Gui.Resources"
        Title="{x:Static res:Strings.AppTitle}" Height="800" Width="1200"
        Icon="pack://application:,,,/Assets/tabg-mod-manager-icon-256.png">

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <controls:ServerListControl x:Name="ServerListSidebar" Grid.Column="0"
                                    AutomationProperties.AutomationId="ServerListSidebar"/>

        <!-- Content area -->
        <Grid Grid.Column="1">
            <TabControl x:Name="MainTabs"
                        AutomationProperties.AutomationId="MainTabControl"
                        AutomationProperties.Name="Main navigation"
                        TabIndex="1">
                <TabItem Header="{x:Static res:Strings.TabDashboard}"
                         AutomationProperties.AutomationId="DashboardTabItem">
                    <tabs:DashboardPanel x:Name="DashboardTab"/>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.TabServerMods}"
                         AutomationProperties.AutomationId="ServerModsTabItem">
                    <tabs:ServerModsPanel x:Name="ServerModsTab"/>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.TabClientMods}"
                         AutomationProperties.AutomationId="ClientModsTabItem">
                    <tabs:ClientPanel x:Name="ClientModsTab"/>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.TabConfig}"
                         AutomationProperties.AutomationId="ConfigTabItem">
                    <tabs:ConfigPanel x:Name="ConfigTab"/>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.TabConsole}"
                         AutomationProperties.AutomationId="ConsoleTabItem">
                    <tabs:ConsolePanel x:Name="ConsoleTab"/>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.TabBackups}" x:Name="BackupsTabItem"
                         AutomationProperties.AutomationId="BackupsTabItem">
                    <tabs:BackupsPanel x:Name="BackupsTab"/>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.TabReference}"
                         AutomationProperties.AutomationId="ReferenceTabItem">
                    <tabs:ReferencePanel x:Name="ReferenceTab"/>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.TabBrowsePlugins}"
                         AutomationProperties.AutomationId="BrowsePluginsTabItem">
                    <tabs:BrowsePluginsPanel x:Name="BrowsePluginsTab"/>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.TabSettings}"
                         AutomationProperties.AutomationId="SettingsTabItem">
                    <tabs:SettingsPanel x:Name="SettingsTab"/>
                </TabItem>
            </TabControl>

            <!-- Toast notification overlay -->
            <controls:ToastNotification x:Name="ToastControl" VerticalAlignment="Top" Panel.ZIndex="100"/>
        </Grid>
    </Grid>
</Window>
