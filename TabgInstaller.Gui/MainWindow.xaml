<Window x:Class="TabgInstaller.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:layout="clr-namespace:TabgInstaller.Gui.Components.Layout"
        Title="TABG Manager" Height="800" Width="1200"
        Icon="pack://application:,,,/Assets/tabg-mod-manager-icon-256.png">

    <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot/index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type layout:MainLayout}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
