<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ConsoleBgBrush" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="ConsoleBorderBrush" Color="{x:Static SystemColors.ActiveBorderColor}"/>
    <SolidColorBrush x:Key="ConsoleFgBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="StatusRunningBrush" Color="Lime"/>
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="Red"/>
    <SolidColorBrush x:Key="ToastBgBrush" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="ToastFgBrush" Color="{x:Static SystemColors.HighlightTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{x:Static SystemColors.GrayTextColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="LightTextBrush" Color="{x:Static SystemColors.HighlightTextColor}"/>
    <SolidColorBrush x:Key="DefaultBorderBrush" Color="{x:Static SystemColors.ActiveBorderColor}"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="AltPanelBgBrush" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="HealthCardBgBrush" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="HealthCardBorderBrush" Color="{x:Static SystemColors.ActiveBorderColor}"/>
    <SolidColorBrush x:Key="SigmaBgBrush" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="LogInfoBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="LogWarningBrush" Color="Yellow"/>
    <SolidColorBrush x:Key="LogErrorBrush" Color="Red"/>
</ResourceDictionary>
