<UserControl x:Class="TabgInstaller.Gui.Controls.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources"
             HorizontalAlignment="Stretch" VerticalAlignment="Top"
             Visibility="Collapsed" x:Name="ToastRoot"
             AutomationProperties.LiveSetting="Assertive"
             AutomationProperties.AutomationId="ToastNotificationControl">
    <Border x:Name="ToastBorder" Margin="20,10" Padding="12,8" CornerRadius="4"
            Background="{DynamicResource ToastBgBrush}" HorizontalAlignment="Center" MinWidth="300">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" Opacity="0.3" ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtIcon" Grid.Column="0" FontSize="16" Margin="0,0,8,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource ToastFgBrush}"/>
            <TextBlock x:Name="TxtMessage" Grid.Column="1" Foreground="{DynamicResource ToastFgBrush}"
                       FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="BtnDismiss" Grid.Column="2" Content="{x:Static res:Strings.Close}" Margin="8,0,0,0"
                    Background="Transparent" Foreground="#999999" BorderThickness="0"
                    FontSize="11" Cursor="Hand" Click="Dismiss_Click"
                    VerticalAlignment="Center" Padding="4,2"
                    AutomationProperties.Name="{x:Static res:Strings.Close}"
                    AutomationProperties.AutomationId="DismissToastButton"
                    TabIndex="0"/>
        </Grid>
    </Border>
</UserControl>
