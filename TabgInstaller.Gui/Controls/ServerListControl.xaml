<UserControl x:Class="TabgInstaller.Gui.Controls.ServerListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources"
             mc:Ignorable="d"
             d:DesignWidth="180" d:DesignHeight="600">

    <UserControl.Resources>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F0F0F0" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static res:Strings.Servers}" FontWeight="Bold" FontSize="14"
                   Margin="12,12,12,8"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Instances}"
                 SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="4,0"
                 AutomationProperties.Name="Server instances"
                 AutomationProperties.AutomationId="ServerInstancesListBox"
                 TabIndex="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="8,6">
                        <Ellipse Style="{StaticResource StatusDot}">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="Gray"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="130"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2"
                Content="{x:Static res:Strings.AddServerButton}"
                Command="{Binding AddServerCommand}"
                Margin="8,4,8,8"
                Padding="8,6"
                AutomationProperties.Name="{x:Static res:Strings.AddServerButton}"
                AutomationProperties.AutomationId="AddServerButton"
                TabIndex="1"/>
    </Grid>
</UserControl>
