<UserControl x:Class="TabgInstaller.Gui.Tabs.InstallerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <Grid Margin="10" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Path -->
        <GroupBox Grid.Row="0" Header="{x:Static res:Strings.ServerPath}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="5"
                         Text="{Binding ServerPath, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding UiEnabled}"
                         AutomationProperties.Name="Server installation path"
                         AutomationProperties.AutomationId="InstallerServerPathTextBox"
                         TabIndex="0"/>
                <Button Content="{x:Static res:Strings.Browse}" Grid.Column="1" Width="80" Margin="5"
                        Click="Browse_Click"
                        IsEnabled="{Binding UiEnabled}"
                        AutomationProperties.Name="{x:Static res:Strings.Browse}"
                        AutomationProperties.AutomationId="InstallerBrowseButton"
                        TabIndex="1"/>
            </Grid>
        </GroupBox>

        <!-- Plugins -->
        <GroupBox Grid.Row="1" Header="{x:Static res:Strings.Plugins}" Margin="0,0,0,10">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding PluginSelections}"
                              AutomationProperties.Name="Plugin selections"
                              AutomationProperties.AutomationId="PluginSelectionsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5,3">
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEnabled}"
                                          AutomationProperties.Name="{Binding Name}"/>
                                <TextBlock Text="{x:Static res:Strings.ClientModRequired}"
                                           Foreground="#E65100" FontSize="11"
                                           VerticalAlignment="Center" FontStyle="Italic"
                                           ToolTip="{x:Static res:Tooltips.ClientModRequiredTooltip}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RequiresClientMod}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Dependency hint -->
                <TextBlock Margin="5,4,5,0" Foreground="#E65100" FontSize="11"
                           TextWrapping="Wrap"
                           Text="{x:Static res:Strings.ClientModsNeeded}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DependencyHintVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="5,6,5,2">
                    <Button Content="{x:Static res:Strings.SelectAll}" Width="80" Command="{Binding SelectAllCommand}" Margin="0,0,5,0"
                            AutomationProperties.Name="{x:Static res:Strings.SelectAll}"
                            AutomationProperties.AutomationId="SelectAllPluginsButton"
                            TabIndex="11"/>
                    <Button Content="{x:Static res:Strings.SelectNone}" Width="80" Command="{Binding SelectNoneCommand}" Margin="0,0,5,0"
                            AutomationProperties.Name="{x:Static res:Strings.SelectNone}"
                            AutomationProperties.AutomationId="SelectNonePluginsButton"
                            TabIndex="12"/>
                    <Button Content="{x:Static res:Strings.SigmaPreset}" Width="100" Command="{Binding SelectSigmaCommand}"
                            ToolTip="{x:Static res:Tooltips.SigmaPresetTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.SigmaPreset}"
                            AutomationProperties.AutomationId="SigmaPresetButton"
                            TabIndex="13"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Progress + Log -->
        <GroupBox Grid.Row="2" Header="{x:Static res:Strings.InstallationLog}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,4,4,8">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProgressVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                               VerticalAlignment="Center" FontSize="12" Foreground="#555555"
                               Text="{Binding StatusText}"/>
                    <ProgressBar Height="20" Minimum="0" Maximum="100"
                                 Value="{Binding Progress}"
                                 AutomationProperties.Name="Installation progress"
                                 AutomationProperties.AutomationId="InstallProgressBar"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer">
                    <TextBox IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding LogText, Mode=OneWay}"
                             AutomationProperties.Name="Installation log output"
                             AutomationProperties.AutomationId="InstallerLogTextBox"
                             AutomationProperties.LiveSetting="Polite"/>
                </ScrollViewer>
            </Grid>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{x:Static res:Strings.Install}" Height="40" Width="140"
                    Command="{Binding InstallCommand}"
                    IsEnabled="{Binding UiEnabled}"
                    AutomationProperties.Name="{x:Static res:Strings.Install}"
                    AutomationProperties.AutomationId="InstallButton"
                    TabIndex="90"/>
            <Button Height="40" Width="140" Margin="10,0,0,0"
                    Content="{Binding CancelButtonText}"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel installation"
                    AutomationProperties.AutomationId="CancelInstallButton"
                    TabIndex="91">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCancelVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{x:Static res:Strings.ContinueWithoutInstall}" Height="40" Width="200" Margin="10,0,0,0"
                    Command="{Binding ContinueCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.ContinueWithoutInstall}"
                    AutomationProperties.AutomationId="ContinueWithoutInstallButton"
                    TabIndex="92"/>
        </StackPanel>
    </Grid>
</UserControl>
