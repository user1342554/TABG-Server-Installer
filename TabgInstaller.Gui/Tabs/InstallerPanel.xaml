<UserControl x:Class="TabgInstaller.Gui.Tabs.InstallerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Path -->
        <GroupBox Grid.Row="0" Header="Server Path" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Grid.Column="0" Margin="5"/>
                <Button x:Name="BrowseButton" Content="Browse" Grid.Column="1" Width="80" Margin="5" Click="Browse_Click"/>
            </Grid>
        </GroupBox>

        <!-- Plugins -->
        <GroupBox Grid.Row="1" Header="Plugins" Margin="0,0,0,10">
            <StackPanel>
                <CheckBox x:Name="ChkCitruslib" Content="Citruslib — Core server library (admin, permissions, commands)"
                          Margin="5,3" IsChecked="True"/>
                <Grid Margin="20,0,5,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Tag:" Grid.Column="0" Padding="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtCitrusTag" Text="v0.7" Grid.Column="1" Width="80" HorizontalAlignment="Left"/>
                </Grid>
                <CheckBox x:Name="ChkInstallStarterPack" Content="StarterPack — Match mechanics, loadouts, win conditions"
                          Margin="5,3" IsChecked="True"/>
                <CheckBox x:Name="ChkStarterPackFixes" Content="StarterPackFixes — Loot drop control"
                          Margin="5,3" IsChecked="True"/>
                <CheckBox x:Name="ChkCustomSpawnpoints" Content="CustomSpawnpoints — Custom spawn points"
                          Margin="5,3" IsChecked="True"/>
                <CheckBox x:Name="ChkFreddoCommission" Content="FreddoTABGCommission — Curses, grenades on kill, bans"
                          Margin="5,3" IsChecked="True"/>
                <CheckBox x:Name="ChkMatchTimeout" Content="MatchAndPreMatchTimeout — Match timing"
                          Margin="5,3" IsChecked="True"/>
                <CheckBox x:Name="ChkServerLogger" Content="ServerLogger — Player logging"
                          Margin="5,3" IsChecked="True"/>
                <CheckBox x:Name="ChkVoteToStart" Content="VoteToStart — Vote-to-start"
                          Margin="5,3" IsChecked="True"/>
                <CheckBox x:Name="ChkUnusedVehicles" Content="UnusedVehicles — Spawn cut vehicles (Heli, UFO, Mustang, VW, HoverBike)"
                          Margin="5,3" IsChecked="True"/>
                <CheckBox x:Name="ChkBigSmoke" Content="BigSmokeGrenade — Giant purple smoke grenades (/give 208)"
                          Margin="5,3" IsChecked="True"/>
                <CheckBox x:Name="ChkMGLFlashbang" Content="MGLFlashbang — MGL shoots flashbang rounds"
                          Margin="5,3" IsChecked="True"/>
                <CheckBox x:Name="ChkSoloTesting" Content="SoloTesting — Prevents 'You Win' when testing alone"
                          Margin="5,3"/>
                <CheckBox x:Name="ChkInstallCommunityServer" Content="TABGCommunityServer — Community server"
                          Margin="5,3"/>
                <CheckBox x:Name="ChkProximityChat" Content="ProximityChat — Proximity voice chat (requires client mod too)"
                          Margin="5,3" IsChecked="True"/>
                <CheckBox x:Name="ChkHuntMode" Content="Hunt Mode (4v1) — 1 Killer vs 4 Survivors survival"
                          Margin="5,3" IsChecked="False"/>
                <StackPanel Orientation="Horizontal" Margin="5,6,5,2">
                    <Button Content="Select All" Width="80" Click="SelectAllPlugins_Click" Margin="0,0,5,0"/>
                    <Button Content="Select None" Width="80" Click="SelectNonePlugins_Click" Margin="0,0,5,0"/>
                    <Button Content="Sigma Preset" Width="100" Click="SelectSigmaPlugins_Click"
                            ToolTip="Select the plugins required for the CollinSigma preset"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Log -->
        <GroupBox Grid.Row="2" Header="Installation Log">
            <ScrollViewer x:Name="LogScrollViewer">
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnInstall" Content="INSTALL" Height="40" Width="140" Click="BtnInstall_Click"/>
            <Button x:Name="BtnContinue" Content="Continue without install" Height="40" Width="200" Margin="10,0,0,0" Click="BtnContinue_Click"/>
        </StackPanel>
    </Grid>
</UserControl>