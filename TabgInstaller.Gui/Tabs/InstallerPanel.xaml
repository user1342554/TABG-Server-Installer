<UserControl x:Class="TabgInstaller.Gui.Tabs.InstallerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Path -->
        <GroupBox Grid.Row="0" Header="Server Path" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="5"
                         Text="{Binding ServerPath, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding UiEnabled}"/>
                <Button Content="Browse" Grid.Column="1" Width="80" Margin="5"
                        Click="Browse_Click"
                        IsEnabled="{Binding UiEnabled}"/>
            </Grid>
        </GroupBox>

        <!-- Plugins -->
        <GroupBox Grid.Row="1" Header="Plugins" Margin="0,0,0,10">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding PluginSelections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5,3">
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEnabled}"/>
                                <TextBlock Text=" [Client mod required]"
                                           Foreground="#E65100" FontSize="11"
                                           VerticalAlignment="Center" FontStyle="Italic"
                                           ToolTip="Also requires the client-side mod installed via the Client tab">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RequiresClientMod}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- CitrusLib tag input — shown inline after the Citruslib entry -->
                <Grid Margin="20,0,5,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Citruslib Tag:" Grid.Column="0" Padding="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Width="80" HorizontalAlignment="Left"
                             Text="{Binding CitrusTag, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding UiEnabled}"/>
                </Grid>

                <!-- Dependency hint -->
                <TextBlock Margin="5,4,5,0" Foreground="#E65100" FontSize="11"
                           TextWrapping="Wrap"
                           Text="Some selected plugins require matching client mods — install them in the Client tab after server setup.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DependencyHintVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="5,6,5,2">
                    <Button Content="Select All" Width="80" Command="{Binding SelectAllCommand}" Margin="0,0,5,0"/>
                    <Button Content="Select None" Width="80" Command="{Binding SelectNoneCommand}" Margin="0,0,5,0"/>
                    <Button Content="Sigma Preset" Width="100" Command="{Binding SelectSigmaCommand}"
                            ToolTip="Select the plugins required for the CollinSigma preset"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Progress + Log -->
        <GroupBox Grid.Row="2" Header="Installation Log">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,4,4,8">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProgressVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                               VerticalAlignment="Center" FontSize="12" Foreground="#555555"
                               Text="{Binding StatusText}"/>
                    <ProgressBar Height="20" Minimum="0" Maximum="100"
                                 Value="{Binding Progress}"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer">
                    <TextBox IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding LogText, Mode=OneWay}"/>
                </ScrollViewer>
            </Grid>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="INSTALL" Height="40" Width="140"
                    Command="{Binding InstallCommand}"
                    IsEnabled="{Binding UiEnabled}"/>
            <Button Height="40" Width="140" Margin="10,0,0,0"
                    Content="{Binding CancelButtonText}"
                    Command="{Binding CancelCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCancelVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Continue without install" Height="40" Width="200" Margin="10,0,0,0"
                    Command="{Binding ContinueCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
