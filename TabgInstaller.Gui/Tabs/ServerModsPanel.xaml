<UserControl x:Class="TabgInstaller.Gui.Tabs.ServerModsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TabgInstaller.Gui.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Server Plugins" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Add, remove, or toggle server plugins — no reinstall needed." Foreground="#888" FontSize="12"/>
        </StackPanel>

        <!-- Installed plugins -->
        <GroupBox Grid.Row="1" Header="Installed Plugins (BepInEx/plugins)">
            <ListView x:Name="LstPlugins" ItemsSource="{Binding Plugins}" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>

        <!-- Actions for installed -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Add DLL file..." Width="110" Click="AddDll_Click"/>
            <Button Content="Remove Selected" Width="120" Margin="5,0,0,0"
                    Command="{Binding RemovePluginCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=LstPlugins}"/>
            <Button Content="Refresh" Width="80" Margin="5,0,0,0" Command="{Binding RefreshCommand}"/>
            <Button Content="Open Folder" Width="100" Margin="5,0,0,0" Command="{Binding OpenFolderCommand}"/>
        </StackPanel>

        <!-- Available bundled plugins -->
        <GroupBox Grid.Row="3" Header="Available Plugins" Margin="0,10,0,0">
            <StackPanel>
                <Grid>
                    <ListView x:Name="LstBundled" ItemsSource="{Binding AvailableMods}"
                              MaxHeight="200" SelectionMode="Extended" BorderThickness="0"
                              Visibility="{Binding AllPluginsInstalled, Converter={StaticResource InverseBoolToVisibility}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="All plugins are already installed."
                               Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding AllPluginsInstalled, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <Button Content="Install Selected" Width="120" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Command="{Binding InstallBundledCommand}"
                        IsEnabled="{Binding CanInstallBundled}"/>
            </StackPanel>
        </GroupBox>

        <!-- Spacer row so grid doesn't complain -->
        <StackPanel Grid.Row="4"/>
    </Grid>
</UserControl>
