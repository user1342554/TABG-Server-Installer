<UserControl x:Class="TabgInstaller.Gui.Tabs.ServerModsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TabgInstaller.Gui.Converters"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{x:Static res:Strings.ServerPlugins}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Static res:Strings.ServerPluginsSubtitle}"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.Refresh}" Width="88" Margin="0,0,6,0"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.AutomationId="RefreshPluginsButton"
                        TabIndex="80"/>
                <Button Content="{x:Static res:Strings.OpenFolder}" Width="108"
                        Command="{Binding OpenFolderCommand}"
                        AutomationProperties.AutomationId="OpenPluginsFolderButton"
                        TabIndex="81"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="{x:Static res:Strings.InstalledPlugins}"
                                   Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                        <Button Content="{x:Static res:Strings.AddDllFile}" Width="100" HorizontalAlignment="Right"
                                DockPanel.Dock="Right" Click="AddDll_Click"
                                AutomationProperties.AutomationId="AddDllButton"
                                TabIndex="20"/>
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{x:Static res:Strings.RemoveSelected}" Width="124"
                                Command="{Binding RemovePluginCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=LstPlugins}"
                                AutomationProperties.AutomationId="RemovePluginButton"
                                TabIndex="21"/>
                    </StackPanel>

                    <ListView x:Name="LstPlugins" ItemsSource="{Binding Plugins}" SelectionMode="Single"
                              BorderThickness="0"
                              AutomationProperties.Name="Installed server plugins"
                              AutomationProperties.AutomationId="InstalledPluginsListView"
                              TabIndex="10">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="{Binding Name}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Local Plugin Library" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Small checkbox installs/enables; uncheck disables"
                                       Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </DockPanel>

                    <ListView x:Name="LstCatalog" Grid.Row="1" ItemsSource="{Binding PluginCatalog}"
                              SelectedItem="{Binding SelectedCatalogPlugin, Mode=TwoWay}"
                              BorderThickness="0"
                              AutomationProperties.Name="Local server plugin library"
                              AutomationProperties.AutomationId="LocalPluginLibraryListView"
                              TabIndex="50">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              IsEnabled="{Binding CanToggle}"
                                              Command="{Binding DataContext.ToggleCatalogPluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="{Binding DisplayName}"/>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource MutedText}"
                                                       Margin="10,0,0,0"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource DefaultBorderBrush}" BorderThickness="1,1,0,0"
                            Padding="0,10,0,0" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedCatalogPlugin.DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedCatalogPlugin.StateText}" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedCatalogPlugin.Description}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedCatalogPlugin.Dlls}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Expander Grid.Row="3" Header="Advanced DLL install" Margin="0,10,0,0" IsExpanded="False">
                        <StackPanel Margin="0,6,0,0">
                            <Grid>
                                <ListView x:Name="LstBundled" ItemsSource="{Binding AvailableMods}"
                                          MaxHeight="120" SelectionMode="Extended" BorderThickness="0"
                                          Visibility="{Binding AllPluginsInstalled, Converter={StaticResource InverseBoolToVisibility}}"
                                          AutomationProperties.Name="Available bundled plugins"
                                          AutomationProperties.AutomationId="AvailablePluginsListView"
                                          TabIndex="70">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          AutomationProperties.Name="{Binding Name}"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="{x:Static res:Strings.AllPluginsInstalled}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding AllPluginsInstalled, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                            <Button Content="{x:Static res:Strings.InstallSelected}" Width="128"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Command="{Binding InstallBundledCommand}"
                                    IsEnabled="{Binding CanInstallBundled}"
                                    AutomationProperties.AutomationId="InstallSelectedPluginsButton"
                                    TabIndex="71"/>
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="0,8,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
    </Grid>
</UserControl>
