<UserControl x:Class="TabgInstaller.Gui.Tabs.ServerModsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TabgInstaller.Gui.Converters"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True"/>
    </UserControl.Resources>
    <Grid Margin="10" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{x:Static res:Strings.ServerPlugins}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static res:Strings.ServerPluginsSubtitle}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
        </StackPanel>

        <!-- Installed plugins -->
        <GroupBox Grid.Row="1" Header="{x:Static res:Strings.InstalledPlugins}">
            <ListView x:Name="LstPlugins" ItemsSource="{Binding Plugins}" SelectionMode="Single"
                      AutomationProperties.Name="Installed server plugins"
                      AutomationProperties.AutomationId="InstalledPluginsListView"
                      TabIndex="10">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"
                                      AutomationProperties.Name="{Binding Name}"/>
                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>

        <!-- Actions for installed -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{x:Static res:Strings.AddDllFile}" Width="110" Click="AddDll_Click"
                    AutomationProperties.Name="{x:Static res:Strings.AddDllFile}"
                    AutomationProperties.AutomationId="AddDllButton"
                    TabIndex="50"/>
            <Button Content="{x:Static res:Strings.RemoveSelected}" Width="120" Margin="5,0,0,0"
                    Command="{Binding RemovePluginCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=LstPlugins}"
                    AutomationProperties.Name="{x:Static res:Strings.RemoveSelected}"
                    AutomationProperties.AutomationId="RemovePluginButton"
                    TabIndex="51"/>
            <Button Content="{x:Static res:Strings.Refresh}" Width="80" Margin="5,0,0,0" Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Refresh}"
                    AutomationProperties.AutomationId="RefreshPluginsButton"
                    TabIndex="52"/>
            <Button Content="{x:Static res:Strings.OpenFolder}" Width="100" Margin="5,0,0,0" Command="{Binding OpenFolderCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.OpenFolder}"
                    AutomationProperties.AutomationId="OpenPluginsFolderButton"
                    TabIndex="53"/>
        </StackPanel>

        <!-- Local plugin catalog -->
        <GroupBox Grid.Row="3" Header="Local Plugin Library" Margin="0,10,0,0">
            <StackPanel>
                <ListView x:Name="LstCatalog" ItemsSource="{Binding PluginCatalog}"
                          SelectedItem="{Binding SelectedCatalogPlugin, Mode=TwoWay}"
                          MinHeight="180" MaxHeight="260"
                          AutomationProperties.Name="Local server plugin library"
                          AutomationProperties.AutomationId="LocalPluginLibraryListView"
                          TabIndex="60">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Plugin" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Description" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ClientRequirement}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="DLLs" Width="240" DisplayMemberBinding="{Binding Dlls}"/>
                            <GridViewColumn Header="State" Width="130" DisplayMemberBinding="{Binding StateText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Install" Width="90"
                            Command="{Binding InstallCatalogPluginCommand}"
                            CommandParameter="{Binding SelectedCatalogPlugin}"
                            AutomationProperties.AutomationId="InstallCatalogPluginButton"
                            TabIndex="61"/>
                    <Button Content="Enable" Width="90" Margin="5,0,0,0"
                            Command="{Binding EnableCatalogPluginCommand}"
                            CommandParameter="{Binding SelectedCatalogPlugin}"
                            AutomationProperties.AutomationId="EnableCatalogPluginButton"
                            TabIndex="62"/>
                    <Button Content="Disable" Width="90" Margin="5,0,0,0"
                            Command="{Binding DisableCatalogPluginCommand}"
                            CommandParameter="{Binding SelectedCatalogPlugin}"
                            AutomationProperties.AutomationId="DisableCatalogPluginButton"
                            TabIndex="63"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Advanced raw bundled DLL install -->
        <GroupBox Grid.Row="4" Header="Advanced: Raw Bundled DLLs" Margin="0,10,0,0">
            <StackPanel>
                <Grid>
                    <ListView x:Name="LstBundled" ItemsSource="{Binding AvailableMods}"
                              MaxHeight="120" SelectionMode="Extended" BorderThickness="0"
                              Visibility="{Binding AllPluginsInstalled, Converter={StaticResource InverseBoolToVisibility}}"
                              AutomationProperties.Name="Available bundled plugins"
                              AutomationProperties.AutomationId="AvailablePluginsListView"
                              TabIndex="70">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Name}"/>
                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Static res:Strings.AllPluginsInstalled}"
                               Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding AllPluginsInstalled, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <Button Content="{x:Static res:Strings.InstallSelected}" Width="120" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Command="{Binding InstallBundledCommand}"
                        IsEnabled="{Binding CanInstallBundled}"
                        AutomationProperties.Name="{x:Static res:Strings.InstallSelected}"
                        AutomationProperties.AutomationId="InstallSelectedPluginsButton"
                        TabIndex="71"/>
            </StackPanel>
        </GroupBox>

        <!-- Spacer row so grid doesn't complain -->
        <StackPanel Grid.Row="5"/>
    </Grid>
</UserControl>
