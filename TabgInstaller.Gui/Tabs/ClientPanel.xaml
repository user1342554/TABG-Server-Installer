<UserControl x:Class="TabgInstaller.Gui.Tabs.ClientPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TabgInstaller.Gui.Converters"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True"/>
    </UserControl.Resources>
    <Grid Margin="10" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{x:Static res:Strings.TabClientMods}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static res:Strings.ClientModsSubtitle}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
        </StackPanel>

        <!-- Paths -->
        <GroupBox Grid.Row="1" Header="{x:Static res:Strings.Paths}" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="TabgSteamFolderLabel" Content="{x:Static res:Strings.TabgSteamFolder}" Grid.Column="0" Padding="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ClientPath, Mode=OneWay}" IsReadOnly="True"
                             AutomationProperties.LabeledBy="{Binding ElementName=TabgSteamFolderLabel}"
                             AutomationProperties.AutomationId="ClientPathTextBox"
                             TabIndex="10"/>
                    <Button Content="{x:Static res:Strings.Browse}" Grid.Column="2" Width="70" Margin="5,0,0,0" Click="BrowseClient_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Browse}"
                            AutomationProperties.AutomationId="BrowseClientButton"
                            TabIndex="11"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="ModdedCopyFolderLabel" Content="{x:Static res:Strings.ModdedCopyFolder}" Grid.Column="0" Padding="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ModdedPath, Mode=OneWay}" IsReadOnly="True"
                             AutomationProperties.LabeledBy="{Binding ElementName=ModdedCopyFolderLabel}"
                             AutomationProperties.AutomationId="ModdedPathTextBox"
                             TabIndex="12"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Installed mods list -->
        <GroupBox Grid.Row="2" Header="{x:Static res:Strings.InstalledClientMods}">
            <Grid>
                <ListView x:Name="LstClientMods" ItemsSource="{Binding Mods}" SelectionMode="Single"
                          Visibility="{Binding AllClientModsInstalled, Converter={StaticResource InverseBoolToVisibility}}"
                          AutomationProperties.Name="Installed client mods"
                          AutomationProperties.AutomationId="InstalledClientModsListView"
                          TabIndex="20">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"
                                          AutomationProperties.Name="{Binding Name}"/>
                                <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="{x:Static res:Strings.NoModdedTabgFound}"
                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding AllClientModsInstalled, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </GroupBox>

        <!-- Actions for installed -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{x:Static res:Strings.InitialSetup}" Width="260"
                    Command="{Binding SetupCommand}"
                    IsEnabled="{Binding IsSettingUp, Converter={StaticResource InverseBoolToVisibility}}"
                    AutomationProperties.Name="{x:Static res:Strings.InitialSetup}"
                    AutomationProperties.AutomationId="InitialSetupButton"
                    TabIndex="50"/>
            <Button Content="{x:Static res:Strings.AddDllFile}" Width="110" Margin="5,0,0,0" Click="AddDll_Click"
                    AutomationProperties.Name="{x:Static res:Strings.AddDllFile}"
                    AutomationProperties.AutomationId="ClientAddDllButton"
                    TabIndex="51"/>
            <Button Content="{x:Static res:Strings.RemoveSelected}" Width="120" Margin="5,0,0,0"
                    Command="{Binding RemoveModCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=LstClientMods}"
                    AutomationProperties.Name="{x:Static res:Strings.RemoveSelected}"
                    AutomationProperties.AutomationId="RemoveClientModButton"
                    TabIndex="52"/>
            <Button Content="{x:Static res:Strings.Refresh}" Width="80" Margin="5,0,0,0" Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Refresh}"
                    AutomationProperties.AutomationId="RefreshClientModsButton"
                    TabIndex="53"/>
        </StackPanel>

        <!-- Available bundled client mods -->
        <GroupBox Grid.Row="4" Header="{x:Static res:Strings.AvailableMods}" Margin="0,10,0,0">
            <StackPanel>
                <Grid>
                    <ListView x:Name="LstBundled" ItemsSource="{Binding AvailableClientMods}"
                              MaxHeight="200" SelectionMode="Extended" BorderThickness="0"
                              Visibility="{Binding AllClientModsInstalled, Converter={StaticResource InverseBoolToVisibility}}"
                              AutomationProperties.Name="Available bundled client mods"
                              AutomationProperties.AutomationId="AvailableClientModsListView"
                              TabIndex="60">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Name}"/>
                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Static res:Strings.AllClientModsInstalled}"
                               Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding AllClientModsInstalled, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <Button Content="{x:Static res:Strings.InstallSelected}" Width="120" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Command="{Binding InstallBundledCommand}"
                        IsEnabled="{Binding CanInstallBundled}"
                        AutomationProperties.Name="{x:Static res:Strings.InstallSelected}"
                        AutomationProperties.AutomationId="InstallClientModsButton"
                        TabIndex="61"/>
            </StackPanel>
        </GroupBox>

        <!-- Spacer row so grid doesn't complain -->
        <StackPanel Grid.Row="5"/>

        <!-- Launch -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{x:Static res:Strings.LaunchModdedTabgCaps}" Height="36" Width="200" Command="{Binding LaunchCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.LaunchModdedTabgCaps}"
                    AutomationProperties.AutomationId="LaunchModdedTabgButton"
                    TabIndex="90"/>
            <Button Content="{x:Static res:Strings.OpenModdedFolder}" Height="36" Width="150" Margin="10,0,0,0"
                    Command="{Binding OpenModdedFolderCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.OpenModdedFolder}"
                    AutomationProperties.AutomationId="OpenModdedFolderButton"
                    TabIndex="91"/>
        </StackPanel>
    </Grid>
</UserControl>
