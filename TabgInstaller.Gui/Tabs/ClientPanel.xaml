<UserControl x:Class="TabgInstaller.Gui.Tabs.ClientPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TabgInstaller.Gui.Converters"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DefaultBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{x:Static res:Strings.TabClientMods}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Static res:Strings.ClientModsSubtitle}"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.InitialSetup}" Width="132" Margin="0,0,6,0"
                        Command="{Binding SetupCommand}"
                        AutomationProperties.AutomationId="InitialSetupButton"
                        TabIndex="80"/>
                <Button Content="{x:Static res:Strings.Refresh}" Width="88" Margin="0,0,6,0"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.AutomationId="RefreshClientModsButton"
                        TabIndex="81"/>
                <Button Content="{x:Static res:Strings.LaunchModdedTabgCaps}" Width="128" Margin="0,0,6,0"
                        Command="{Binding LaunchCommand}"
                        AutomationProperties.AutomationId="LaunchModdedTabgButton"
                        TabIndex="82"/>
                <Button Content="{x:Static res:Strings.OpenModdedFolder}" Width="132"
                        Command="{Binding OpenModdedFolderCommand}"
                        AutomationProperties.AutomationId="OpenModdedFolderButton"
                        TabIndex="83"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label x:Name="TabgSteamFolderLabel" Grid.Row="0" Grid.Column="0"
                       Content="{x:Static res:Strings.TabgSteamFolder}" Padding="0,0,8,4"
                       VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ClientPath, Mode=OneWay}"
                         IsReadOnly="True" Margin="0,0,6,4"
                         AutomationProperties.LabeledBy="{Binding ElementName=TabgSteamFolderLabel}"
                         AutomationProperties.AutomationId="ClientPathTextBox"
                         TabIndex="10"/>
                <Button Grid.Row="0" Grid.Column="2" Content="{x:Static res:Strings.Browse}"
                        Width="82" Margin="0,0,0,4" Click="BrowseClient_Click"
                        AutomationProperties.AutomationId="BrowseClientButton"
                        TabIndex="11"/>

                <Label x:Name="ModdedCopyFolderLabel" Grid.Row="1" Grid.Column="0"
                       Content="{x:Static res:Strings.ModdedCopyFolder}" Padding="0,0,8,0"
                       VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                         Text="{Binding ModdedPath, Mode=OneWay}" IsReadOnly="True"
                         AutomationProperties.LabeledBy="{Binding ElementName=ModdedCopyFolderLabel}"
                         AutomationProperties.AutomationId="ModdedPathTextBox"
                         TabIndex="12"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="{x:Static res:Strings.InstalledClientMods}"
                                   Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                        <Button Content="{x:Static res:Strings.AddDllFile}" Width="100" HorizontalAlignment="Right"
                                DockPanel.Dock="Right" Click="AddDll_Click"
                                AutomationProperties.AutomationId="ClientAddDllButton"
                                TabIndex="20"/>
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{x:Static res:Strings.RemoveSelected}" Width="124"
                                Command="{Binding RemoveModCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=LstClientMods}"
                                AutomationProperties.AutomationId="RemoveClientModButton"
                                TabIndex="21"/>
                    </StackPanel>

                    <ListView x:Name="LstClientMods" ItemsSource="{Binding Mods}" SelectionMode="Single"
                              BorderThickness="0"
                              AutomationProperties.Name="Installed client mods"
                              AutomationProperties.AutomationId="InstalledClientModsListView"
                              TabIndex="30">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="{Binding Name}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Local Client Library" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Small checkbox installs/enables; uncheck disables"
                                   Style="{StaticResource MutedText}"/>
                    </StackPanel>

                    <ListView x:Name="LstClientCatalog" Grid.Row="1" ItemsSource="{Binding ClientModCatalog}"
                              SelectedItem="{Binding SelectedClientCatalogMod, Mode=TwoWay}"
                              BorderThickness="0"
                              AutomationProperties.Name="Local client mod library"
                              AutomationProperties.AutomationId="LocalClientLibraryListView"
                              TabIndex="50">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              IsEnabled="{Binding CanToggle}"
                                              Command="{Binding DataContext.ToggleClientCatalogModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="{Binding DisplayName}"/>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource MutedText}"
                                                       Margin="10,0,0,0"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Expander Grid.Row="2" Header="Advanced DLL install" Margin="0,10,0,0" IsExpanded="False">
                        <StackPanel Margin="0,6,0,0">
                            <Grid>
                                <ListView x:Name="LstBundled" ItemsSource="{Binding AvailableClientMods}"
                                          MaxHeight="120" SelectionMode="Extended" BorderThickness="0"
                                          Visibility="{Binding AllClientModsInstalled, Converter={StaticResource InverseBoolToVisibility}}"
                                          AutomationProperties.Name="Available bundled client mods"
                                          AutomationProperties.AutomationId="AvailableClientModsListView"
                                          TabIndex="60">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          AutomationProperties.Name="{Binding Name}"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="{x:Static res:Strings.AllClientModsInstalled}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding AllClientModsInstalled, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                            <Button Content="{x:Static res:Strings.InstallSelected}" Width="128"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Command="{Binding InstallBundledCommand}"
                                    IsEnabled="{Binding CanInstallBundled}"
                                    AutomationProperties.AutomationId="InstallClientModsButton"
                                    TabIndex="61"/>
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Margin="0,8,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
    </Grid>
</UserControl>
