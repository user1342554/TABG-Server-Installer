<UserControl x:Class="TabgInstaller.Gui.Tabs.LoadoutEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="Loadout Mode:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbMode" Width="160" IsEnabled="False" VerticalAlignment="Center" Margin="4,0,0,0">
                <ComboBoxItem Content="Normal"/>
                <ComboBoxItem Content="GunGame"/>
                <ComboBoxItem Content="ReverseGunGame"/>
                <ComboBoxItem Content="KeepInventory"/>
            </ComboBox>
            <Button Content="Import Raw" Margin="16,0,4,0" Padding="8,2" Click="ImportRaw_Click"/>
            <Button Content="Export Raw" Padding="8,2" Click="ExportRaw_Click"/>
        </StackPanel>

        <!-- Main Area - Two Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column - Loadout List -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Loadouts" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Add" Width="60" Margin="0,0,4,0" Click="AddLoadout_Click"/>
                    <Button Content="Remove" Width="60" Margin="0,0,4,0" Click="RemoveLoadout_Click"/>
                    <Button Content="Up" Width="40" Margin="0,0,4,0" Click="MoveUp_Click"/>
                    <Button Content="Down" Width="40" Click="MoveDown_Click"/>
                </StackPanel>
                <ListBox x:Name="LstLoadouts" DisplayMemberPath="DisplayName"
                         SelectionChanged="LstLoadouts_SelectionChanged"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Right Column - Selected Loadout Editor -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PnlEditor" IsEnabled="False" Margin="4,0,0,0">
                    <!-- Name and Weight -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Label Content="Name:" Width="60"/>
                        <TextBox x:Name="TxtName" Width="200" TextChanged="TxtName_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Label Content="Weight:" Width="60"/>
                        <TextBox x:Name="TxtPercent" Width="60" TextChanged="TxtPercent_TextChanged"/>
                        <Label Content="%" Padding="2,5,0,5"/>
                    </StackPanel>

                    <!-- Items List -->
                    <TextBlock Text="Items" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DataGrid x:Name="DgItems" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column"
                              Height="180" Margin="0,0,0,4" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Click="RemoveItem_Click" Tag="{Binding}"
                                                Padding="2,0" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Add Item Section -->
                    <GroupBox Header="Add Item" Margin="0,0,0,8">
                        <StackPanel Margin="4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Label Content="Category:" Width="70"/>
                                <ComboBox x:Name="CmbCategory" Width="160"
                                          SelectionChanged="CmbCategory_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Label Content="Item:" Width="70"/>
                                <ComboBox x:Name="CmbItem" Width="250"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Quantity:" Width="70"/>
                                <TextBox x:Name="TxtQuantity" Width="60" Text="1"/>
                                <Button Content="Add" Width="60" Margin="8,0,0,0" Click="AddItem_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Curse Assignment Section -->
                    <GroupBox Header="Curse Assignment" Margin="0,0,0,4">
                        <ItemsControl x:Name="IcCurses">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Margin="4,2" Width="185"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Save" Width="100" Click="Save_Click"/>
            <TextBlock x:Name="TxtStatus" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
