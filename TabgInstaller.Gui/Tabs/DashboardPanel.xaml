<UserControl x:Class="TabgInstaller.Gui.Tabs.DashboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Margin="0,0,0,10">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Server Status" FontWeight="SemiBold"/>
                    <TextBlock FontWeight="Bold" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="  STOPPED"/>
                                <Setter Property="Foreground" Value="#CC0000"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                        <Setter Property="Text" Value="  RUNNING"/>
                                        <Setter Property="Foreground" Value="#00AA44"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </GroupBox.Header>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Button Content="{Binding StartStopButtonText}" Width="120" Height="36"
                            Command="{Binding StartStopCommand}"/>
                    <Button Content="Launch Modded TABG" Width="160" Height="36" Margin="10,0,0,0"
                            Command="{Binding LaunchClientCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding ServerPath}" Foreground="#888" FontSize="11" Margin="5,5,5,0"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="Quick Actions" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Open Server Folder" Width="130" Margin="2"
                        Command="{Binding OpenServerFolderCommand}"/>
                <Button Content="Open Logs" Width="90" Margin="2"
                        Command="{Binding OpenLogsCommand}"/>
                <Button Content="Open Config Files" Width="120" Margin="2"
                        Command="{Binding OpenConfigsCommand}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Console Preview (last 20 lines)">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0">
                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                </ScrollViewer>
                <Button Grid.Row="1" Content="Open Full Console" HorizontalAlignment="Right" Margin="5"
                        Command="{Binding OpenFullConsoleCommand}"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
