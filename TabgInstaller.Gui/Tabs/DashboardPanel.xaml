<UserControl x:Class="TabgInstaller.Gui.Tabs.DashboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TabgInstaller.Gui.Controls"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <Grid Margin="10" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ItemsControl Grid.Row="0" ItemsSource="{Binding HealthCards}" Margin="0,0,0,12"
                      AutomationProperties.Name="Server health cards"
                      AutomationProperties.AutomationId="HealthCardsItemsControl">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:HealthCardControl/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <GroupBox Grid.Row="1" Margin="0,0,0,10">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.ServerStatus}" FontWeight="SemiBold"/>
                    <TextBlock FontWeight="Bold" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{x:Static res:Strings.StatusStopped}"/>
                                <Setter Property="Foreground" Value="{DynamicResource StatusStoppedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                        <Setter Property="Text" Value="{x:Static res:Strings.StatusRunning}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource StatusRunningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </GroupBox.Header>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Button Content="{Binding StartStopButtonText}" Width="120" Height="36"
                            Command="{Binding StartStopCommand}"
                            AutomationProperties.Name="{Binding StartStopButtonText}"
                            AutomationProperties.AutomationId="StartStopServerButton"
                            TabIndex="0"/>
                    <Button Content="{x:Static res:Strings.LaunchModdedTabg}" Width="160" Height="36" Margin="10,0,0,0"
                            Command="{Binding LaunchClientCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.LaunchModdedTabg}"
                            AutomationProperties.AutomationId="LaunchModdedTabgButton"
                            TabIndex="1"/>
                </StackPanel>
                <TextBlock Text="{Binding ServerPath}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="5,5,5,0"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="{x:Static res:Strings.QuickActions}" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="{x:Static res:Strings.OpenServerFolder}" Width="130" Margin="2"
                        Command="{Binding OpenServerFolderCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.OpenServerFolder}"
                        AutomationProperties.AutomationId="OpenServerFolderButton"
                        TabIndex="10"/>
                <Button Content="{x:Static res:Strings.OpenLogs}" Width="90" Margin="2"
                        Command="{Binding OpenLogsCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.OpenLogs}"
                        AutomationProperties.AutomationId="OpenLogsButton"
                        TabIndex="11"/>
                <Button Content="{x:Static res:Strings.OpenConfigFiles}" Width="120" Margin="2"
                        Command="{Binding OpenConfigsCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.OpenConfigFiles}"
                        AutomationProperties.AutomationId="OpenConfigFilesButton"
                        TabIndex="12"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="3" Header="{x:Static res:Strings.ConsolePreview}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0">
                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                             AutomationProperties.Name="Console preview output"
                             AutomationProperties.AutomationId="ConsolePreviewTextBox"
                             AutomationProperties.LiveSetting="Polite"
                             TabIndex="20"/>
                </ScrollViewer>
                <Button Grid.Row="1" Content="{x:Static res:Strings.OpenFullConsole}" HorizontalAlignment="Right" Margin="5"
                        Command="{Binding OpenFullConsoleCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.OpenFullConsole}"
                        AutomationProperties.AutomationId="OpenFullConsoleButton"
                        TabIndex="90"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
