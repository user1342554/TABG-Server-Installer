<UserControl x:Class="TabgInstaller.Gui.Tabs.MatchSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">

                <!-- Match Mode -->
                <TextBlock Text="Match Mode" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Loadout Mode" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbLoadoutMode" Grid.Column="1" Width="200" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Normal"/>
                        <ComboBoxItem Content="GunGame"/>
                        <ComboBoxItem Content="ReverseGunGame"/>
                        <ComboBoxItem Content="KeepInventory"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Win Condition" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbWinCondition" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                              SelectionChanged="CmbWinCondition_SelectionChanged">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="KillsToWin"/>
                        <ComboBoxItem Content="Debug"/>
                    </ComboBox>
                </Grid>

                <Grid x:Name="KillsToWinRow" Margin="0,2" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kills To Win" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtKillsToWin" Grid.Column="1" Width="100" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Force Kill At Start" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkForceKillAtStart" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Heal On Kill" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox x:Name="ChkHealOnKill" VerticalAlignment="Center"/>
                        <TextBlock Text="Heal Amount %:" Margin="16,0,4,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtHealOnKillAmount" Width="60"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Drop Items On Death" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkDropItemsOnDeath" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Can Go Down" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkCanGoDown" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Can Lock Out" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkCanLockOut" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>

                <!-- Vote Settings -->
                <GroupBox Header="Vote Settings" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Percent Of Votes" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPercentOfVotes" Grid.Column="1" Width="100" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Min Players" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMinPlayers" Grid.Column="1" Width="100" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time To Start (seconds)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTimeToStart" Grid.Column="1" Width="100" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Spell Drops -->
                <GroupBox Header="Spell Drops" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Enabled" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkSpelldropEnabled" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Min Delay (seconds)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMinSpellDropDelay" Grid.Column="1" Width="100" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max Delay (seconds)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMaxSpellDropDelay" Grid.Column="1" Width="100" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="First Drop Offset (seconds)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSpellDropOffset" Grid.Column="1" Width="100" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Timeouts -->
                <GroupBox Header="Timeouts" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pre-Match Timeout (minutes)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPreMatchTimeout" Grid.Column="1" Width="100" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Match Timeout (minutes)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPeriMatchTimeout" Grid.Column="1" Width="100" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,4,4">
            <Button Content="Save" Width="100" Click="SaveButton_Click"/>
            <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
