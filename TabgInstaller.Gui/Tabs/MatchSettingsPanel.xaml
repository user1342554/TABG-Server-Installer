<UserControl x:Class="TabgInstaller.Gui.Tabs.MatchSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <Grid Margin="8" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">

                <!-- Match Mode -->
                <TextBlock Text="{x:Static res:Strings.MatchMode}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LoadoutModeLabel" Text="{x:Static res:Strings.LoadoutMode}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left"
                              SelectedValue="{Binding LoadoutMode, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              AutomationProperties.LabeledBy="{Binding ElementName=LoadoutModeLabel}"
                              AutomationProperties.AutomationId="LoadoutModeComboBox"
                              TabIndex="10">
                        <ComboBoxItem Content="Normal"/>
                        <ComboBoxItem Content="GunGame"/>
                        <ComboBoxItem Content="ReverseGunGame"/>
                        <ComboBoxItem Content="KeepInventory"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="WinConditionLabel" Text="{x:Static res:Strings.WinCondition}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left"
                              SelectedValue="{Binding WinCondition, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              AutomationProperties.LabeledBy="{Binding ElementName=WinConditionLabel}"
                              AutomationProperties.AutomationId="WinConditionComboBox"
                              TabIndex="11">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="KillsToWin"/>
                        <ComboBoxItem Content="Debug"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,2" Visibility="{Binding ShowKillsToWin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="KillsToWinLabel" Text="{x:Static res:Strings.KillsToWinLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                             Text="{Binding KillsToWin, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=KillsToWinLabel}"
                             AutomationProperties.AutomationId="KillsToWinTextBox"
                             TabIndex="12"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.ForceKillAtStart}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding ForceKillAtStart}"
                              AutomationProperties.Name="{x:Static res:Strings.ForceKillAtStart}"
                              AutomationProperties.AutomationId="ForceKillAtStartCheckBox"
                              TabIndex="13"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.HealOnKill}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox VerticalAlignment="Center"
                                  IsChecked="{Binding HealOnKill}"
                                  AutomationProperties.Name="{x:Static res:Strings.HealOnKill}"
                                  AutomationProperties.AutomationId="HealOnKillCheckBox"
                                  TabIndex="14"/>
                        <TextBlock x:Name="HealAmountLabel" Text="{x:Static res:Strings.HealAmountPercent}" Margin="16,0,4,0" VerticalAlignment="Center"/>
                        <TextBox Width="60"
                                 Text="{Binding HealOnKillAmount, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=HealAmountLabel}"
                                 AutomationProperties.AutomationId="HealOnKillAmountTextBox"
                                 TabIndex="15"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.DropItemsOnDeath}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding DropItemsOnDeath}"
                              AutomationProperties.Name="{x:Static res:Strings.DropItemsOnDeath}"
                              AutomationProperties.AutomationId="DropItemsOnDeathCheckBox"
                              TabIndex="16"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.CanGoDown}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding CanGoDown}"
                              AutomationProperties.Name="{x:Static res:Strings.CanGoDown}"
                              AutomationProperties.AutomationId="CanGoDownCheckBox"
                              TabIndex="17"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.CanLockOut}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding CanLockOut}"
                              AutomationProperties.Name="{x:Static res:Strings.CanLockOut}"
                              AutomationProperties.AutomationId="CanLockOutCheckBox"
                              TabIndex="18"/>
                </Grid>

                <!-- Vote Settings -->
                <GroupBox Header="{x:Static res:Strings.VoteSettings}" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PercentOfVotesLabel" Text="{x:Static res:Strings.PercentOfVotes}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding PercentOfVotes, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=PercentOfVotesLabel}"
                                     AutomationProperties.AutomationId="PercentOfVotesTextBox"
                                     TabIndex="30"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MinPlayersLabel" Text="{x:Static res:Strings.MinPlayers}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding MinPlayers, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=MinPlayersLabel}"
                                     AutomationProperties.AutomationId="MinPlayersTextBox"
                                     TabIndex="31"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TimeToStartLabel" Text="{x:Static res:Strings.TimeToStartSeconds}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding TimeToStart, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=TimeToStartLabel}"
                                     AutomationProperties.AutomationId="TimeToStartTextBox"
                                     TabIndex="32"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Spell Drops -->
                <GroupBox Header="{x:Static res:Strings.SpellDrops}" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Enabled}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding SpelldropEnabled}"
                                      AutomationProperties.Name="Spell drops enabled"
                                      AutomationProperties.AutomationId="SpellDropEnabledCheckBox"
                                      TabIndex="40"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MinSpellDelayLabel" Text="{x:Static res:Strings.MinDelaySeconds}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding MinSpellDropDelay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=MinSpellDelayLabel}"
                                     AutomationProperties.AutomationId="MinSpellDropDelayTextBox"
                                     TabIndex="41"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MaxSpellDelayLabel" Text="{x:Static res:Strings.MaxDelaySeconds}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding MaxSpellDropDelay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=MaxSpellDelayLabel}"
                                     AutomationProperties.AutomationId="MaxSpellDropDelayTextBox"
                                     TabIndex="42"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SpellDropOffsetLabel" Text="{x:Static res:Strings.FirstDropOffsetSeconds}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding SpellDropOffset, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=SpellDropOffsetLabel}"
                                     AutomationProperties.AutomationId="SpellDropOffsetTextBox"
                                     TabIndex="43"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Timeouts -->
                <GroupBox Header="{x:Static res:Strings.Timeouts}" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PreMatchTimeoutLabel" Text="{x:Static res:Strings.PreMatchTimeoutMinutes}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding PreMatchTimeout, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=PreMatchTimeoutLabel}"
                                     AutomationProperties.AutomationId="PreMatchTimeoutTextBox"
                                     TabIndex="50"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MatchTimeoutLabel" Text="{x:Static res:Strings.MatchTimeoutMinutes}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding PeriMatchTimeout, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=MatchTimeoutLabel}"
                                     AutomationProperties.AutomationId="MatchTimeoutTextBox"
                                     TabIndex="51"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,4,4">
            <Button Content="{x:Static res:Strings.Save}" Width="100" Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Save}"
                    AutomationProperties.AutomationId="MatchSettingsSaveButton"
                    TabIndex="90"/>
            <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
