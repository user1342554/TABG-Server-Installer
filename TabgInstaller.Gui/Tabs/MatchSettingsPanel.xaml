<UserControl x:Class="TabgInstaller.Gui.Tabs.MatchSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">

                <!-- Match Mode -->
                <TextBlock Text="Match Mode" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Loadout Mode" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left"
                              SelectedValue="{Binding LoadoutMode, Mode=TwoWay}"
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="Normal"/>
                        <ComboBoxItem Content="GunGame"/>
                        <ComboBoxItem Content="ReverseGunGame"/>
                        <ComboBoxItem Content="KeepInventory"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Win Condition" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left"
                              SelectedValue="{Binding WinCondition, Mode=TwoWay}"
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="KillsToWin"/>
                        <ComboBoxItem Content="Debug"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,2" Visibility="{Binding ShowKillsToWin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kills To Win" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                             Text="{Binding KillsToWin, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Force Kill At Start" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding ForceKillAtStart}"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Heal On Kill" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox VerticalAlignment="Center"
                                  IsChecked="{Binding HealOnKill}"/>
                        <TextBlock Text="Heal Amount %:" Margin="16,0,4,0" VerticalAlignment="Center"/>
                        <TextBox Width="60"
                                 Text="{Binding HealOnKillAmount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Drop Items On Death" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding DropItemsOnDeath}"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Can Go Down" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding CanGoDown}"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Can Lock Out" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding CanLockOut}"/>
                </Grid>

                <!-- Vote Settings -->
                <GroupBox Header="Vote Settings" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Percent Of Votes" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding PercentOfVotes, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Min Players" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding MinPlayers, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time To Start (seconds)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding TimeToStart, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Spell Drops -->
                <GroupBox Header="Spell Drops" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Enabled" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding SpelldropEnabled}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Min Delay (seconds)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding MinSpellDropDelay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max Delay (seconds)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding MaxSpellDropDelay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="First Drop Offset (seconds)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding SpellDropOffset, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Timeouts -->
                <GroupBox Header="Timeouts" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pre-Match Timeout (minutes)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding PreMatchTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Match Timeout (minutes)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding PeriMatchTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,4,4">
            <Button Content="Save" Width="100" Command="{Binding SaveCommand}"/>
            <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
