<UserControl x:Class="TabgInstaller.Gui.Tabs.ConsolePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button x:Name="StartButton" Content="Start Server" Width="100" Margin="2" Click="StartButton_Click"/>
            <Button x:Name="StopButton" Content="Stop Server" Width="100" Margin="2" Click="StopButton_Click" IsEnabled="False"/>
            <Button Content="Clear Console" Width="100" Margin="2" Click="ClearConsole_Click"/>
            <Button Content="Quick-save &amp; Restart" Width="140" Margin="2" Click="QuickSaveRestart_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="ConsoleScrollViewer" Margin="5,0,5,0">
            <TextBox x:Name="ConsoleTextBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtCommand" Grid.Column="0" KeyDown="TxtCommand_KeyDown" VerticalContentAlignment="Center"/>
            <Button Content="Send" Grid.Column="1" Width="60" Margin="5,0,0,0" Click="SendCommand_Click"/>
        </Grid>
    </Grid>
</UserControl>
