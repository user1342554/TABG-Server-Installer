<UserControl x:Class="TabgInstaller.Gui.Tabs.ConsolePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:TabgInstaller.Core.Model;assembly=TabgInstaller.Core"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <UserControl.Resources>
        <CollectionViewSource x:Key="LogViewSource" Filter="LogViewSource_Filter"/>
    </UserControl.Resources>
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Toolbar -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Content="{x:Static res:Strings.StartServer}" Width="100" Margin="2"
                    Command="{Binding StartCommand}"
                    IsEnabled="{Binding IsServerNotRunning}"
                    AutomationProperties.Name="{x:Static res:Strings.StartServer}"
                    AutomationProperties.AutomationId="ConsoleStartServerButton"
                    TabIndex="0"/>
            <Button Content="{x:Static res:Strings.StopServer}" Width="100" Margin="2"
                    Command="{Binding StopCommand}"
                    IsEnabled="{Binding IsServerRunning}"
                    AutomationProperties.Name="{x:Static res:Strings.StopServer}"
                    AutomationProperties.AutomationId="ConsoleStopServerButton"
                    TabIndex="1"/>
            <Button Content="{x:Static res:Strings.ClearConsole}" Width="100" Margin="2"
                    Command="{Binding ClearConsoleCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.ClearConsole}"
                    AutomationProperties.AutomationId="ClearConsoleButton"
                    TabIndex="2"/>
            <Button Content="{x:Static res:Strings.QuickSaveRestart}" Width="140" Margin="2"
                    Command="{Binding QuickSaveRestartCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.QuickSaveRestart}"
                    AutomationProperties.AutomationId="QuickSaveRestartButton"
                    TabIndex="3"/>

            <!-- Separator -->
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2,6,2"/>

            <!-- Severity filter toggles -->
            <ToggleButton x:Name="ToggleInfo" IsChecked="True" Margin="2" Padding="6,2"
                          Click="SeverityToggle_Click"
                          AutomationProperties.Name="Filter Info messages"
                          AutomationProperties.AutomationId="ToggleInfoFilter"
                          TabIndex="4"/>
            <ToggleButton x:Name="ToggleWarn" IsChecked="True" Margin="2" Padding="6,2"
                          Click="SeverityToggle_Click"
                          AutomationProperties.Name="Filter Warning messages"
                          AutomationProperties.AutomationId="ToggleWarnFilter"
                          TabIndex="5"/>
            <ToggleButton x:Name="ToggleError" IsChecked="True" Margin="2" Padding="6,2"
                          Click="SeverityToggle_Click"
                          AutomationProperties.Name="Filter Error messages"
                          AutomationProperties.AutomationId="ToggleErrorFilter"
                          TabIndex="6"/>

            <!-- Separator -->
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2,6,2"/>

            <!-- Search -->
            <Grid Margin="2" Width="180">
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Padding="4,2"
                         TextChanged="SearchBox_TextChanged"
                         AutomationProperties.Name="Search console logs"
                         AutomationProperties.AutomationId="ConsoleSearchTextBox"
                         TabIndex="7"/>
                <TextBlock x:Name="SearchPlaceholder" Text="{x:Static res:Strings.SearchLogs}" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid>

            <!-- Export -->
            <Button Content="{x:Static res:Strings.Export}" Width="60" Margin="2" Padding="4,2" Click="ExportButton_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Export}"
                    AutomationProperties.AutomationId="ExportConsoleButton"
                    TabIndex="8"/>
        </WrapPanel>

        <!-- Row 1: Log list -->
        <ListBox Grid.Row="1" x:Name="LogListBox" Margin="5,0,5,0"
                 ItemsSource="{Binding Source={StaticResource LogViewSource}}"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 VirtualizingStackPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True"
                 Background="{DynamicResource ConsoleBgBrush}" BorderThickness="1" BorderBrush="{DynamicResource ConsoleBorderBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch"
                 AutomationProperties.Name="Console output"
                 AutomationProperties.AutomationId="ConsoleLogListBox"
                 AutomationProperties.LiveSetting="Polite"
                 TabIndex="10">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type model:LogEntry}">
                    <StackPanel Orientation="Horizontal" Margin="2,1">
                        <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="MessageText" Text="{Binding Message}"
                                   FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Info">
                            <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource ConsoleFgBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                            <Setter TargetName="MessageText" Property="Foreground" Value="#D48806"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                            <Setter TargetName="MessageText" Property="Foreground" Value="#CF1322"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Row 2: Command input -->
        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtCommand" Grid.Column="0" KeyDown="TxtCommand_KeyDown"
                     Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="Command input"
                     AutomationProperties.AutomationId="ConsoleCommandTextBox"
                     TabIndex="90"/>
            <Button Content="{x:Static res:Strings.Send}" Grid.Column="1" Width="60" Margin="5,0,0,0"
                    Command="{Binding SendCommandCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Send}"
                    AutomationProperties.AutomationId="SendCommandButton"
                    TabIndex="91"/>
        </Grid>
    </Grid>
</UserControl>
