<UserControl x:Class="TabgInstaller.Gui.Tabs.ConsolePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:TabgInstaller.Core.Model;assembly=TabgInstaller.Core">
    <UserControl.Resources>
        <CollectionViewSource x:Key="LogViewSource" Filter="LogViewSource_Filter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Toolbar -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button x:Name="StartButton" Content="Start Server" Width="100" Margin="2" Click="StartButton_Click"/>
            <Button x:Name="StopButton" Content="Stop Server" Width="100" Margin="2" Click="StopButton_Click" IsEnabled="False"/>
            <Button Content="Clear Console" Width="100" Margin="2" Click="ClearConsole_Click"/>
            <Button Content="Quick-save &amp; Restart" Width="140" Margin="2" Click="QuickSaveRestart_Click"/>

            <!-- Separator -->
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2,6,2"/>

            <!-- Severity filter toggles -->
            <ToggleButton x:Name="ToggleInfo" Content="&#x2139; Info" IsChecked="True" Margin="2" Padding="6,2"
                          Click="SeverityToggle_Click"/>
            <ToggleButton x:Name="ToggleWarn" Content="&#x26A0; Warn" IsChecked="True" Margin="2" Padding="6,2"
                          Click="SeverityToggle_Click"/>
            <ToggleButton x:Name="ToggleError" Content="&#x2716; Error" IsChecked="True" Margin="2" Padding="6,2"
                          Click="SeverityToggle_Click"/>

            <!-- Separator -->
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2,6,2"/>

            <!-- Search -->
            <Grid Margin="2" Width="180">
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Padding="4,2"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchPlaceholder" Text="Search logs..." IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#888"/>
            </Grid>

            <!-- Export -->
            <Button Content="Export" Width="60" Margin="2" Padding="4,2" Click="ExportButton_Click"/>
        </WrapPanel>

        <!-- Row 1: Log list -->
        <ListBox Grid.Row="1" x:Name="LogListBox" Margin="5,0,5,0"
                 ItemsSource="{Binding Source={StaticResource LogViewSource}}"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 VirtualizingStackPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True"
                 Background="#1E1E1E" BorderThickness="1" BorderBrush="#333"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type model:LogEntry}">
                    <StackPanel Orientation="Horizontal" Margin="2,1">
                        <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="#888" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="MessageText" Text="{Binding Message}"
                                   FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Info">
                            <Setter TargetName="MessageText" Property="Foreground" Value="#CCCCCC"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                            <Setter TargetName="MessageText" Property="Foreground" Value="#D48806"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                            <Setter TargetName="MessageText" Property="Foreground" Value="#CF1322"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Row 2: Command input -->
        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtCommand" Grid.Column="0" KeyDown="TxtCommand_KeyDown" VerticalContentAlignment="Center"/>
            <Button Content="Send" Grid.Column="1" Width="60" Margin="5,0,0,0" Click="SendCommand_Click"/>
        </Grid>
    </Grid>
</UserControl>
