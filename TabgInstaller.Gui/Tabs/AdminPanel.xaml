<UserControl x:Class="TabgInstaller.Gui.Tabs.AdminPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <Grid Margin="8" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Admin List -->
        <GroupBox Grid.Row="0" Header="{x:Static res:Strings.ServerAdmins}" Margin="0,0,0,8">
            <ListView x:Name="AdminListView" ItemsSource="{Binding Admins}" SelectionMode="Single"
                      AutomationProperties.Name="Server administrators list"
                      AutomationProperties.AutomationId="AdminListView"
                      TabIndex="10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{x:Static res:Strings.Name}" Width="250" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="{x:Static res:Strings.PermLevel}" Width="100" DisplayMemberBinding="{Binding PermLevel}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <!-- Add Admin -->
        <GroupBox Grid.Row="1" Header="{x:Static res:Strings.AddAdmin}" Margin="0,0,0,8">
            <StackPanel Margin="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="PlayerLabel" Grid.Column="0" Content="{x:Static res:Strings.Player}"/>
                    <ComboBox Grid.Column="1" x:Name="CmbPlayerName"
                              IsEditable="True" Margin="2"
                              IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                              ItemsSource="{Binding KnownPlayerNames}"
                              Text="{Binding SelectedPlayerName, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.LabeledBy="{Binding ElementName=PlayerLabel}"
                              AutomationProperties.AutomationId="PlayerNameComboBox"
                              TabIndex="20"/>
                    <Label x:Name="LevelLabel" Grid.Column="2" Content="{x:Static res:Strings.Level}"/>
                    <ComboBox Grid.Column="3" x:Name="CmbPermLevel" Margin="2"
                              SelectedIndex="{Binding SelectedPermLevel}"
                              AutomationProperties.LabeledBy="{Binding ElementName=LevelLabel}"
                              AutomationProperties.AutomationId="PermLevelComboBox"
                              TabIndex="21">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                    </ComboBox>
                    <Button Grid.Column="4" Content="{x:Static res:Strings.Add}" Width="60" Margin="4,2,2,2"
                            Command="{Binding AddAdminCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.Add}"
                            AutomationProperties.AutomationId="AddAdminButton"
                            TabIndex="22"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="4,4,4,0">
                    <Button Content="{x:Static res:Strings.RefreshPlayers}" Margin="0,0,8,0" Padding="8,2"
                            Command="{Binding RefreshPlayersCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.RefreshPlayers}"
                            AutomationProperties.AutomationId="RefreshPlayersButton"
                            TabIndex="23"/>
                    <TextBlock Foreground="Gray" FontSize="11" VerticalAlignment="Center"
                               Text="{x:Static res:Strings.ScanGuestbooks}"/>
                </StackPanel>

                <!-- Manual Epic ID fallback -->
                <Expander Header="{x:Static res:Strings.ManualEntry}" Margin="4,6,4,0" FontSize="11"
                          AutomationProperties.AutomationId="ManualEntryExpander"
                          TabIndex="30">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="ManualNameLabel" Grid.Column="0" Content="{x:Static res:Strings.NameLabel}" FontSize="11"/>
                        <TextBox Grid.Column="1" Margin="2" FontSize="11"
                                 Text="{Binding ManualName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ManualNameLabel}"
                                 AutomationProperties.AutomationId="ManualNameTextBox"
                                 TabIndex="31"/>
                        <Label x:Name="ManualEpicIdLabel" Grid.Column="2" Content="{x:Static res:Strings.EpicIdLabel}" FontSize="11"/>
                        <TextBox Grid.Column="3" Margin="2" FontSize="11"
                                 Text="{Binding ManualEpicId, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ManualEpicIdLabel}"
                                 AutomationProperties.AutomationId="ManualEpicIdTextBox"
                                 TabIndex="32"/>
                        <Label x:Name="ManualLevelLabel" Grid.Column="4" Content="{x:Static res:Strings.Level}" FontSize="11"/>
                        <ComboBox Grid.Column="5" Margin="2" FontSize="11"
                                  SelectedIndex="{Binding ManualPermLevel}"
                                  AutomationProperties.LabeledBy="{Binding ElementName=ManualLevelLabel}"
                                  AutomationProperties.AutomationId="ManualPermLevelComboBox"
                                  TabIndex="33">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                        </ComboBox>
                        <Button Grid.Column="6" Content="{x:Static res:Strings.Add}" Width="60" Margin="4,2,2,2" FontSize="11"
                                Command="{Binding AddManualAdminCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Add}"
                                AutomationProperties.AutomationId="AddManualAdminButton"
                                TabIndex="34"/>
                    </Grid>
                </Expander>
            </StackPanel>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="{x:Static res:Strings.RemoveSelected}" Width="120" Margin="2"
                    Command="{Binding RemoveAdminCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=AdminListView}"
                    AutomationProperties.Name="{x:Static res:Strings.RemoveSelected}"
                    AutomationProperties.AutomationId="RemoveAdminButton"
                    TabIndex="90"/>
            <Button Content="{x:Static res:Strings.Save}" Width="80" Margin="2" Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Save}"
                    AutomationProperties.AutomationId="SaveAdminsButton"
                    TabIndex="91"/>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray"
                       Text="{Binding StatusText}"/>
        </StackPanel>
    </Grid>
</UserControl>
