<UserControl x:Class="TabgInstaller.Gui.Tabs.AdminPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Admin List -->
        <GroupBox Grid.Row="0" Header="Server Admins" Margin="0,0,0,8">
            <ListView x:Name="LstAdmins" SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="250" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Perm Level" Width="100" DisplayMemberBinding="{Binding PermLevel}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <!-- Add Admin -->
        <GroupBox Grid.Row="1" Header="Add Admin" Margin="0,0,0,8">
            <StackPanel Margin="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Player:"/>
                    <ComboBox Grid.Column="1" x:Name="CmbPlayerName" IsEditable="True" Margin="2"
                              IsTextSearchEnabled="True" StaysOpenOnEdit="True"/>
                    <Label Grid.Column="2" Content="Level:"/>
                    <ComboBox Grid.Column="3" x:Name="CmbPermLevel" Margin="2" SelectedIndex="3">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                    </ComboBox>
                    <Button Grid.Column="4" Content="Add" Width="60" Margin="4,2,2,2" Click="AddAdmin_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="4,4,4,0">
                    <Button Content="Refresh Players" Margin="0,0,8,0" Padding="8,2" Click="RefreshPlayers_Click"/>
                    <TextBlock Foreground="Gray" FontSize="11" VerticalAlignment="Center"
                               Text="Scans all server Guestbooks for known players"/>
                </StackPanel>

                <!-- Manual Epic ID fallback -->
                <Expander Header="Manual entry (player not in list)" Margin="4,6,4,0" FontSize="11">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Name:" FontSize="11"/>
                        <TextBox Grid.Column="1" x:Name="TxtManualName" Margin="2" FontSize="11"/>
                        <Label Grid.Column="2" Content="Epic ID:" FontSize="11"/>
                        <TextBox Grid.Column="3" x:Name="TxtManualEpicId" Margin="2" FontSize="11"/>
                        <Label Grid.Column="4" Content="Level:" FontSize="11"/>
                        <ComboBox Grid.Column="5" x:Name="CmbManualPermLevel" Margin="2" SelectedIndex="3" FontSize="11">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                        </ComboBox>
                        <Button Grid.Column="6" Content="Add" Width="60" Margin="4,2,2,2" Click="AddManualAdmin_Click" FontSize="11"/>
                    </Grid>
                </Expander>
            </StackPanel>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Remove Selected" Width="120" Margin="2" Click="RemoveAdmin_Click"/>
            <Button Content="Save" Width="80" Margin="2" Click="Save_Click"/>
            <TextBlock x:Name="TxtStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</UserControl>
