<UserControl x:Class="TabgInstaller.Gui.Tabs.AdminPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Admin List -->
        <GroupBox Grid.Row="0" Header="Server Admins" Margin="0,0,0,8">
            <ListView x:Name="LstAdmins" SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="160" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Epic ID" Width="300" DisplayMemberBinding="{Binding EpicId}"/>
                        <GridViewColumn Header="Perm Level" Width="80" DisplayMemberBinding="{Binding PermLevel}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <!-- Add / Edit -->
        <GroupBox Grid.Row="1" Header="Add Admin" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Name:"/>
                <TextBox Grid.Column="1" x:Name="TxtName" Margin="2"/>
                <Label Grid.Column="2" Content="Epic ID:"/>
                <TextBox Grid.Column="3" x:Name="TxtEpicId" Margin="2"/>
                <Label Grid.Column="4" Content="Level:"/>
                <ComboBox Grid.Column="5" x:Name="CmbPermLevel" Margin="2" SelectedIndex="3">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                </ComboBox>
                <Button Grid.Column="6" Content="Add" Width="60" Margin="4,2,2,2" Click="AddAdmin_Click"/>
            </Grid>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Remove Selected" Width="120" Margin="2" Click="RemoveAdmin_Click"/>
            <Button Content="Save" Width="80" Margin="2" Click="Save_Click"/>
            <TextBlock x:Name="TxtStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</UserControl>
