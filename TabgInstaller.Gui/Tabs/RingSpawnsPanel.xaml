<UserControl x:Class="TabgInstaller.Gui.Tabs.RingSpawnsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">

                <!-- Location Picker -->
                <GroupBox Header="Location Picker" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Location" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbLocation" Grid.Column="1"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="CmbLocation_SelectionChanged"/>
                            <Button Content="Apply Location" Grid.Column="2" Margin="8,0,0,0"
                                    Width="120" Click="ApplyLocation_Click"/>
                        </Grid>
                        <TextBlock x:Name="TxtLocationInfo" Margin="0,4,0,0" Foreground="Gray" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Ring Settings -->
                <GroupBox Header="Ring Settings" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ring Sizes (3 values)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtRingSizes" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ring Speeds (3 values)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtRingSpeeds" Grid.Column="1"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="No Closing (Deathmatch)" Width="180" Click="PresetDeathmatch_Click"/>
                            <Button Content="Standard BR" Width="120" Margin="8,0,0,0" Click="PresetStandardBR_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Lobby Spawn -->
                <GroupBox Header="Lobby Spawn" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Custom Spawn Point (x,y,z)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCustomSpawnPoint" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Use Custom Spawn" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkUseCustomSpawn" Grid.Column="1" VerticalAlignment="Center"
                                      Checked="ChkUseCustomSpawn_Changed" Unchecked="ChkUseCustomSpawn_Changed"/>
                        </Grid>
                        <TextBlock x:Name="TxtSpawnInfo" Margin="0,4,0,0" Foreground="Gray" FontSize="11"
                                   Text="When checked, ValidSpawnPoints is set to 6 (custom)."/>
                    </StackPanel>
                </GroupBox>

                <!-- Match Spawns -->
                <GroupBox Header="Match Spawns" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Spawn Coordinates (one x,z per line):" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMatchSpawns" Height="160" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                 TextChanged="TxtMatchSpawns_TextChanged"/>
                        <TextBlock x:Name="TxtSpawnCount" Margin="0,4,0,0" Foreground="Gray" FontSize="11"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,4,4">
            <Button Content="Save" Width="100" Click="SaveButton_Click"/>
            <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
