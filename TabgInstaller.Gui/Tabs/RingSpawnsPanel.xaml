<UserControl x:Class="TabgInstaller.Gui.Tabs.RingSpawnsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <Grid Margin="8" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">

                <!-- Location Picker -->
                <GroupBox Header="{x:Static res:Strings.LocationPicker}" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LocationLabel" Text="{x:Static res:Strings.Location}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SpawnLocations}"
                                      SelectedItem="{Binding SelectedSpawnLocation, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LocationLabel}"
                                      AutomationProperties.AutomationId="SpawnLocationComboBox"
                                      TabIndex="10"/>
                            <Button Content="{x:Static res:Strings.ApplyLocation}" Grid.Column="2" Margin="8,0,0,0"
                                    Width="120" Command="{Binding ApplyLocationCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.ApplyLocation}"
                                    AutomationProperties.AutomationId="ApplyLocationButton"
                                    TabIndex="11"/>
                        </Grid>
                        <TextBlock Margin="0,4,0,0" Foreground="Gray" FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding LocationInfo}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Ring Settings -->
                <GroupBox Header="{x:Static res:Strings.RingSettings}" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RingSizesLabel" Text="{x:Static res:Strings.RingSizes}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding RingSizes, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=RingSizesLabel}"
                                     AutomationProperties.AutomationId="RingSizesTextBox"
                                     TabIndex="20"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RingSpeedsLabel" Text="{x:Static res:Strings.RingSpeeds}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding RingSpeeds, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=RingSpeedsLabel}"
                                     AutomationProperties.AutomationId="RingSpeedsTextBox"
                                     TabIndex="21"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{x:Static res:Strings.NoClosingDeathmatch}" Width="180"
                                    Command="{Binding PresetDeathmatchCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.NoClosingDeathmatch}"
                                    AutomationProperties.AutomationId="PresetDeathmatchButton"
                                    TabIndex="22"/>
                            <Button Content="{x:Static res:Strings.StandardBR}" Width="120" Margin="8,0,0,0"
                                    Command="{Binding PresetStandardBRCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.StandardBR}"
                                    AutomationProperties.AutomationId="PresetStandardBRButton"
                                    TabIndex="23"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Lobby Spawn -->
                <GroupBox Header="{x:Static res:Strings.LobbySpawn}" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CustomSpawnPointLabel" Text="{x:Static res:Strings.CustomSpawnPoint}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedLocation, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=CustomSpawnPointLabel}"
                                     AutomationProperties.AutomationId="CustomSpawnPointTextBox"
                                     TabIndex="30"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.UseCustomSpawn}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding UseCustomSpawn}"
                                      AutomationProperties.Name="{x:Static res:Strings.UseCustomSpawn}"
                                      AutomationProperties.AutomationId="UseCustomSpawnCheckBox"
                                      TabIndex="31"/>
                        </Grid>
                        <TextBlock Margin="0,4,0,0" Foreground="Gray" FontSize="11"
                                   Text="{Binding SpawnInfo}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Match Spawns -->
                <GroupBox Header="{x:Static res:Strings.MatchSpawns}" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SpawnCoordinates}" Margin="0,0,0,4"/>
                        <TextBox Height="160" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                 Text="{Binding MatchSpawns, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Match spawn coordinates"
                                 AutomationProperties.AutomationId="MatchSpawnsTextBox"
                                 TabIndex="40"/>
                        <TextBlock Margin="0,4,0,0" Foreground="Gray" FontSize="11"
                                   Text="{Binding SpawnCountText}"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,4,4">
            <Button Content="{x:Static res:Strings.Save}" Width="100" Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Save}"
                    AutomationProperties.AutomationId="RingSpawnsSaveButton"
                    TabIndex="90"/>
            <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
