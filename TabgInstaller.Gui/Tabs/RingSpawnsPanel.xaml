<UserControl x:Class="TabgInstaller.Gui.Tabs.RingSpawnsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">

                <!-- Location Picker -->
                <GroupBox Header="Location Picker" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Location" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SpawnLocations}"
                                      SelectedItem="{Binding SelectedSpawnLocation, Mode=TwoWay}"
                                      DisplayMemberPath="Name"/>
                            <Button Content="Apply Location" Grid.Column="2" Margin="8,0,0,0"
                                    Width="120" Command="{Binding ApplyLocationCommand}"/>
                        </Grid>
                        <TextBlock Margin="0,4,0,0" Foreground="Gray" FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding LocationInfo}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Ring Settings -->
                <GroupBox Header="Ring Settings" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ring Sizes (3 values)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding RingSizes, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ring Speeds (3 values)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding RingSpeeds, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="No Closing (Deathmatch)" Width="180"
                                    Command="{Binding PresetDeathmatchCommand}"/>
                            <Button Content="Standard BR" Width="120" Margin="8,0,0,0"
                                    Command="{Binding PresetStandardBRCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Lobby Spawn -->
                <GroupBox Header="Lobby Spawn" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Custom Spawn Point (x,y,z)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedLocation, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Use Custom Spawn" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding UseCustomSpawn}"/>
                        </Grid>
                        <TextBlock Margin="0,4,0,0" Foreground="Gray" FontSize="11"
                                   Text="{Binding SpawnInfo}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Match Spawns -->
                <GroupBox Header="Match Spawns" Margin="0,12,0,0" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Spawn Coordinates (one x,z per line):" Margin="0,0,0,4"/>
                        <TextBox Height="160" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                 Text="{Binding MatchSpawns, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="0,4,0,0" Foreground="Gray" FontSize="11"
                                   Text="{Binding SpawnCountText}"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,4,4">
            <Button Content="Save" Width="100" Command="{Binding SaveCommand}"/>
            <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
