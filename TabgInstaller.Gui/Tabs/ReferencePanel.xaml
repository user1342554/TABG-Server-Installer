<UserControl x:Class="TabgInstaller.Gui.Tabs.ReferencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="5">
            <Button Content="Commands" Width="90" Margin="2" Command="{Binding ShowCommandsCommand}"/>
            <Button Content="Item IDs" Width="90" Margin="2" Command="{Binding ShowItemsCommand}"/>
            <Button Content="Loadouts" Width="90" Margin="2" Command="{Binding ShowLoadoutsCommand}"/>
            <Button Content="Spawn Locations" Width="110" Margin="2" Command="{Binding ShowSpawnsCommand}"/>
            <Button Content="Match Settings Guide" Width="130" Margin="2" Command="{Binding ShowMatchSettingsCommand}"/>
        </StackPanel>
        <TextBox Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                 Margin="5" AcceptsReturn="True"
                 Text="{Binding ReferenceText, Mode=OneWay}"/>
    </Grid>
</UserControl>
