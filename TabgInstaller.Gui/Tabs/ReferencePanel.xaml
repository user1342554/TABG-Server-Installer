<UserControl x:Class="TabgInstaller.Gui.Tabs.ReferencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="5">
            <Button Content="{x:Static res:Strings.Commands}" Width="90" Margin="2" Command="{Binding ShowCommandsCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Commands}"
                    AutomationProperties.AutomationId="ShowCommandsButton"
                    TabIndex="0"/>
            <Button Content="{x:Static res:Strings.ItemIDs}" Width="90" Margin="2" Command="{Binding ShowItemsCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.ItemIDs}"
                    AutomationProperties.AutomationId="ShowItemIDsButton"
                    TabIndex="1"/>
            <Button Content="{x:Static res:Strings.Loadouts}" Width="90" Margin="2" Command="{Binding ShowLoadoutsCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Loadouts}"
                    AutomationProperties.AutomationId="ShowLoadoutsButton"
                    TabIndex="2"/>
            <Button Content="{x:Static res:Strings.SpawnLocations}" Width="110" Margin="2" Command="{Binding ShowSpawnsCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.SpawnLocations}"
                    AutomationProperties.AutomationId="ShowSpawnLocationsButton"
                    TabIndex="3"/>
            <Button Content="{x:Static res:Strings.MatchSettingsGuide}" Width="130" Margin="2" Command="{Binding ShowMatchSettingsCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.MatchSettingsGuide}"
                    AutomationProperties.AutomationId="ShowMatchSettingsGuideButton"
                    TabIndex="4"/>
        </StackPanel>
        <TextBox Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                 Margin="5" AcceptsReturn="True"
                 Text="{Binding ReferenceText, Mode=OneWay}"
                 AutomationProperties.Name="Reference text output"
                 AutomationProperties.AutomationId="ReferenceTextBox"
                 TabIndex="10"/>
    </Grid>
</UserControl>
