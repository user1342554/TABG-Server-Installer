<UserControl x:Class="TabgInstaller.Gui.Tabs.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources"
             xmlns:local="clr-namespace:TabgInstaller.Gui.Tabs"
             KeyboardNavigation.TabNavigation="Cycle">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Language -->
            <GroupBox Header="{x:Static res:Strings.Language}" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="NativeName"
                              Width="200" HorizontalAlignment="Left"
                              TabIndex="0"
                              AutomationProperties.Name="{x:Static res:Strings.Language}"
                              AutomationProperties.HelpText="{x:Static res:Tooltips.LanguageHelp}"
                              AutomationProperties.AutomationId="LanguageComboBox"/>
                    <TextBlock Text="{Binding RestartMessage}" Foreground="OrangeRed"
                               Margin="0,4,0,0" FontStyle="Italic"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </GroupBox>

            <!-- Paths -->
            <GroupBox Header="{x:Static res:Strings.Paths}" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <TextBlock x:Name="ServerPathLabel" Text="{x:Static res:Strings.ServerPathLabel}" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding ServerPath, Mode=OneWay}" Margin="0,4,0,8" IsReadOnly="True"
                             AutomationProperties.LabeledBy="{Binding ElementName=ServerPathLabel}"
                             AutomationProperties.AutomationId="ServerPathTextBox"
                             TabIndex="10"/>
                    <TextBlock x:Name="ClientPathLabel" Text="{x:Static res:Strings.ClientPathLabel}" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding ClientPath, Mode=OneWay}" Margin="0,4,0,8" IsReadOnly="True"
                             AutomationProperties.LabeledBy="{Binding ElementName=ClientPathLabel}"
                             AutomationProperties.AutomationId="ClientPathTextBox"
                             TabIndex="11"/>
                    <TextBlock x:Name="ModdedPathLabel" Text="{x:Static res:Strings.ModdedTabgPathLabel}" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding ModdedPath, Mode=OneWay}" Margin="0,4,0,0" IsReadOnly="True"
                             AutomationProperties.LabeledBy="{Binding ElementName=ModdedPathLabel}"
                             AutomationProperties.AutomationId="ModdedPathTextBox"
                             TabIndex="12"/>
                </StackPanel>
            </GroupBox>

            <!-- Accessibility -->
            <GroupBox Header="{x:Static res:Strings.Accessibility}" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <CheckBox Content="{x:Static res:Strings.HighContrastMode}"
                              IsChecked="{Binding HighContrastEnabled}"
                              TabIndex="20"
                              AutomationProperties.Name="{x:Static res:Strings.HighContrastMode}"
                              AutomationProperties.HelpText="{x:Static res:Tooltips.HighContrastHelp}"
                              AutomationProperties.AutomationId="HighContrastCheckBox"/>
                </StackPanel>
            </GroupBox>

            <!-- Privacy -->
            <GroupBox Header="{x:Static res:Strings.Privacy}" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <CheckBox Content="{x:Static res:Strings.SendCrashReports}"
                              IsChecked="{Binding CrashReportingEnabled}"
                              TabIndex="30"
                              AutomationProperties.Name="{x:Static res:Strings.SendCrashReports}"
                              AutomationProperties.HelpText="{x:Static res:Tooltips.CrashReportHelp}"
                              AutomationProperties.AutomationId="CrashReportCheckBox"/>
                    <TextBlock Text="{x:Static res:Strings.CrashReportDescription}"
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="20,4,0,0" FontSize="11"/>
                </StackPanel>
            </GroupBox>

            <!-- Hard Reset -->
            <GroupBox Header="{x:Static res:Strings.HardReset}" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="{x:Static res:Strings.HardResetDescription}"/>
                    <Button Content="{x:Static res:Strings.HardResetButton}" Width="220" HorizontalAlignment="Left"
                            Command="{Binding HardResetCommand}"
                            TabIndex="40"
                            AutomationProperties.Name="{x:Static res:Strings.HardResetButton}"
                            AutomationProperties.HelpText="{x:Static res:Tooltips.HardResetHelp}"
                            AutomationProperties.AutomationId="HardResetButton"/>
                </StackPanel>
            </GroupBox>

            <!-- Super Secret Settings -->
            <GroupBox Header="{x:Static res:Strings.SuperSecretSettings}" Margin="0,0,0,10">
                <local:SuperSecretSettingsPanel x:Name="SuperSecretControl"/>
            </GroupBox>

            <!-- About -->
            <GroupBox Header="{x:Static res:Strings.About}" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <TextBlock Text="{Binding AppVersion}" FontSize="14"/>
                    <TextBlock Text="{x:Static res:Strings.AppName}"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
