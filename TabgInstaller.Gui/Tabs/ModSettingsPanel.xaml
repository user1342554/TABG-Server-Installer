<UserControl x:Class="TabgInstaller.Gui.Tabs.ModSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
        <StackPanel Margin="8">

            <!-- StarterPack Fixes -->
            <GroupBox Header="StarterPack Fixes" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <CheckBox Content="Enable Loot Drops"
                              IsChecked="{Binding EnableLootDrops}"
                              ToolTip="When enabled, items drop from loot containers. Disable for loadout-only modes."/>
                </StackPanel>
            </GroupBox>

            <!-- Grenades On Death - Attacker -->
            <GroupBox Header="Grenades On Death - Attacker" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <CheckBox Content="Enabled" Margin="0,0,0,6"
                              IsChecked="{Binding AttackerEnabled}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Chance (0.0 - 1.0):" Width="130"/>
                        <TextBox Width="80" Text="{Binding AttackerChance, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Grenade:" Width="130"/>
                        <ComboBox x:Name="CmbAttackerGrenade" Width="220"
                                  SelectedIndex="{Binding AttackerGrenadeIndex}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Grenades On Death - Corpse -->
            <GroupBox Header="Grenades On Death - Corpse" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <CheckBox Content="Enabled" Margin="0,0,0,6"
                              IsChecked="{Binding CorpseEnabled}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Chance (0.0 - 1.0):" Width="130"/>
                        <TextBox Width="80" Text="{Binding CorpseChance, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Grenade:" Width="130"/>
                        <ComboBox x:Name="CmbCorpseGrenade" Width="220"
                                  SelectedIndex="{Binding CorpseGrenadeIndex}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Lives & Advanced -->
            <GroupBox Header="Lives &amp; Advanced" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Lives:" Width="130"/>
                        <TextBox Width="80" Text="{Binding Lives, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(256 = infinite)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Streaming Distance:" Width="130"/>
                        <TextBox Width="80" Text="{Binding StreamingDistance, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(-1 = normal)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Ban List -->
            <GroupBox Header="Ban List" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="One Epic ID per line" Foreground="Gray" Margin="0,0,0,4"/>
                    <TextBox Height="120" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="12"
                             Text="{Binding BanList, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </GroupBox>

            <!-- Proximity Chat -->
            <GroupBox Header="Proximity Chat" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Max Range (m):" Width="130"/>
                        <TextBox Width="80" Text="{Binding ProxChatMaxRange, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(default 50)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Min Range (m):" Width="130"/>
                        <TextBox Width="80" Text="{Binding ProxChatMinRange, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(default 5)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Falloff Curve:" Width="130"/>
                        <ComboBox Width="140" SelectedIndex="{Binding ProxChatFalloffIndex}">
                            <ComboBoxItem Content="Linear"/>
                            <ComboBoxItem Content="Logarithmic"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Juggernaut Mode -->
            <GroupBox Header="Juggernaut Mode" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="Score-based game mode: one massive Juggernaut vs everyone" Foreground="Gray" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Points to Win:" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggPointsToWin, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(default 100)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Juggernaut HP:" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggHP, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(default 1000)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Juggernaut Kill Bonus:" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggKillBonus, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(points for killing the Juggernaut)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Jugg Kill Points:" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggKillPoints, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(points Juggernaut earns per kill)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Regular Kill Points:" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggRegularKillPoints, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(points for killing a regular player)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Damage per Point:" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggDamagePerPoint, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(HP damage needed per score point)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Loadout Choices:" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggLoadoutChoices, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(cards shown on respawn)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Loadout Timeout (s):" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggLoadoutTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(auto-pick after this)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="Min Spawn Distance:" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggMinSpawnDist, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(meters from Juggernaut)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Min Players:" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggMinPlayers, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(to start the match)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Bottom bar -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Save" Width="100" Command="{Binding SaveCommand}"/>
                <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
