<UserControl x:Class="TabgInstaller.Gui.Tabs.ModSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TabgInstaller.Gui.Converters"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True"/>
        <conv:ControlTypeVisibilityConverter x:Key="ControlTypeVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
        <StackPanel Margin="8" KeyboardNavigation.TabNavigation="Cycle">

            <!-- StarterPack Fixes -->
            <GroupBox Header="{x:Static res:Strings.StarterPackFixes}" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <CheckBox Content="{x:Static res:Strings.EnableLootDrops}"
                              IsChecked="{Binding EnableLootDrops}"
                              ToolTip="{x:Static res:Tooltips.LootDropsTooltip}"
                              AutomationProperties.Name="{x:Static res:Strings.EnableLootDrops}"
                              AutomationProperties.AutomationId="EnableLootDropsCheckBox"
                              TabIndex="10"/>
                </StackPanel>
            </GroupBox>

            <!-- Grenades On Death - Attacker -->
            <GroupBox Header="{x:Static res:Strings.GrenadesOnDeathAttacker}" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <CheckBox Content="{x:Static res:Strings.Enabled}" Margin="0,0,0,6"
                              IsChecked="{Binding AttackerEnabled}"
                              AutomationProperties.Name="Attacker grenades enabled"
                              AutomationProperties.AutomationId="AttackerEnabledCheckBox"
                              TabIndex="11"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="AttackerChanceLabel" Content="{x:Static res:Strings.ChanceLabel}" Width="130"/>
                        <TextBox Width="80" Text="{Binding AttackerChance, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=AttackerChanceLabel}"
                                 AutomationProperties.AutomationId="AttackerChanceTextBox"
                                 TabIndex="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="AttackerGrenadeLabel" Content="{x:Static res:Strings.GrenadeLabel}" Width="130"/>
                        <ComboBox x:Name="CmbAttackerGrenade" Width="220"
                                  SelectedIndex="{Binding AttackerGrenadeIndex}"
                                  AutomationProperties.LabeledBy="{Binding ElementName=AttackerGrenadeLabel}"
                                  AutomationProperties.AutomationId="AttackerGrenadeComboBox"
                                  TabIndex="13"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Grenades On Death - Corpse -->
            <GroupBox Header="{x:Static res:Strings.GrenadesOnDeathCorpse}" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <CheckBox Content="{x:Static res:Strings.Enabled}" Margin="0,0,0,6"
                              IsChecked="{Binding CorpseEnabled}"
                              AutomationProperties.Name="Corpse grenades enabled"
                              AutomationProperties.AutomationId="CorpseEnabledCheckBox"
                              TabIndex="14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="CorpseChanceLabel" Content="{x:Static res:Strings.ChanceLabel}" Width="130"/>
                        <TextBox Width="80" Text="{Binding CorpseChance, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=CorpseChanceLabel}"
                                 AutomationProperties.AutomationId="CorpseChanceTextBox"
                                 TabIndex="15"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="CorpseGrenadeLabel" Content="{x:Static res:Strings.GrenadeLabel}" Width="130"/>
                        <ComboBox x:Name="CmbCorpseGrenade" Width="220"
                                  SelectedIndex="{Binding CorpseGrenadeIndex}"
                                  AutomationProperties.LabeledBy="{Binding ElementName=CorpseGrenadeLabel}"
                                  AutomationProperties.AutomationId="CorpseGrenadeComboBox"
                                  TabIndex="16"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Lives & Advanced -->
            <GroupBox Header="{x:Static res:Strings.LivesAndAdvanced}" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="LivesLabel" Content="{x:Static res:Strings.LivesLabel}" Width="130"/>
                        <TextBox Width="80" Text="{Binding Lives, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LivesLabel}"
                                 AutomationProperties.AutomationId="LivesTextBox"
                                 TabIndex="20"/>
                        <TextBlock Text="{x:Static res:Strings.Lives256Infinite}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="StreamingDistanceLabel" Content="{x:Static res:Strings.StreamingDistance}" Width="130"/>
                        <TextBox Width="80" Text="{Binding StreamingDistance, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=StreamingDistanceLabel}"
                                 AutomationProperties.AutomationId="StreamingDistanceTextBox"
                                 TabIndex="21"/>
                        <TextBlock Text="{x:Static res:Strings.StreamingDistanceDefault}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Ban List -->
            <GroupBox Header="{x:Static res:Strings.BanList}" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="{x:Static res:Strings.OneEpicIdPerLine}" Foreground="Gray" Margin="0,0,0,4"/>
                    <TextBox Height="120" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="12"
                             Text="{Binding BanList, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Ban list"
                             AutomationProperties.AutomationId="BanListTextBox"
                             TabIndex="30"/>
                </StackPanel>
            </GroupBox>

            <!-- Proximity Chat -->
            <GroupBox Header="{x:Static res:Strings.ProximityChat}" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="MaxRangeLabel" Content="{x:Static res:Strings.MaxRangeM}" Width="130"/>
                        <TextBox Width="80" Text="{Binding ProxChatMaxRange, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=MaxRangeLabel}"
                                 AutomationProperties.AutomationId="ProxChatMaxRangeTextBox"
                                 TabIndex="40"/>
                        <TextBlock Text="{x:Static res:Strings.DefaultFifty}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="MinRangeLabel" Content="{x:Static res:Strings.MinRangeM}" Width="130"/>
                        <TextBox Width="80" Text="{Binding ProxChatMinRange, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=MinRangeLabel}"
                                 AutomationProperties.AutomationId="ProxChatMinRangeTextBox"
                                 TabIndex="41"/>
                        <TextBlock Text="{x:Static res:Strings.DefaultFive}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="FalloffCurveLabel" Content="{x:Static res:Strings.FalloffCurve}" Width="130"/>
                        <ComboBox Width="140" SelectedIndex="{Binding ProxChatFalloffIndex}"
                                  AutomationProperties.LabeledBy="{Binding ElementName=FalloffCurveLabel}"
                                  AutomationProperties.AutomationId="ProxChatFalloffComboBox"
                                  TabIndex="42">
                            <ComboBoxItem Content="{x:Static res:Strings.Linear}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.Logarithmic}"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Server Logger -->
            <GroupBox Header="Server Logger" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox Content="BepInEx console log" Margin="0,0,16,4"
                                  IsChecked="{Binding ServerLoggerLogToConsole}"
                                  AutomationProperties.Name="Server Logger BepInEx console logging"
                                  AutomationProperties.AutomationId="ServerLoggerLogToConsoleCheckBox"
                                  TabIndex="60"/>
                        <CheckBox Content="CSV identity log" Margin="0,0,16,4"
                                  IsChecked="{Binding ServerLoggerWriteCsv}"
                                  AutomationProperties.Name="Server Logger CSV logging"
                                  AutomationProperties.AutomationId="ServerLoggerWriteCsvCheckBox"
                                  TabIndex="61"/>
                        <CheckBox Content="Legacy ServerLogger.txt" Margin="0,0,16,4"
                                  IsChecked="{Binding ServerLoggerWriteLegacy}"
                                  AutomationProperties.Name="Server Logger legacy text logging"
                                  AutomationProperties.AutomationId="ServerLoggerWriteLegacyCheckBox"
                                  TabIndex="62"/>
                        <CheckBox Content="Fallback player scan" Margin="0,0,16,4"
                                  IsChecked="{Binding ServerLoggerFallbackScan}"
                                  AutomationProperties.Name="Server Logger fallback player scan"
                                  AutomationProperties.AutomationId="ServerLoggerFallbackScanCheckBox"
                                  TabIndex="63"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="ServerLoggerIntervalLabel" Content="Scan interval (s)" Width="150"/>
                        <TextBox Width="80" Text="{Binding ServerLoggerFallbackInterval, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ServerLoggerIntervalLabel}"
                                 AutomationProperties.AutomationId="ServerLoggerFallbackIntervalTextBox"
                                 TabIndex="64"/>
                        <TextBlock Text="Default 2" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="ServerLoggerDirLabel" Content="Log directory" Width="150"/>
                        <TextBox Width="260" Text="{Binding ServerLoggerLogDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ServerLoggerDirLabel}"
                                 AutomationProperties.AutomationId="ServerLoggerLogDirectoryTextBox"
                                 TabIndex="65"/>
                        <TextBlock Text="Relative to BepInEx" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="ServerLoggerCsvLabel" Content="CSV file" Width="150"/>
                        <TextBox Width="180" Text="{Binding ServerLoggerCsvFileName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ServerLoggerCsvLabel}"
                                 AutomationProperties.AutomationId="ServerLoggerCsvFileNameTextBox"
                                 TabIndex="66"/>
                        <Label x:Name="ServerLoggerLegacyLabel" Content="Legacy file" Width="100" Margin="12,0,0,0"/>
                        <TextBox Width="180" Text="{Binding ServerLoggerLegacyFileName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ServerLoggerLegacyLabel}"
                                 AutomationProperties.AutomationId="ServerLoggerLegacyFileNameTextBox"
                                 TabIndex="67"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open cfg" Width="100" Margin="0,0,6,0"
                                Command="{Binding OpenServerLoggerConfigCommand}"
                                AutomationProperties.AutomationId="OpenServerLoggerConfigButton"
                                TabIndex="68"/>
                        <Button Content="Open CSV" Width="100" Margin="0,0,6,0"
                                Command="{Binding OpenServerLoggerCsvCommand}"
                                AutomationProperties.AutomationId="OpenServerLoggerCsvButton"
                                TabIndex="69"/>
                        <Button Content="Open legacy" Width="110"
                                Command="{Binding OpenServerLoggerLegacyCommand}"
                                AutomationProperties.AutomationId="OpenServerLoggerLegacyButton"
                                TabIndex="70"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Juggernaut Mode -->
            <GroupBox Header="{x:Static res:Strings.JuggernautMode}" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="{x:Static res:Strings.JuggernautDescription}" Foreground="Gray" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="JuggPointsToWinLabel" Content="{x:Static res:Strings.PointsToWin}" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggPointsToWin, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=JuggPointsToWinLabel}"
                                 AutomationProperties.AutomationId="JuggPointsToWinTextBox"
                                 TabIndex="50"/>
                        <TextBlock Text="{x:Static res:Strings.DefaultHundred}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="JuggHPLabel" Content="{x:Static res:Strings.JuggernautHP}" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggHP, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=JuggHPLabel}"
                                 AutomationProperties.AutomationId="JuggHPTextBox"
                                 TabIndex="51"/>
                        <TextBlock Text="{x:Static res:Strings.DefaultThousand}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="JuggKillBonusLabel" Content="{x:Static res:Strings.JuggernautKillBonus}" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggKillBonus, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=JuggKillBonusLabel}"
                                 AutomationProperties.AutomationId="JuggKillBonusTextBox"
                                 TabIndex="52"/>
                        <TextBlock Text="{x:Static res:Strings.JuggernautKillBonusHint}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="JuggKillPointsLabel" Content="{x:Static res:Strings.JuggKillPoints}" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggKillPoints, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=JuggKillPointsLabel}"
                                 AutomationProperties.AutomationId="JuggKillPointsTextBox"
                                 TabIndex="53"/>
                        <TextBlock Text="{x:Static res:Strings.JuggKillPointsHint}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="RegularKillPointsLabel" Content="{x:Static res:Strings.RegularKillPoints}" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggRegularKillPoints, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=RegularKillPointsLabel}"
                                 AutomationProperties.AutomationId="JuggRegularKillPointsTextBox"
                                 TabIndex="54"/>
                        <TextBlock Text="{x:Static res:Strings.RegularKillPointsHint}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="DamagePerPointLabel" Content="{x:Static res:Strings.DamagePerPoint}" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggDamagePerPoint, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=DamagePerPointLabel}"
                                 AutomationProperties.AutomationId="JuggDamagePerPointTextBox"
                                 TabIndex="55"/>
                        <TextBlock Text="{x:Static res:Strings.DamagePerPointHint}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="LoadoutChoicesLabel" Content="{x:Static res:Strings.LoadoutChoices}" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggLoadoutChoices, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LoadoutChoicesLabel}"
                                 AutomationProperties.AutomationId="JuggLoadoutChoicesTextBox"
                                 TabIndex="56"/>
                        <TextBlock Text="{x:Static res:Strings.LoadoutChoicesHint}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="LoadoutTimeoutLabel" Content="{x:Static res:Strings.LoadoutTimeoutS}" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggLoadoutTimeout, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LoadoutTimeoutLabel}"
                                 AutomationProperties.AutomationId="JuggLoadoutTimeoutTextBox"
                                 TabIndex="57"/>
                        <TextBlock Text="{x:Static res:Strings.LoadoutTimeoutHint}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label x:Name="MinSpawnDistLabel" Content="{x:Static res:Strings.MinSpawnDistance}" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggMinSpawnDist, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=MinSpawnDistLabel}"
                                 AutomationProperties.AutomationId="JuggMinSpawnDistTextBox"
                                 TabIndex="58"/>
                        <TextBlock Text="{x:Static res:Strings.MinSpawnDistanceHint}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="MinPlayersToStartLabel" Content="{x:Static res:Strings.MinPlayersToStart}" Width="150"/>
                        <TextBox Width="80" Text="{Binding JuggMinPlayers, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=MinPlayersToStartLabel}"
                                 AutomationProperties.AutomationId="JuggMinPlayersTextBox"
                                 TabIndex="59"/>
                        <TextBlock Text="{x:Static res:Strings.MinPlayersToStartHint}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Other Server Plugin Settings -->
            <TextBlock Text="Other Server Plugin Settings" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,6"/>
            <ItemsControl ItemsSource="{Binding AdditionalServerPluginSettings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Header="{Binding DisplayName}" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Settings}"
                                              Visibility="{Binding HasSettings, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <StackPanel Grid.Column="1">
                                                    <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                              Visibility="{Binding ControlType, Converter={StaticResource ControlTypeVisibility}, ConverterParameter=CheckBox}"
                                                              AutomationProperties.AutomationId="{Binding AutomationId}"/>
                                                    <ComboBox Width="180" HorizontalAlignment="Left"
                                                              ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding ControlType, Converter={StaticResource ControlTypeVisibility}, ConverterParameter=ComboBox}"
                                                              AutomationProperties.AutomationId="{Binding AutomationId}"/>
                                                    <TextBox Width="180" HorizontalAlignment="Left"
                                                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding ControlType, Converter={StaticResource ControlTypeVisibility}, ConverterParameter=TextBox}"
                                                             AutomationProperties.AutomationId="{Binding AutomationId}"/>
                                                    <TextBox MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding ControlType, Converter={StaticResource ControlTypeVisibility}, ConverterParameter=MultilineTextBox}"
                                                             AutomationProperties.AutomationId="{Binding AutomationId}"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap"
                                                               FontSize="11" Margin="0,2,0,0"
                                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="{Binding DefaultText}" Foreground="Gray" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding EmptyText}" Foreground="Gray" TextWrapping="Wrap"
                                           Visibility="{Binding HasSettings, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <Button Content="Open cfg" Width="100" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Command="{Binding DataContext.OpenPluginConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding HasSettings}"/>
                            </StackPanel>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Client Plugin Settings -->
            <TextBlock Text="Client Plugin Settings" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,6"/>
            <TextBlock Text="{Binding ClientPluginSettingsStatus}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding ClientPluginSettings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Header="{Binding DisplayName}" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Settings}"
                                              Visibility="{Binding HasSettings, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <StackPanel Grid.Column="1">
                                                    <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                              Visibility="{Binding ControlType, Converter={StaticResource ControlTypeVisibility}, ConverterParameter=CheckBox}"
                                                              AutomationProperties.AutomationId="{Binding AutomationId}"/>
                                                    <ComboBox Width="180" HorizontalAlignment="Left"
                                                              ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding ControlType, Converter={StaticResource ControlTypeVisibility}, ConverterParameter=ComboBox}"
                                                              AutomationProperties.AutomationId="{Binding AutomationId}"/>
                                                    <TextBox Width="180" HorizontalAlignment="Left"
                                                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding ControlType, Converter={StaticResource ControlTypeVisibility}, ConverterParameter=TextBox}"
                                                             AutomationProperties.AutomationId="{Binding AutomationId}"/>
                                                    <TextBox MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding ControlType, Converter={StaticResource ControlTypeVisibility}, ConverterParameter=MultilineTextBox}"
                                                             AutomationProperties.AutomationId="{Binding AutomationId}"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap"
                                                               FontSize="11" Margin="0,2,0,0"
                                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="{Binding DefaultText}" Foreground="Gray" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding EmptyText}" Foreground="Gray" TextWrapping="Wrap"
                                           Visibility="{Binding HasSettings, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <Button Content="Open cfg" Width="100" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Command="{Binding DataContext.OpenPluginConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding HasSettings}"/>
                            </StackPanel>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom bar -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="{x:Static res:Strings.Save}" Width="100" Command="{Binding SaveCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.Save}"
                        AutomationProperties.AutomationId="ModSettingsSaveButton"
                        TabIndex="90"/>
                <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
