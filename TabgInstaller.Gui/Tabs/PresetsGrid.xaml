<UserControl x:Class="TabgInstaller.Gui.Tabs.PresetsGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Built-in Server Templates -->
        <GroupBox Grid.Row="0" Header="{x:Static res:Strings.ServerTemplates}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="LstTemplates" Height="120" SelectionChanged="LstTemplates_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock x:Name="TxtTemplateDesc" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtTemplateNotes" TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>
                    <Button Content="{x:Static res:Strings.ApplyTemplate}" Width="200" HorizontalAlignment="Left" Click="ApplyTemplate_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- User Presets -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Preset list -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Static res:Strings.SavedPresets}" FontWeight="Bold"/>
                <ListBox x:Name="LstPresets" Height="200" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="{x:Static res:Strings.Load}" Width="60" Click="LoadPreset_Click"/>
                    <Button Content="{x:Static res:Strings.Delete}" Width="60" Margin="6,0,0,0" Click="DeletePreset_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Files selection and save -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="{x:Static res:Strings.FilesToInclude}" FontWeight="Bold"/>
                <ItemsControl x:Name="FilesList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Display}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{x:Static res:Strings.SaveCurrentPreset}" Width="220" Margin="0,10,0,0" Click="SavePreset_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
