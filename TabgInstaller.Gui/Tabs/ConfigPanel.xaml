<UserControl x:Class="TabgInstaller.Gui.Tabs.ConfigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TabgInstaller.Gui.Tabs"
             xmlns:res="clr-namespace:TabgInstaller.Gui.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Quick Actions -->
        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="0">
            <Button Content="{x:Static res:Strings.OpenServerFolder}" Margin="2" Command="{Binding OpenServerFolderCommand}"/>
            <Button Content="{x:Static res:Strings.OpenLogs}" Margin="2" Command="{Binding OpenLogsCommand}"/>
            <Button Content="{x:Static res:Strings.OpenConfigFiles}" Margin="2" Command="{Binding OpenConfigsCommand}"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="{x:Static res:Strings.ServerSettings}">
                <Grid DataContext="{Binding GameSettingsVm}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <local:GameSettingsGrid Grid.Row="0"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5"
                                DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Button Content="{x:Static res:Strings.Save}" Width="100"
                                Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Button Content="{x:Static res:Strings.OpenInNotepad}" Width="140" Margin="5,0,0,0"
                                Command="{Binding DataContext.OpenGameSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <TextBlock Text="{Binding DataContext.StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.MatchSettings}">
                <local:MatchSettingsPanel x:Name="MatchSettingsControl"/>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.RingAndSpawns}">
                <local:RingSpawnsPanel x:Name="RingSpawnsControl"/>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Loadouts}">
                <local:LoadoutEditorPanel x:Name="LoadoutEditorControl"/>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.ModSettings}">
                <local:ModSettingsPanel x:Name="ModSettingsControl"/>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Admins}">
                <local:AdminPanel x:Name="AdminPanelControl"/>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Presets}">
                <local:PresetsGrid x:Name="PresetsGridControl"/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
