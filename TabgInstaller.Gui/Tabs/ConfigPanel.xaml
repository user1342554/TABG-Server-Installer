<UserControl x:Class="TabgInstaller.Gui.Tabs.ConfigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TabgInstaller.Gui.Tabs">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Quick Actions -->
        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="0">
            <Button Content="Open Server Folder" Margin="2" Click="OpenServerFolder_Click"/>
            <Button Content="Open Logs" Margin="2" Click="OpenLogs_Click"/>
            <Button Content="Open Config Files" Margin="2" Click="OpenConfigs_Click"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Server Settings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <local:GameSettingsGrid Grid.Row="0"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                        <Button Content="Save" Width="100" Click="SaveButton_Click"/>
                        <Button Content="Open in Notepad" Width="140" Margin="5,0,0,0" Click="OpenGameSettings_Click"/>
                        <TextBlock Name="StatusTextBlock" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Match Settings">
                <local:MatchSettingsPanel x:Name="MatchSettingsControl"/>
            </TabItem>

            <TabItem Header="Ring &amp; Spawns">
                <local:RingSpawnsPanel x:Name="RingSpawnsControl"/>
            </TabItem>

            <TabItem Header="Loadouts">
                <local:LoadoutEditorPanel x:Name="LoadoutEditorControl"/>
            </TabItem>

            <TabItem Header="Mod Settings">
                <local:ModSettingsPanel x:Name="ModSettingsControl"/>
            </TabItem>

            <TabItem Header="Admins">
                <local:AdminPanel x:Name="AdminPanelControl"/>
            </TabItem>

            <TabItem Header="Presets">
                <local:PresetsGrid x:Name="PresetsGridControl"/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>