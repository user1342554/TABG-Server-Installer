<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0-linux</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabgInstaller.Core\TabgInstaller.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.14" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.14" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.14" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Knowledge\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Knowledge\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\registry\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>registry\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\TabgInstaller.Gui\plugins\**\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>plugins\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\TabgInstaller.Gui\client-plugins\**\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>client-plugins\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\TabgInstaller.Gui\StarterPackSetup.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>StarterPackSetup.exe</Link>
    </None>
  </ItemGroup>
</Project>
