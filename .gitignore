# Ignore build output and intermediate files
bin/
obj/
out/
*.exe
*.dll
*.pdb
*.cache
*.log
*.vs/
.vscode/
*.user
*.suo
*.tmp
*.bak
# Ignore OS files
.DS_Store
Thumbs.db
# Ignore NuGet packages
*.nupkg
# Ignore user-specific files
*.userprefs
# Ignore publish folders
publish/
publish-*/

# Ignore release archives
TabgInstaller-v*.zip

# Ignore temp directories
_tabgvr_temp/
# Allow necessary libraries in Libs/
!*/Libs/*.dll
# Allow built mods dlls
!mods/
!mods/*.dll
# Allow bundled plugin DLLs
!bundled/
!bundled/plugins/
!bundled/plugins/*.dll
!bundled/client-plugins/
!bundled/client-plugins/*.dll
# Keep self-contained portable preset plugin payloads
!portable-presets/**/BepInEx/plugins/*.dll
# Allow markdown, config, and scripts
!*.md
!*.ps1
!*.bat
!*.config
!*.cs
!*.csproj
!*.xaml
!*.json
!*.sln 

# Ignore TABG server files generated when testing from the repo root
ExtraSettings.json
PlayerPerms.json
LootTables/

# Ignore an unrelated test/download artifact without deleting the user's copy
TabgInstaller.Tests/597b52dca91ed68930a2de836af46537_jpg.png
